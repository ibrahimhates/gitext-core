<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:GitExt.UI.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:GitExt.UI.ViewModels"
             xmlns:views="using:GitExt.UI.Views"
             xmlns:controls="using:GitExt.UI.Controls"
             mc:Ignorable="d"
             d:DesignWidth="918" d:DesignHeight="622"
             x:Class="GitExt.UI.Views.WorkingTreeView"
             x:DataType="vm:WorkingTreeViewModel"
             Loaded="OnViewLoaded">

    <!--
        The LAYOUT was taken VERBATIM from GitExtensions' `FormCommit` (CLAUDE.md § 9).
        Source: src/app/GitUI/CommandsDialogs/FormCommit.Designer.cs

          splitMain  (vertical)  : Panel1 = left column           │ Panel2 = right column
                                   SplitterDistance = 397 / 918  → left ≈ 43%
          splitLeft  (horizontal): Panel1 = Unstaged (top)
                                   Panel2 = toolbarStaged + Staged (bottom)
                                   SplitterDistance = 274 / 622  → top ≈ 44%
          splitRight (horizontal): Panel1 = SelectedDiff (top)
                                   Panel2 = commit message (bottom, P05-T12)
                                   SplitterDistance = 426 / 622  → top ≈ 68%

        The toolbar (`toolbarStaged`) sits BETWEEN the two lists with its items aligned to either
        side: unstage actions on the left, stage actions on the right
        (`ToolStripItemAlignment.Right`). The directions match where the lists are — "Stage" moves
        from the list above to the one below.

        ⚠️ THERE IS NO SEPARATE "untracked" SECTION: in GitExtensions untracked files sit in the
        Unstaged list. The plan called for three sections; under the § 9 rule the layout won
        (details: WorkingTreeViewModel).
    -->

    <UserControl.Resources>
        <!--
            The row format is the SAME as the changed files list in P04-T08: git's own status
            letter plus the path. The user already knows the letters; setting up two different
            presentations across two lists would be a needless second alphabet.
        -->
        <DataTemplate x:Key="WorkingTreeFileTemplate" DataType="vm:WorkingTreeFileRow">
            <Grid ColumnDefinitions="Auto,*" Height="20">
                <TextBlock Grid.Column="0"
                           Text="{Binding StatusLetter}"
                           Classes="status"
                           Classes.added="{Binding IsAdded}"
                           Classes.deleted="{Binding IsDeleted}"
                           Classes.conflicted="{Binding IsConflicted}"
                           Width="16"
                           FontFamily="{DynamicResource GitExtMonospaceFont}"
                           FontSize="12"
                           VerticalAlignment="Center" />

                <TextBlock Grid.Column="1"
                           Text="{Binding Path}"
                           FontSize="12"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           Margin="4,0,0,0" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="TextBlock.status">
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
        </Style>
        <Style Selector="TextBlock.status.added">
            <Setter Property="Foreground" Value="{DynamicResource GitExtSuccessBrush}" />
        </Style>
        <Style Selector="TextBlock.status.deleted">
            <Setter Property="Foreground" Value="{DynamicResource GitExtDangerBrush}" />
        </Style>
        <Style Selector="TextBlock.status.conflicted">
            <Setter Property="Foreground" Value="{DynamicResource GitExtAttentionBrush}" />
        </Style>

        <!-- Once the subject counter passes the limit it turns the warning colour; it does NOT BLOCK the commit. -->
        <Style Selector="TextBlock.over">
            <Setter Property="Foreground" Value="{DynamicResource GitExtAttentionBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*" Margin="6">

        <!--
            The reset strip (P05-T15). A strip rather than a modal "OK" box: a dialog shown AFTER a
            destructive operation is nothing but an obstacle waiting to be dismissed, whereas what
            is actually needed is for the UNDO path to stay visible for a while.
        -->
        <Border Grid.Row="0"
                Name="ResetNoticeBar"
                IsVisible="{Binding ResetNotice, Converter={x:Static ObjectConverters.IsNotNull}}"
                Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                BorderThickness="1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                CornerRadius="3"
                Padding="8,5"
                Margin="0,0,0,6">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock Grid.Column="0"
                           Name="ResetNoticeText"
                           Text="{Binding ResetNotice}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           FontSize="12" />

                <Button Grid.Column="1"
                        Name="UndoResetButton"
                        Content="{loc:Translate working_tree.revert}"
                        FontSize="12"
                        Margin="8,0,0,0"
                        IsVisible="{Binding CanUndoReset}"
                        Click="OnUndoResetClick" />

                <Button Grid.Column="2"
                        Name="DismissResetNoticeButton"
                        Content="✕"
                        FontSize="12"
                        Margin="4,0,0,0"
                        Click="OnDismissResetNoticeClick" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="43*,Auto,57*">

        <!-- ================= LEFT COLUMN ================= -->
        <Grid Grid.Column="0" RowDefinitions="44*,Auto,56*">

            <!-- ═══ Top: Unstaged ═══ -->
            <Grid Grid.Row="0" RowDefinitions="Auto,*">

                <TextBlock Grid.Row="0"
                           Name="UnstagedCaption"
                           Text="{Binding Unstaged.Count, StringFormat='Unstaged changes ({0})'}"
                           FontWeight="SemiBold"
                           FontSize="12"
                           Margin="2,0,0,4" />

                <Border Grid.Row="1"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">

                    <ListBox Name="UnstagedList"
                             ItemsSource="{Binding Unstaged}"
                             SelectedIndex="{Binding SelectedUnstagedIndex}"
                             ItemTemplate="{StaticResource WorkingTreeFileTemplate}"
                             Background="Transparent"
                             BorderThickness="0"
                             GotFocus="OnUnstagedFocused" />
                </Border>
            </Grid>

            <!-- ═══ Middle: stage/unstage toolbar ═══ -->
            <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="0,6">

                <!-- Sol grup: staged listesinden geri alma -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                    <Button Name="UnstageAllButton"
                            Content="⏫"
                            ToolTip.Tip="{loc:Translate working_tree.revert_all}"
                            FontSize="11"
                            Padding="8,3"
                            Click="OnUnstageAllClick" />

                    <Border Width="1"
                            Margin="2,2"
                            Background="{DynamicResource SystemControlForegroundBaseLowBrush}" />

                    <Button Name="UnstageButton"
                            Content="{loc:Translate working_tree.unstage}"
                            ToolTip.Tip="{loc:Translate working_tree.revert_the_selected_file}"
                            FontSize="11"
                            Padding="8,3"
                            Click="OnUnstageClick" />
                </StackPanel>

                <!-- Right group: staging from the unstaged list -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                    <Button Name="StageButton"
                            Content="{loc:Translate working_tree.stage}"
                            ToolTip.Tip="{loc:Translate working_tree.stage_the_selected_file}"
                            FontSize="11"
                            Padding="8,3"
                            Click="OnStageClick" />

                    <Border Width="1"
                            Margin="2,2"
                            Background="{DynamicResource SystemControlForegroundBaseLowBrush}" />

                    <Button Name="StageAllButton"
                            Content="⏬"
                            ToolTip.Tip="{loc:Translate working_tree.stage_all}"
                            FontSize="11"
                            Padding="8,3"
                            Click="OnStageAllClick" />
                </StackPanel>
            </Grid>

            <!-- ═══ Alt: Staged ═══ -->
            <Grid Grid.Row="2" RowDefinitions="Auto,*,Auto">

                <TextBlock Grid.Row="0"
                           Name="StagedCaption"
                           Text="{Binding Staged.Count, StringFormat='Staged changes ({0})'}"
                           FontWeight="SemiBold"
                           FontSize="12"
                           Margin="2,0,0,4" />

                <Border Grid.Row="1"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">

                    <ListBox Name="StagedList"
                             ItemsSource="{Binding Staged}"
                             SelectedIndex="{Binding SelectedStagedIndex}"
                             ItemTemplate="{StaticResource WorkingTreeFileTemplate}"
                             Background="Transparent"
                             BorderThickness="0"
                             GotFocus="OnStagedFocused" />
                </Border>

                <!-- Error strip plus git's full output (P05-T07) -->
                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            Spacing="8"
                            Margin="0,6,0,0"
                            IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}">

                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />

                    <views:GitErrorDetailsButton Details="{Binding ErrorDetails}" />
                </StackPanel>
            </Grid>
        </Grid>

        <GridSplitter Grid.Column="1" Width="6" Background="Transparent" />

        <!-- ================= RIGHT COLUMN ================= -->
        <!--
            `splitRight` (horizontal): Panel1 = SelectedDiff, Panel2 = commit message.
            SplitterDistance 426 / 622 ≈ 68%.
        -->
        <Grid Grid.Column="2" RowDefinitions="68*,Auto,32*">

            <views:DiffView Grid.Row="0" DataContext="{Binding Diff}" />

            <GridSplitter Grid.Row="1" Height="6" Background="Transparent" />

            <!--
                `tableLayoutPanel1` (2×2): the left column is `flowCommitButtons` (automatic
                width), the right column has `toolbarCommit` on top and `Message` below.
            -->
            <Grid Grid.Row="2" ColumnDefinitions="Auto,*" RowDefinitions="Auto,*" Margin="0,4,0,0">

                <!--
                    `flowCommitButtons` order verbatim: Commit · Commit&amp;Push ·
                    Stage in Superproject · Amend · [Reset author · Reset soft] ·
                    Stash staged · Reset all changes · Reset unstaged changes.
                    The unimplemented ones are disabled but IN PLACE (§ 9).
                -->
                <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                            Spacing="4"
                            Margin="0,0,10,0"
                            MinWidth="150">

                    <Button Name="CommitButton"
                            Content="{loc:Translate working_tree.commit}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            IsEnabled="{Binding CanCommit}"
                            ToolTip.Tip="{loc:Translate working_tree.ctrl_enter}"
                            Click="OnCommitClick" />

                    <Button Name="CommitAndPushButton"
                            Content="{loc:Translate working_tree.commit_push}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            IsEnabled="False" />

                    <CheckBox Name="StageInSuperprojectBox"
                              Content="{loc:Translate working_tree.stage_in_parent_project}"
                              FontSize="11"
                              IsEnabled="False" />

                    <CheckBox Name="AmendBox"
                              Content="{loc:Translate working_tree.amend_the_last_commit}"
                              FontSize="11"
                              IsChecked="{Binding Amend}" />

                    <StackPanel Margin="12,0,0,0" Spacing="2" IsVisible="{Binding Amend}">
                        <CheckBox Name="ResetAuthorBox" Content="{loc:Translate working_tree.reset_author}" FontSize="11" IsEnabled="False" />
                        <CheckBox Name="ResetSoftBox" Content="{loc:Translate working_tree.soft_reset}" FontSize="11" IsEnabled="False" />
                    </StackPanel>

                    <Button Name="StashStagedButton" Content="{loc:Translate working_tree.stash_staged_changes}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            FontSize="11" IsEnabled="False" />

                    <Button Name="ResetAllButton" Content="{loc:Translate working_tree.reset_all_changes}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            FontSize="11" Click="OnResetAllClick" />

                    <Button Name="ResetUnstagedButton" Content="{loc:Translate working_tree.reset_unstaged_changes}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            FontSize="11" Click="OnResetUnstagedClick" />
                </StackPanel>

                <!--
                    `toolbarCommit` order: commit message ▾ · options ▾ · templates ▾ ·
                    create branch. All of it is P05-T13 / Phase 06.
                -->
                <StackPanel Grid.Row="0" Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="6"
                            Margin="0,0,0,4">

                    <!--
                        The history menu is read WHEN IT OPENS (as `DropDownOpening` does in
                        GitExtensions): running an extra `git log` on every repository open would
                        be the price of a menu the user may never open.
                    -->
                    <Button Name="MessageHistoryButton" Content="{loc:Translate working_tree.message}" FontSize="11" Padding="8,2">
                        <Button.Flyout>
                            <MenuFlyout Opening="OnMessageHistoryOpening">
                                <MenuItem Header="{loc:Translate working_tree.only_my_messages}"
                                          ToggleType="CheckBox"
                                          IsChecked="{Binding Message.OnlyMyMessages}" />
                                <Separator />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>

                    <Button Name="CommitOptionsButton" Content="{loc:Translate working_tree.options}" FontSize="11" Padding="8,2">
                        <Button.Flyout>
                            <MenuFlyout>
                                <!--
                                    Skipping hooks DOES NOT LOSE DATA: the commit stays in the
                                    reflog and can be recovered (measured in P05-T15). That is why
                                    it is a checkbox and not a dialog — opening a modal on every
                                    commit would test the user's patience rather than the weight of
                                    what is being skipped.
                                -->
                                <MenuItem Name="SkipHooksItem"
                                          Header="{loc:Translate working_tree.skip_hooks_no_verify}"
                                          ToggleType="CheckBox"
                                          IsChecked="{Binding SkipHooks, Mode=TwoWay}" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>

                    <Button Name="CommitTemplatesButton" Content="{loc:Translate working_tree.templates}" FontSize="11" Padding="8,2">
                        <Button.Flyout>
                            <MenuFlyout>
                                <!--
                                    A template that cannot be found is NOT HIDDEN: git itself
                                    rejects the commit in that case with `fatal: could not read`,
                                    so the configuration really is broken (measured).
                                -->
                                <MenuItem Name="TemplateItem"
                                          Header="{Binding Message.TemplateLabel}"
                                          IsEnabled="{Binding Message.CanApplyTemplate}"
                                          Click="OnApplyTemplateClick" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <Button Name="CreateBranchButton" Content="{loc:Translate working_tree.create_branch}" FontSize="11" Padding="8,2" IsEnabled="False" />

                    <TextBlock Name="SubjectCounter"
                               Text="{Binding Message.SubjectCounter}"
                               Classes.over="{Binding Message.IsSubjectTooLong}"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0" />
                </StackPanel>

                <!--
                    The message box plus the 50/72 guide. The guide is drawn BEHIND the box;
                    drawing it over the text would shadow the caret and the selection.
                -->
                <Grid Grid.Row="1" Grid.Column="1" RowDefinitions="*,Auto">

                    <Border Grid.Row="0"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">

                        <Panel>
                            <controls:ColumnGuides Name="MessageGuides"
                                                   Columns="{Binding Message.GuideColumnsForBinding}"
                                                   Stroke="{DynamicResource GitExtBorderBrush}"
                                                   TextOffset="5"
                                                   TextElement.FontFamily="{DynamicResource GitExtMonospaceFont}"
                                                   TextElement.FontSize="12" />

                            <TextBox Name="MessageBox"
                                     Text="{Binding Message.Text}"
                                     AcceptsReturn="True"
                                     AcceptsTab="False"
                                     TextWrapping="NoWrap"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="4,0"
                                     FontFamily="{DynamicResource GitExtMonospaceFont}"
                                     FontSize="12"
                                     VerticalContentAlignment="Top"
                                     PlaceholderText="{loc:Translate working_tree.commit_message_ctrl_enter_to_commit}" />
                        </Panel>
                    </Border>

                    <TextBlock Grid.Row="1"
                               Name="MessageHint"
                               Text="{Binding Message.Hint}"
                               IsVisible="{Binding Message.HasHint}"
                               Foreground="{DynamicResource SystemFillColorCautionBrush}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="2,3,0,0" />
                </Grid>
            </Grid>
        </Grid>
        </Grid>
    </Grid>
</UserControl>
