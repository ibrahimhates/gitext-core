<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:GitExt.UI.Localization"
        xmlns:vm="using:GitExt.UI.ViewModels"
        x:Class="GitExt.UI.Views.AuthenticationWindow"
        x:DataType="vm:AuthenticationViewModel"
        Title="{loc:Translate authentication.authentication}"
        Width="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <!--
        There is no exact counterpart to this in GitExtensions: authentication there is built
        around PuTTY/pageant (§ 9's scope is Windows tooling). On Linux the counterpart is the
        SSH agent and the credential helper; so this screen takes the place of GitExtensions'
        "Load SSH key" button rather than imitating it.

        Order: what happened -> which address -> what can be done (suggestions) -> credential
        fields. The credential fields appear ONLY over HTTPS: over SSH what is wanted is not a
        password but a key; showing a field would be a false promise.
    -->
    <StackPanel Margin="16" Spacing="12">

        <TextBlock Name="ExplanationText"
                   TextWrapping="Wrap"
                   Text="{Binding Explanation}" />

        <StackPanel Spacing="2" IsVisible="{Binding HasUrl}">
            <TextBlock Text="{loc:Translate authentication.remote}" FontSize="11" Opacity="0.8" />
            <TextBox Name="UrlBox"
                     IsReadOnly="True"
                     IsTabStop="False"
                     FontFamily="{DynamicResource GitExtMonospaceFont}"
                     FontSize="11"
                     Text="{Binding Url}" />
        </StackPanel>

        <StackPanel Name="SuggestionPanel" Spacing="4" IsVisible="{Binding HasSuggestions}">
            <TextBlock Text="{loc:Translate authentication.you_can_try}" FontSize="11" Opacity="0.8" />
            <ItemsControl Name="SuggestionList" ItemsSource="{Binding Suggestions}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="x:String">
                        <TextBox IsReadOnly="True"
                                 Margin="0,0,0,3"
                                 FontFamily="{DynamicResource GitExtMonospaceFont}"
                                 FontSize="11"
                                 Text="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <StackPanel Name="CredentialPanel" Spacing="6" IsVisible="{Binding CanEnterCredentials}">
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="{loc:Translate authentication.username}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,4" />
                <TextBox Name="UsernameBox"
                         Grid.Row="0" Grid.Column="1"
                         Margin="0,0,0,4"
                         Text="{Binding Username}" />

                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="{loc:Translate authentication.password_token}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0" />
                <TextBox Name="SecretBox"
                         Grid.Row="1" Grid.Column="1"
                         PasswordChar="•"
                         Text="{Binding Secret}" />
            </Grid>

            <TextBlock Name="StorageNoticeText"
                       FontSize="11"
                       Opacity="0.85"
                       TextWrapping="Wrap"
                       Text="{loc:Translate authentication.what_you_enter_is_not_stored_anywhere_it_is_}" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Name="CancelButton" Content="{loc:Translate authentication.cancel}" MinWidth="90" IsCancel="True" Click="OnCancelClick" />
            <Button Name="SubmitButton"
                    Content="{loc:Translate authentication.retry}"
                    MinWidth="110"
                    IsDefault="True"
                    IsVisible="{Binding CanEnterCredentials}"
                    Command="{Binding SubmitCommand}" />
        </StackPanel>
    </StackPanel>
</Window>
