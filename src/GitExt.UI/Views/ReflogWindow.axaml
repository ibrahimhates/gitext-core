<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:GitExt.UI.Localization"
        xmlns:vm="using:GitExt.UI.ViewModels"
        x:Class="GitExt.UI.Views.ReflogWindow"
        x:DataType="vm:ReflogViewModel"
        Title="{loc:Translate reflog.reflog}" Width="900" Height="560"
        WindowStartupLocation="CenterOwner">

  <Grid RowDefinitions="Auto,*,Auto" Margin="12">

    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,8">
      <CheckBox Name="OnlyUnreachableBox"
                Content="{loc:Translate reflog.only_lost_commits}"
                IsChecked="{Binding OnlyUnreachable}" />
      <TextBlock Name="UnreachableCountLabel"
                 VerticalAlignment="Center" Opacity="0.7"
                 Text="{Binding UnreachableCountText}" />
    </StackPanel>

    <ListBox Grid.Row="1" Name="ReflogList"
             ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:ReflogRowViewModel">
          <Grid ColumnDefinitions="80,140,*,140">
            <TextBlock Grid.Column="0" Text="{Binding ShortId}" FontFamily="{DynamicResource GitExtMonospaceFont}" />
            <TextBlock Grid.Column="1" Text="{Binding Selector}" Opacity="0.7" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
              <TextBlock Text="{Binding Message}" TextTrimming="CharacterEllipsis" />
              <!-- Lost commits are brought to the front: finding them is what the browser is actually for. -->
              <Border Background="{DynamicResource GitExtStashBadgeBackgroundBrush}" CornerRadius="3" Padding="4,0"
                      IsVisible="{Binding IsUnreachable}">
                <TextBlock Text="{loc:Translate reflog.lost}" Foreground="White" FontSize="10" />
              </Border>
            </StackPanel>
            <TextBlock Grid.Column="3" Text="{Binding Timestamp}" FontSize="11" Opacity="0.6" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <StackPanel Grid.Row="2" Margin="0,10,0,0" Spacing="6">
      <TextBlock Name="RecoveryLabel" FontFamily="{DynamicResource GitExtMonospaceFont}" Opacity="0.8"
                 Text="{Binding SelectedRecoveryCommand}"
                 IsVisible="{Binding HasSelection}" />
      <TextBlock Name="NoticeLabel" Text="{Binding Notice}" TextWrapping="Wrap"
                 IsVisible="{Binding Notice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <TextBlock Name="ErrorLabel" Text="{Binding Error}" Foreground="{DynamicResource GitExtErrorBrush}" TextWrapping="Wrap"
                 IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <StackPanel Orientation="Horizontal" Spacing="6">
        <Button Name="ReturnButton" Content="{loc:Translate reflog.reset_to_this_commit}" Command="{Binding ReturnCommand}" />
        <Button Name="CloseButton" Content="{loc:Translate reflog.close}" Click="OnClose" />
      </StackPanel>
    </StackPanel>
  </Grid>
</Window>
