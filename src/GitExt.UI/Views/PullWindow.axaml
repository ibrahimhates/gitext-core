<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:GitExt.UI.Localization"
        xmlns:vm="using:GitExt.UI.ViewModels"
        x:Class="GitExt.UI.Views.PullWindow"
        x:DataType="vm:PullViewModel"
        Title="{loc:Translate pull.pull_fetch}"
        Width="620"
        SizeToContent="Height"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <!--
        Yerleşim GitExtensions `FormPull.Designer.cs`'ten (§ 9), grup sırası birebir:
          GroupPullFrom (Remote / URL) → GroupBranch (Local / Remote branch) →
          GroupMergeOptions (Merge · Rebase · yalnızca Fetch) → GroupTagOptions →
          Prune / PruneTags → AutoStash → Pull düğmesi.

        Bizde OLMAYAN: "URL" seçeneği (yerinde ama devre dışı — uzak depo eklemeden URL'den
        çekmek P06-T09'un kimlik doğrulama akışına bağlı), "Solve conflicts" ve "Stash
        changes" düğmeleri (mergetool Faz 07, stash yönetimi Faz 07).

        EKLENEN: stratejinin NEREDEN geldiğini yazan satır ve çalıştırılacak KOMUT.
        Planın maddesi: "pull düğmesinin ne yaptığı belirsiz kalmamalı".
    -->
    <StackPanel Margin="16" Spacing="10">

        <HeaderedContentControl Header="{loc:Translate pull.pull_from}">
            <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" Margin="8,4">
                <RadioButton Name="FromRemoteRadio"
                             Grid.Row="0" Grid.Column="0"
                             GroupName="PullFrom"
                             Content="{loc:Translate pull.remote}"
                             IsChecked="True"
                             Margin="0,0,8,0" />
                <ComboBox Name="RemoteBox"
                          Grid.Row="0" Grid.Column="1"
                          HorizontalAlignment="Stretch"
                          ItemsSource="{Binding Remotes}"
                          SelectedItem="{Binding SelectedRemote}" />
                <Button Name="ManageRemotesButton"
                        Grid.Row="0" Grid.Column="2"
                        Content="{loc:Translate pull.manage}"
                        Margin="8,0,0,0"
                        Click="OnManageRemotesClick" />

                <!-- Yerinde ama devre dışı (§ 9): URL'den çekme P06-T09'a bağlı. -->
                <RadioButton Name="FromUrlRadio"
                             Grid.Row="1" Grid.Column="0"
                             GroupName="PullFrom"
                             Content="{loc:Translate pull.url}"
                             IsEnabled="False"
                             Margin="0,6,8,0" />
                <TextBox Name="UrlBox"
                         Grid.Row="1" Grid.Column="1"
                         IsEnabled="False"
                         Margin="0,6,0,0" />
            </Grid>
        </HeaderedContentControl>

        <HeaderedContentControl Header="{loc:Translate pull.branch}">
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" Margin="8,4">
                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="{loc:Translate pull.local_branch}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,4" />
                <TextBox Name="LocalBranchBox"
                         Grid.Row="0" Grid.Column="1"
                         IsReadOnly="True"
                         IsTabStop="False"
                         Margin="0,0,0,4"
                         Text="{Binding CurrentBranch}" />

                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="{loc:Translate pull.remote_branch}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0" />
                <ComboBox Name="BranchBox"
                          Grid.Row="1" Grid.Column="1"
                          HorizontalAlignment="Stretch"
                          ItemsSource="{Binding RemoteBranches}"
                          SelectedItem="{Binding SelectedBranch}" />
            </Grid>
        </HeaderedContentControl>

        <HeaderedContentControl Header="{loc:Translate pull.merge_options}">
            <StackPanel Margin="8,4" Spacing="4">
                <RadioButton Name="MergeRadio"
                             GroupName="Action"
                             Content="{loc:Translate pull.merge_the_remote_branch_into_the_current_bra}"
                             IsChecked="{Binding IsMerge}" />
                <RadioButton Name="RebaseRadio"
                             GroupName="Action"
                             Content="{loc:Translate pull.rebase_the_current_branch_onto_the_remote_br}"
                             IsChecked="{Binding IsRebase}" />
                <RadioButton Name="FetchOnlyRadio"
                             GroupName="Action"
                             Content="{loc:Translate pull.do_not_merge_only_fetch_remote_changes}"
                             IsChecked="{Binding IsFetchOnly}" />

                <TextBlock Name="StrategyNoticeText"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Opacity="0.85"
                           Margin="0,4,0,0"
                           Text="{Binding StrategyNotice}" />
            </StackPanel>
        </HeaderedContentControl>

        <HeaderedContentControl Header="{loc:Translate pull.tag_options}">
            <StackPanel Margin="8,4" Spacing="4">
                <RadioButton Name="ReachableTagsRadio"
                             GroupName="Tags"
                             Content="{loc:Translate pull.fetch_tags_of_reachable_commits}"
                             IsChecked="{Binding IsReachableTags}" />
                <RadioButton Name="AllTagsRadio"
                             GroupName="Tags"
                             Content="{loc:Translate pull.fetch_all_tags}"
                             IsChecked="{Binding IsAllTags}" />
                <RadioButton Name="NoTagsRadio"
                             GroupName="Tags"
                             Content="{loc:Translate pull.do_not_fetch_tags}"
                             IsChecked="{Binding IsNoTags}" />
            </StackPanel>
        </HeaderedContentControl>

        <StackPanel Spacing="4">
            <CheckBox Name="PruneBox"
                      Content="{loc:Translate pull.prune_branches_deleted_on_the_remote}"
                      IsChecked="{Binding Prune}" />
            <CheckBox Name="PruneTagsBox"
                      Content="{loc:Translate pull.also_prune_tags_deleted_on_the_remote}"
                      Margin="20,0,0,0"
                      IsEnabled="{Binding CanPruneTags}"
                      IsChecked="{Binding PruneTags}" />
            <CheckBox Name="AutoStashBox"
                      Content="{loc:Translate pull.automatically_stash_uncommitted_changes}"
                      IsEnabled="{Binding AutoStashApplies}"
                      IsChecked="{Binding AutoStash}" />
        </StackPanel>

        <!-- "Komutu göster" ilkesi: düğmeye basmadan ne olacağı okunabilmeli. -->
        <StackPanel Spacing="3">
            <TextBlock Text="{loc:Translate pull.command_to_run}" FontSize="11" Opacity="0.8" />
            <TextBox Name="CommandPreviewBox"
                     IsReadOnly="True"
                     IsTabStop="False"
                     FontFamily="{DynamicResource GitExtMonospaceFont}"
                     FontSize="11"
                     Text="{Binding CommandPreview}" />
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock Name="WarningText"
                       FontSize="11"
                       TextWrapping="Wrap"
                       IsVisible="{Binding HasWarning}"
                       Text="{Binding Warning}"
                       Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}" />
            <TextBlock Name="NoticeText"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Opacity="0.85"
                       Text="{Binding Notice}" />
            <StackPanel Spacing="2" IsVisible="{Binding HasRecoveryCommand}">
                <TextBlock Text="{loc:Translate pull.to_undo_this}" FontSize="11" Opacity="0.8" />
                <TextBox Name="RecoveryCommandBox"
                         IsReadOnly="True"
                         FontFamily="{DynamicResource GitExtMonospaceFont}"
                         FontSize="11"
                         Text="{Binding RecoveryCommand}" />
            </StackPanel>
        </StackPanel>

        <!--
            İlerleme + iptal (P06-T10). Ölçüldü: git ilerleme satırlarını taşıma dönüşüyle
            yazıyor, bu yüzden stderr akış hâlinde okunuyor. İptal düğmesi süreci gerçekten
            öldürüyor; yarıda kesilen fetch geride kilit bırakmıyor.
        -->
        <StackPanel Name="ProgressPanel" Spacing="4" IsVisible="{Binding IsBusy}">
            <TextBlock Name="ProgressText"
                       FontSize="11"
                       Opacity="0.9"
                       TextWrapping="Wrap"
                       Text="{Binding ProgressText}" />
            <Grid ColumnDefinitions="*,Auto">
                <ProgressBar Name="ProgressBar"
                             Grid.Column="0"
                             Minimum="0"
                             Maximum="100"
                             Height="6"
                             VerticalAlignment="Center"
                             IsIndeterminate="{Binding IsProgressIndeterminate}"
                             Value="{Binding ProgressPercent}" />
                <Button Name="CancelRunButton"
                        Grid.Column="1"
                        Content="{loc:Translate pull.cancel}"
                        MinWidth="80"
                        Margin="8,0,0,0"
                        Command="{Binding CancelCommand}" />
            </Grid>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Name="CloseButton" Content="{loc:Translate pull.close}" MinWidth="90" IsCancel="True" Click="OnCloseClick" />
            <Button Name="PullButton"
                    Content="{loc:Translate pull.run}"
                    MinWidth="110"
                    IsDefault="True"
                    Command="{Binding RunCommand}" />
        </StackPanel>
    </StackPanel>
</Window>
