<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:GitExt.UI.Localization"
        xmlns:vm="using:GitExt.UI.ViewModels"
        x:Class="GitExt.UI.Views.ConflictWindow"
        x:DataType="vm:ConflictViewModel"
        Title="{loc:Translate conflict.resolve_conflicts}"
        Width="1000" Height="640"
        WindowStartupLocation="CenterOwner">

    <!--
      The layout comes from GitExtensions FormResolveConflicts (§ 9):
      conflicting files on the left, Base | Ours | Theirs on the right, actions at the bottom.
    -->
    <Grid RowDefinitions="Auto,*,Auto" Margin="12">

        <TextBlock Grid.Row="0"
                   Name="RemainingLabel"
                   Text="{Binding RemainingText}"
                   FontWeight="Bold"
                   Margin="0,0,0,8" />

        <Grid Grid.Row="1" ColumnDefinitions="260,4,*">

            <!-- Conflicting files -->
            <ListBox Grid.Column="0"
                     Name="ConflictList"
                     ItemsSource="{Binding Files}"
                     SelectedItem="{Binding Selected}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ConflictFileViewModel">
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Description}"
                                       FontSize="11"
                                       Opacity="0.7" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <GridSplitter Grid.Column="1" Background="Transparent" />

            <Grid Grid.Column="2" RowDefinitions="*,4,*" IsVisible="{Binding HasSelection}">

                <!-- Three-way panels; hidden on a presence conflict. -->
                <Grid Grid.Row="0"
                      Name="ThreeWayPanel"
                      ColumnDefinitions="*,*,*"
                      IsVisible="{Binding ShowThreeWay}">

                    <Grid Grid.Column="0" RowDefinitions="Auto,*" Margin="0,0,4,0">
                        <TextBlock Grid.Row="0" Text="{loc:Translate conflict.base_common_ancestor}" FontSize="11" Opacity="0.7" />
                        <TextBox Grid.Row="1" Name="BaseBox"
                                 Text="{Binding BaseText}"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 FontFamily="{DynamicResource GitExtMonospaceFont}"
                                 TextWrapping="NoWrap" />
                    </Grid>

                    <Grid Grid.Column="1" RowDefinitions="Auto,*" Margin="4,0">
                        <TextBlock Grid.Row="0" Text="{loc:Translate conflict.ours_current_branch}" FontSize="11" Opacity="0.7" />
                        <TextBox Grid.Row="1" Name="OursBox"
                                 Text="{Binding OursText}"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 FontFamily="{DynamicResource GitExtMonospaceFont}"
                                 TextWrapping="NoWrap" />
                    </Grid>

                    <Grid Grid.Column="2" RowDefinitions="Auto,*" Margin="4,0,0,0">
                        <TextBlock Grid.Row="0" Text="{loc:Translate conflict.theirs_incoming}" FontSize="11" Opacity="0.7" />
                        <TextBox Grid.Row="1" Name="TheirsBox"
                                 Text="{Binding TheirsText}"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 FontFamily="{DynamicResource GitExtMonospaceFont}"
                                 TextWrapping="NoWrap" />
                    </Grid>
                </Grid>

                <GridSplitter Grid.Row="1" Background="Transparent" />

                <Grid Grid.Row="2" RowDefinitions="Auto,*">
                    <TextBlock Grid.Row="0" Text="{loc:Translate conflict.result}" FontSize="11" Opacity="0.7" />
                    <TextBox Grid.Row="1" Name="MergedBox"
                             Text="{Binding MergedText}"
                             AcceptsReturn="True"
                             FontFamily="{DynamicResource GitExtMonospaceFont}"
                             TextWrapping="NoWrap" />
                </Grid>
            </Grid>
        </Grid>

        <StackPanel Grid.Row="2" Margin="0,10,0,0" Spacing="6">

            <TextBlock Name="ErrorLabel"
                       Text="{Binding Error}"
                       Foreground="{DynamicResource GitExtErrorBrush}"
                       TextWrapping="Wrap"
                       IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Name="TakeOursButton" Content="{loc:Translate conflict.take_ours}" Command="{Binding TakeOursCommand}" />
                <Button Name="TakeTheirsButton" Content="{loc:Translate conflict.take_theirs}" Command="{Binding TakeTheirsCommand}" />
                <Button Name="TakeBothButton" Content="{loc:Translate conflict.take_both}" Command="{Binding TakeBothCommand}" />
                <Button Name="SaveMergedButton" Content="{loc:Translate conflict.save_result}" Command="{Binding SaveMergedCommand}" />
                <Button Name="RemoveButton" Content="{loc:Translate conflict.delete_file}" Command="{Binding RemoveCommand}" />
                <Button Name="MergeToolButton" Content="{loc:Translate conflict.open_merge_tool}" Command="{Binding OpenMergeToolCommand}" />

                <Border Width="1" Background="{DynamicResource GitExtSeparatorBrush}" Margin="4,2" />

                <!-- Continue is enabled only once everything is resolved: running it early gives rc=128. -->
                <Button Name="ContinueButton"
                        Content="{loc:Translate conflict.continue}"
                        Command="{Binding ContinueCommand}"
                        IsDefault="True" />
                <Button Name="AbortButton" Content="{loc:Translate conflict.abort}" Command="{Binding AbortCommand}" />
                <Button Name="CloseButton" Content="{loc:Translate conflict.close}" Click="OnClose" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
