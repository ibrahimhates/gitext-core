<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:GitExt.UI.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:GitExt.UI.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="900" d:DesignHeight="220"
             x:Class="GitExt.UI.Views.CommitDetailsView"
             x:DataType="vm:CommitDetailsViewModel"
             Focusable="True">

    <UserControl.Styles>
        <StyleInclude Source="avares://GitExt.UI/Styles/RefBadgeStyles.axaml" />

        <!-- Field labels: fixed width, so the values line up. -->
        <Style Selector="TextBlock.label">
            <Setter Property="Width" Value="70" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

        <Style Selector="TextBlock.value">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- The original time zone is secondary information: it stands in the local time's shadow. -->
        <Style Selector="TextBlock.secondary">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Opacity" Value="0.6" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer>
        <StackPanel Margin="10,8" Spacing="6" IsVisible="{Binding HasCommit}">

            <TextBlock Text="{Binding Subject}"
                       FontSize="13"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap" />

            <!-- Ref badges: the same styles as the row in the list (P03-T12). -->
            <ItemsControl ItemsSource="{Binding Badges}" IsVisible="{Binding HasBadges}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:RefBadge">
                        <Border Classes="badge"
                                Margin="0,0,4,0"
                                Classes.head="{Binding IsHead}"
                                Classes.local="{Binding IsLocalBranch}"
                                Classes.remote="{Binding IsRemoteBranch}"
                                Classes.tag="{Binding IsTag}"
                                Classes.current="{Binding IsCurrent}">
                            <TextBlock Text="{Binding Text}" FontSize="10" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- The full SHA must be selectable: the user copies it and uses it elsewhere. -->
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Classes="label" Text="{loc:Translate commit_details.sha}" />
                <SelectableTextBlock Text="{Binding FullId}"
                                     FontFamily="{DynamicResource ContentControlThemeFontFamily}"
                                     FontSize="12" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Classes="label" Text="{loc:Translate commit_details.author}" />
                <StackPanel Spacing="1">
                    <SelectableTextBlock Text="{Binding AuthorText}" FontSize="12" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Classes="secondary" Text="{Binding AuthorDate}" />
                        <TextBlock Classes="secondary"
                                   Text="{Binding AuthorOriginalDateText}"
                                   IsVisible="{Binding AuthorOriginalDate, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!--
                Shown only when the committer DIFFERS from the author. Showing it when they are
                the same means two identical lines in 95% of cases; when they differ (rebase,
                cherry-pick, a patch) that difference is important information.
            -->
            <StackPanel Orientation="Horizontal" Spacing="6"
                        IsVisible="{Binding CommitterDiffersFromAuthor}">
                <TextBlock Classes="label" Text="{loc:Translate commit_details.committer}" />
                <StackPanel Spacing="1">
                    <SelectableTextBlock Text="{Binding CommitterText}" FontSize="12" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Classes="secondary" Text="{Binding CommitterDate}" />
                        <TextBlock Classes="secondary"
                                   Text="{Binding CommitterOriginalDateText}"
                                   IsVisible="{Binding CommitterOriginalDate, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasParents}">
                <TextBlock Classes="label" Text="{loc:Translate commit_details.parent}" />
                <ItemsControl ItemsSource="{Binding Parents}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:ParentLink">
                            <Button Content="{Binding Text}"
                                    Command="{Binding Command}"
                                    CommandParameter="{Binding Id}"
                                    Padding="4,0"
                                    Margin="0,0,4,0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    FontFamily="{DynamicResource ContentControlThemeFontFamily}"
                                    FontSize="12"
                                    Foreground="{DynamicResource SystemAccentColorDark1}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="6"
                        IsVisible="{Binding SignatureText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Classes="label" Text="{loc:Translate commit_details.signature}" />
                <StackPanel Spacing="1">
                    <TextBlock Text="{Binding SignatureText}"
                               FontSize="12"
                               Classes.trusted="{Binding SignatureIsTrusted}"
                               Classes.problem="{Binding SignatureIsProblem}">
                        <TextBlock.Styles>
                            <Style Selector="TextBlock.trusted">
                                <Setter Property="Foreground" Value="{DynamicResource GitExtSuccessBrush}" />
                            </Style>
                            <Style Selector="TextBlock.problem">
                                <Setter Property="Foreground" Value="{DynamicResource GitExtErrorBrush}" />
                            </Style>
                        </TextBlock.Styles>
                    </TextBlock>

                    <TextBlock Classes="secondary"
                               Text="{Binding SignatureDetail}"
                               TextWrapping="Wrap"
                               IsVisible="{Binding SignatureDetail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
            </StackPanel>

            <!-- The body is shown as it is in git, not collapsed to single spaces. -->
            <SelectableTextBlock Text="{Binding Body}"
                                 IsVisible="{Binding HasBody}"
                                 FontFamily="{DynamicResource ContentControlThemeFontFamily}"
                                 FontSize="12"
                                 TextWrapping="Wrap"
                                 Margin="0,4,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
