# Maintainer: gitext-core contributors <https://github.com/ibrahimhates/gitext-core>
#
# gitext-core — installation from a prebuilt binary (P10-T13).
#
# This package uses the published tarball; for the version that builds from source see the
# `gitext-core` package. This is the one recommended for most users: it installs without
# downloading the .NET SDK.
#
# The version and the sha256sum are filled in DURING THE RELEASE — build/arch/update.sh does
# that. Updating them by hand would create a second source for the version to diverge from
# (ADR-0006).

pkgname=gitext-core-bin
pkgver=0.0.0
pkgrel=1
pkgdesc="Fast native Git GUI — browse history, stage changes and manage branches"
arch=('x86_64')
url="https://github.com/ibrahimhates/gitext-core"
license=('GPL-3.0-or-later')

# git is a RUNTIME dependency, not an optional one (ADR-0002): the application runs git as a
# subprocess. 2.30 is the minimum from ADR-0002.
depends=('git>=2.30')

provides=('gitext-core')
conflicts=('gitext-core')

# The binary is self-contained: the .NET runtime is embedded, so dotnet-runtime is not needed.
options=('!strip')

source=("gitext-core-${pkgver}-linux-x64.tar.gz::${url}/releases/download/v${pkgver}/gitext-core-${pkgver}-linux-x64.tar.gz")
sha256sums=('SKIP')

package() {
    cd "${srcdir}/gitext-core"

    install -Dm755 gitext-core "${pkgdir}/usr/bin/gitext-core"

    install -Dm644 share/applications/io.github.ibrahimhates.GitExtCore.desktop \
        "${pkgdir}/usr/share/applications/io.github.ibrahimhates.GitExtCore.desktop"

    install -Dm644 share/metainfo/io.github.ibrahimhates.GitExtCore.metainfo.xml \
        "${pkgdir}/usr/share/metainfo/io.github.ibrahimhates.GitExtCore.metainfo.xml"

    # The icons come size by size; the directory structure has to be preserved.
    find share/icons -type f | while read -r icon; do
        install -Dm644 "$icon" "${pkgdir}/usr/${icon}"
    done

    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}

post_install() {
    gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor 2>/dev/null || true
    update-desktop-database -q /usr/share/applications 2>/dev/null || true
}

post_upgrade() {
    post_install
}
