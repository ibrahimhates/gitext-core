<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:GitExt.UI.Localization"
        x:Class="GitExt.UI.Views.AbortMergeDialog"
        Title="{loc:Translate abort_merge.abort_merge}"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <!--
        P06-T12. Yıkıcı bir işlem: birleştirmeyi iptal eden komut çalışma ağacını ÖNCESİNE
        döndürüyor, yani çakışmaları çözerken yazılan her şey gider (ölçüldü).
        P05-T15 kuralı: kaybolacak şey ekranda listeliyse onay kutusu yeterli.
    -->
    <StackPanel Margin="16" Spacing="10">
        <TextBlock Name="ExplanationText"
                   TextWrapping="Wrap"
                   Text="{loc:Translate abort_merge.the_merge_will_be_undone_and_the_working_tre}" />

        <StackPanel Name="ConflictPanel" Spacing="3">
            <TextBlock Text="{loc:Translate abort_merge.unresolved_files}" FontSize="11" Opacity="0.8" />
            <ScrollViewer MaxHeight="140">
                <ItemsControl Name="ConflictList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="x:String">
                            <TextBlock Text="{Binding}"
                                       FontFamily="{DynamicResource GitExtMonospaceFont}"
                                       FontSize="11"
                                       Margin="0,0,0,2" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>

        <CheckBox Name="ConfirmBox" Content="{loc:Translate abort_merge.i_understand_my_edits_may_be_lost}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Name="CancelButton" Content="{loc:Translate abort_merge.cancel}" MinWidth="90" IsCancel="True" Click="OnCancelClick" />
            <Button Name="ConfirmButton"
                    Content="{loc:Translate abort_merge.abort}"
                    MinWidth="110"
                    IsEnabled="{Binding #ConfirmBox.IsChecked}"
                    Click="OnConfirmClick" />
        </StackPanel>
    </StackPanel>
</Window>
