<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:GitExt.UI.Localization"
        xmlns:vm="using:GitExt.UI.ViewModels"
        x:Class="GitExt.UI.Views.RemotesWindow"
        x:DataType="vm:RemotesViewModel"
        Title="{loc:Translate remotes.remotes}"
        Width="760"
        Height="420"
        MinWidth="620"
        MinHeight="360"
        WindowStartupLocation="CenterOwner">

    <!--
        The layout comes from GitExtensions `FormRemotes.Designer.cs` (§ 9):
          · TabControl: "Remote repositories" / "Default pull behavior"
          · the list on the left (panel1, Dock=Left), the management panel on the right
            (pnlManagementContainer)
          · the button strip vertical, to the right of the list: New · Delete
          · field order: Url → Name → (Separate Push Url) → Push Url
          · "Save changes" at the very bottom

        What we DO NOT have, and why:
          · Prefix / Color  → visual settings specific to GitExtensions
          · the PuTTY SSH panel → there is no PuTTY on Linux; authentication is P06-T09
          · btnToggleState (enable/disable) → it has no counterpart in git, GitExtensions keeps
            it in its own settings file
        The second tab is IN PLACE but disabled: its content is P06-T07's (pull) subject.
    -->
    <TabControl Margin="8">

        <TabItem Header="{loc:Translate remotes.remotes}">
            <Grid ColumnDefinitions="220,Auto,*" Margin="4,8,4,4">

                <ListBox Name="RemotesList"
                         Grid.Column="0"
                         ItemsSource="{Binding Remotes}"
                         SelectedItem="{Binding Selected}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="vm:RemoteRowViewModel">
                            <StackPanel Spacing="1">
                                <TextBlock Text="{Binding Name}" />
                                <!-- The password is MASKED: display only, the edit box is raw. -->
                                <TextBlock Text="{Binding DisplayUrl}" FontSize="11" Opacity="0.7" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Column="1" Margin="8,0" Spacing="6" VerticalAlignment="Top">
                    <Button Name="NewButton"
                            Content="{loc:Translate remotes.new}"
                            MinWidth="90"
                            Command="{Binding NewCommand}"
                            ToolTip.Tip="{loc:Translate remotes.add_a_new_remote}" />
                    <Button Name="DeleteButton"
                            Content="{loc:Translate remotes.delete}"
                            MinWidth="90"
                            Command="{Binding DeleteCommand}"
                            ToolTip.Tip="{loc:Translate remotes.remove_the_selected_remote}" />
                </StackPanel>

                <Grid Grid.Column="2"
                      RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*,Auto"
                      ColumnDefinitions="Auto,*"
                      Margin="4,0,0,0">

                    <!-- Row 0: Url (the first row in FormRemotes too) -->
                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Text="{loc:Translate remotes.url}"
                               Margin="0,0,8,6"
                               VerticalAlignment="Center" />
                    <TextBox Name="UrlBox"
                             Grid.Row="0" Grid.Column="1"
                             Margin="0,0,0,6"
                             Text="{Binding Url}" />

                    <!-- Row 1: Name -->
                    <TextBlock Grid.Row="1" Grid.Column="0"
                               Text="{loc:Translate remotes.name}"
                               Margin="0,0,8,2"
                               VerticalAlignment="Center" />
                    <TextBox Name="NameBox"
                             Grid.Row="1" Grid.Column="1"
                             Text="{Binding Name}" />

                    <TextBlock Name="NameProblemText"
                               Grid.Row="2" Grid.Column="1"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0,2,0,6"
                               Text="{Binding NameProblem}"
                               IsVisible="{Binding NameProblem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}" />

                    <!-- Row 3: Separate Push Url (checkBoxSepPushUrl in FormRemotes) -->
                    <CheckBox Name="SeparatePushBox"
                              Grid.Row="3" Grid.Column="1"
                              Content="{loc:Translate remotes.separate_url_for_push}"
                              Margin="0,0,0,6"
                              IsChecked="{Binding SeparatePushUrl}" />

                    <!-- Row 4: Push Url -->
                    <TextBlock Grid.Row="4" Grid.Column="0"
                               Text="{loc:Translate remotes.push_url}"
                               Margin="0,0,8,6"
                               VerticalAlignment="Center"
                               IsEnabled="{Binding SeparatePushUrl}" />
                    <TextBox Name="PushUrlBox"
                             Grid.Row="4" Grid.Column="1"
                             Margin="0,0,0,6"
                             IsEnabled="{Binding SeparatePushUrl}"
                             Text="{Binding PushUrl}" />

                    <StackPanel Grid.Row="5" Grid.Column="1" Spacing="4">
                        <TextBlock Name="MultipleUrlText"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Text="{Binding MultipleUrlNotice}"
                                   IsVisible="{Binding HasMultipleUrls}" />

                        <TextBlock Name="WarningText"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Text="{Binding Warning}"
                                   IsVisible="{Binding HasWarning}"
                                   Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}" />

                        <TextBlock Name="NoticeText"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Opacity="0.8"
                                   Text="{Binding Notice}" />
                    </StackPanel>

                    <StackPanel Grid.Row="7" Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Spacing="8">
                        <Button Name="CloseButton"
                                Content="{loc:Translate remotes.close}"
                                MinWidth="90"
                                IsCancel="True"
                                Click="OnCloseClick" />
                        <Button Name="SaveButton"
                                Content="{loc:Translate remotes.save_changes}"
                                MinWidth="140"
                                IsDefault="True"
                                Command="{Binding SaveCommand}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </TabItem>

        <!-- IN PLACE but disabled so the order is not broken: its content is P06-T07. -->
        <TabItem Name="PullBehaviorTab" Header="{loc:Translate remotes.default_pull_behaviour}" IsEnabled="False">
            <TextBlock Margin="12"
                       TextWrapping="Wrap"
                       Text="{loc:Translate remotes.per_branch_default_pull_settings_are_not_imp}" />
        </TabItem>
    </TabControl>
</Window>
