<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:GitExt.UI.Localization"
        x:Class="GitExt.UI.Views.DashboardCategoryDialog"
        Title="{loc:Translate dashboard.category_name}"
        Width="400"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <!--
        P12-T03. Its counterpart in GitExtensions is `FormDashboardCategoryTitle`: a label, a text
        box and OK/Cancel, 400 wide there too.

        The one difference: GitExtensions checks the name AFTER OK is pressed and answers with a
        message box. Here the reason is written under the box while typing and OK stays disabled —
        the same two rules ("required", "already exists"), told before the click rather than after.
    -->
    <StackPanel Margin="16" Spacing="10">

        <StackPanel Spacing="4">
            <TextBlock Name="CategoryLabel" Text="{loc:Translate dashboard.category_name}" />
            <TextBox Name="CategoryNameBox" />
            <TextBlock Name="ValidationText"
                       FontSize="11"
                       TextWrapping="Wrap"
                       IsVisible="False"
                       Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Name="CancelButton"
                    Content="{loc:Translate dashboard.cancel}"
                    MinWidth="90"
                    IsCancel="True"
                    Click="OnCancelClick" />
            <Button Name="OkButton"
                    Content="{loc:Translate dashboard.ok}"
                    MinWidth="90"
                    IsDefault="True"
                    Click="OnOkClick" />
        </StackPanel>
    </StackPanel>
</Window>
