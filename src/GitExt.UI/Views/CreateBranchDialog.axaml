<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:GitExt.UI.Localization"
        x:Class="GitExt.UI.Views.CreateBranchDialog"
        Title="{loc:Translate create_branch.create_branch}"
        Width="520"
        SizeToContent="Height"
        MinHeight="220"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <!--
        The layout comes from GitExtensions `FormCreateBranch.Designer.cs` (§ 9). TabIndex order:
          0/1 label1 "Branch name"        + BranchNameTextBox
          2/3 lblCreateBranch "Create branch at this revision" + commitPicker
          5   chkCheckoutAfterCreate      (CHECKED BY DEFAULT — as it is in GitExtensions)
              grpOrphan: chkCreateOrphan + chkClearOrphan
          cmdOk

        The orphan group is in place but DISABLED (§ 9 rule 2): it is out of P06-T01's scope,
        and slotting it in later would break the order.
    -->
    <StackPanel Margin="16" Spacing="10">

        <StackPanel Spacing="4">
            <TextBlock Text="{loc:Translate create_branch.branch_name}" />
            <TextBox Name="BranchNameTextBox" PlaceholderText="{loc:Translate create_branch.feature_new_thing}" />
            <TextBlock Name="ValidationText"
                       FontSize="11"
                       TextWrapping="Wrap"
                       IsVisible="False"
                       Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}" />
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock Name="StartPointLabel" Text="{loc:Translate create_branch.create_branch_at_this_revision}" />
            <!--
                In GitExtensions this is a commit picker. Here the starting point comes from the
                caller (the selection in the commit list, or HEAD), so it is shown read-only; the
                picker arrives in P06-T14 together with the context menu.
            -->
            <TextBox Name="StartPointText" IsReadOnly="True" IsTabStop="False" />
        </StackPanel>

        <CheckBox Name="CheckoutAfterCreateBox"
                  Content="{loc:Translate create_branch.check_out_after_creating}"
                  IsChecked="True" />

        <TextBlock Name="DirtyWarning"
                   FontSize="11"
                   TextWrapping="Wrap"
                   IsVisible="False"
                   Opacity="0.85" />

        <StackPanel Name="OrphanGroup" Spacing="4" IsEnabled="False">
            <CheckBox Name="CreateOrphanBox" Content="{loc:Translate create_branch.create_an_orphan_branch_no_parent}" FontSize="11" />
            <CheckBox Name="ClearOrphanBox" Content="{loc:Translate create_branch.clear_the_working_tree_on_the_orphan_branch}" FontSize="11" Margin="18,0,0,0" />
        </StackPanel>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8">
            <Button Name="CancelButton" Content="{loc:Translate create_branch.cancel}" MinWidth="90" IsCancel="True" Click="OnCancelClick" />
            <Button Name="CreateButton" Content="{loc:Translate create_branch.create}" MinWidth="90" IsDefault="True" Click="OnCreateClick" />
        </StackPanel>
    </StackPanel>
</Window>
