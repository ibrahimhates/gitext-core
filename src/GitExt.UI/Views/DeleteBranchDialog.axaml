<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="GitExt.UI.Views.DeleteBranchDialog"
        Title="Dalı sil"
        Width="520"
        SizeToContent="Height"
        MinHeight="180"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <!--
        Yerleşim GitExtensions `FormDeleteBranch`'ten (§ 9): dal listesi + "Delete" düğmesi.
        Eklenen: birleştirilmemiş dalda KURTARMA KOMUTU. GitExtensions yalnızca
        "not been merged into HEAD. Proceed?" diye soruyor; ölçüm gösterdi ki silme sonrası
        dalın kendi reflog'u da gidiyor, dolayısıyla kullanıcıya geri dönüş yolunu
        vermezsek gerçekten kaybedebilir.
    -->
    <StackPanel Margin="16" Spacing="10">

        <TextBlock Name="MessageText" TextWrapping="Wrap" FontWeight="SemiBold" />

        <StackPanel Name="UnmergedPanel" Spacing="8" IsVisible="False">
            <TextBlock Name="UnmergedText"
                       TextWrapping="Wrap"
                       Text="Bu dal, başka hiçbir yere birleştirilmemiş commit'ler içeriyor. Silinirse bu commit'ler hiçbir dalda görünmez." />

            <StackPanel Spacing="3">
                <TextBlock Text="Geri getirmek için:" FontSize="11" Opacity="0.85" />
                <TextBox Name="RecoveryCommand"
                         IsReadOnly="True"
                         FontFamily="Cascadia Mono,Consolas,Menlo,DejaVu Sans Mono,monospace"
                         FontSize="11" />
                <TextBlock Name="RecoveryNote"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Opacity="0.75"
                           Text="Bu komutu not alın: dal silinince kendi reflog'u da silinir." />
            </StackPanel>

            <CheckBox Name="ForceBox" Content="Birleştirilmemiş olmasına rağmen sil" />
        </StackPanel>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8">
            <Button Name="CancelButton" Content="İptal" MinWidth="90" IsCancel="True" Click="OnCancelClick" />
            <Button Name="DeleteButton" Content="Sil" MinWidth="90" IsDefault="True" Click="OnDeleteClick" />
        </StackPanel>
    </StackPanel>
</Window>
