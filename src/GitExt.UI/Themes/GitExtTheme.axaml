<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Uygulamanın tek tema girişi (P08-T07). `App.axaml` yalnızca bunu ekler; hangi
        sözlüklerin hangi sırayla yükleneceği burada, tek yerde duruyor.
    -->

    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://GitExt.UI/Themes/Palette.axaml" />
                <ResourceInclude Source="avares://GitExt.UI/Themes/Typography.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Styles.Resources>

    <StyleInclude Source="avares://GitExt.UI/Styles/RefBadgeStyles.axaml" />
</Styles>
