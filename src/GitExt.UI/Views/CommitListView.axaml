<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:GitExt.UI.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:GitExt.UI.ViewModels"
             xmlns:controls="using:GitExt.UI.Controls"
             xmlns:views="using:GitExt.UI.Views"
             mc:Ignorable="d"
             d:DesignWidth="900" d:DesignHeight="500"
             x:Class="GitExt.UI.Views.CommitListView"
             x:DataType="vm:CommitListViewModel"
             Loaded="OnViewLoaded">

    <!--
        The P03-T09 decision: a virtualised ListBox plus custom drawing for the graph column.
        Selection, keyboard navigation and accessibility come from the ListBox; only the
        lane/node/edge drawing is custom (producing a variable number of lines in XAML would be
        expensive and unwieldy).
    -->

    <UserControl.Styles>
        <StyleInclude Source="avares://GitExt.UI/Styles/RefBadgeStyles.axaml" />
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*">

        <!-- Search, error and loading state -->
        <StackPanel Grid.Row="0" Margin="8,6" Spacing="4">

            <!--
                Jump by SHA (P03-T14). Only the SHA prefix is searched; searching message/author
                is a separate task (P07-T21) and is not mixed in here.
            -->
            <Grid ColumnDefinitions="*,Auto">
                <TextBox Grid.Column="0"
                         Name="ShaSearchBox"
                         Text="{Binding SearchText}"
                         PlaceholderText="{loc:Translate commit_list.jump_to_sha_ctrl_f}"
                         FontSize="12" />

                <TextBlock Grid.Column="1"
                           Text="{Binding SearchStatus}"
                           IsVisible="{Binding SearchStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0" />
            </Grid>

            <!--
                Summary + "Details" (P05-T07). The summary is one classified sentence; git's
                actual output lives in a separate window. The button appears only when there is
                output to show.
            -->
            <StackPanel Orientation="Horizontal"
                        Spacing="8"
                        IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}">

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />

                <views:GitErrorDetailsButton Details="{Binding ErrorDetails}" />
            </StackPanel>

            <ProgressBar IsIndeterminate="True"
                         Height="2"
                         IsVisible="{Binding IsLoading}" />
        </StackPanel>

        <!--
            SelectedIndex is bound, not SelectedItem: the single source of truth for the
            selection is the index (see CommitListViewModel.SelectedIndex).
        -->
        <ListBox Grid.Row="1"
                 Name="CommitList"
                 ItemsSource="{Binding Rows}"
                 SelectedIndex="{Binding SelectedIndex}"
                 SelectionMode="Multiple"
                 Background="Transparent"
                 BorderThickness="0">

            <ListBox.Styles>
                <!-- Rows are narrow and of fixed height: virtualisation depends on that. -->
                <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="MinHeight" Value="22" />
                </Style>
            </ListBox.Styles>

            <!--
                COMMIT CONTEXT MENU — the item order was taken verbatim from GitExtensions'
                `RevisionGridControl` `mainContextMenu` (P08-T27):

                  bisect · separator · copy to clipboard · separator · stash ·
                  separator · checkout branch / push / merge / rebase / reset current ·
                  separator · reset changes / commit / create branch / reset other /
                          rename / delete branch ·
                  separator · create tag / delete tag ·
                  separator · checkout this commit / revert / cherry pick / archive / advanced ·
                  separator · compare · separator · navigate / view …

                ⚠️ Unimplemented commands are NOT REMOVED, they stay disabled: the user reaches
                for the position they know from GitExtensions by muscle memory, and slotting an
                item in later would break the order. Bisect is Phase 07, stash/branch/tag are
                Phases 05-06.
            -->
            <ListBox.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="{loc:Translate commit_list.mark_revision_bad}" IsEnabled="False" />
                    <MenuItem Header="{loc:Translate commit_list.mark_revision_good}" IsEnabled="False" />
                    <MenuItem Header="{loc:Translate commit_list.skip_revision}" IsEnabled="False" />
                    <Separator />

                    <!-- In GitExtensions this submenu is dynamic: branches/tags plus fixed entries -->
                    <MenuItem Header="{loc:Translate commit_list.copy_to_clipboard}">
                        <MenuItem Header="{loc:Translate commit_list.commit_hash}" Click="OnCopyHashClick" />
                        <MenuItem Header="{loc:Translate commit_list.message}" Click="OnCopyMessageClick" />
                        <MenuItem Header="{loc:Translate commit_list.author}" Click="OnCopyAuthorClick" />
                        <MenuItem Header="{loc:Translate commit_list.date}" Click="OnCopyDateClick" />
                        <Separator />
                        <MenuItem Header="{loc:Translate commit_list.branch_name}" Click="OnCopyBranchClick" />
                    </MenuItem>
                    <Separator />

                    <MenuItem Header="{loc:Translate commit_list.apply_stash}" IsEnabled="False" />
                    <MenuItem Header="{loc:Translate commit_list.pop_stash}" IsEnabled="False" />
                    <MenuItem Header="{loc:Translate commit_list.drop_stash}" IsEnabled="False" />
                    <Separator />

                    <MenuItem Header="{loc:Translate commit_list.chec_k_out_branch}" Click="OnCheckoutClick" />
                    <MenuItem Name="MenuContextPush" Header="{loc:Translate commit_list.pus_h_branch}" Click="OnPushClick" />
                    <MenuItem Name="MenuContextMerge" Header="{loc:Translate commit_list.merge_into_current_branch}" Click="OnMergeClick" />
                    <MenuItem Name="MenuContextRebase" Header="{loc:Translate commit_list.rebase_current_branch_onto_this}"
                              Click="OnRebaseClick" />
                    <MenuItem Name="MenuContextReset" Header="{loc:Translate commit_list.reset_current_branch_here}"
                              Click="OnResetClick" />
                    <Separator />

                    <MenuItem Header="{loc:Translate commit_list.reset_changes}" IsEnabled="False" />
                    <MenuItem Header="{loc:Translate commit_list.commit}" IsEnabled="False" />
                    <MenuItem Header="{loc:Translate commit_list.create_new_branch_here}" Click="OnCreateBranchClick" />
                    <MenuItem Header="{loc:Translate commit_list.reset_another_branch_here}" IsEnabled="False" />
                    <MenuItem Header="{loc:Translate commit_list.rename_branch}" Click="OnRenameBranchClick" />
                    <MenuItem Header="{loc:Translate commit_list.delete_branch}" Click="OnDeleteBranchClick" />
                    <Separator />

                    <MenuItem Header="{loc:Translate commit_list.create_new_tag_here}" IsEnabled="False" />
                    <MenuItem Header="{loc:Translate commit_list.delete_tag}" IsEnabled="False" />
                    <Separator />

                    <MenuItem Header="{loc:Translate commit_list.check_out_this_commit}" Click="OnCheckoutClick" />
                    <MenuItem Name="MenuContextRevert" Header="{loc:Translate commit_list.revert_this_commit}" Click="OnRevertClick" />
                    <MenuItem Name="MenuContextCherryPick" Header="{loc:Translate commit_list.cherry_pick_this_commit}" Click="OnCherryPickClick" />
                    <MenuItem Header="{loc:Translate commit_list.archive_this_commit}" IsEnabled="False" />
                    <Separator />

                    <!-- Arrived in Phase 04: the only working group. -->
                    <MenuItem Header="{loc:Translate commit_list.compa_re}">
                        <MenuItem Header="{loc:Translate commit_list.compare_the_two_selected_commits}"
                                  InputGesture="Ctrl+D"
                                  Click="OnCompareSelectedClick" />
                        <MenuItem Header="{loc:Translate commit_list.compare_with_working_tree}"
                                  Click="OnCompareWorkingTreeClick" />
                        <MenuItem Header="{loc:Translate commit_list.compare_with_head}"
                                  InputGesture="Ctrl+Shift+D"
                                  Click="OnCompareHeadClick" />
                    </MenuItem>
                    <Separator />

                    <MenuItem Header="{loc:Translate commit_list.go}">
                        <MenuItem Header="{loc:Translate commit_list.to_parent}" InputGesture="Alt+Down" Click="OnGoToParentClick" />
                        <MenuItem Header="{loc:Translate commit_list.to_child}" InputGesture="Alt+Up" Click="OnGoToChildClick" />
                    </MenuItem>
                </ContextMenu>
            </ListBox.ContextMenu>

            <ListBox.ItemTemplate>
                <DataTemplate DataType="vm:CommitRowViewModel">
                    <!--
                        The column order is GitExtensions' own (`RevisionGridControl`, the order
                        the providers are added): graph · message · author · date · commit id.
                        The SHA is LAST there, not next to the graph — and the ref badges sit
                        INSIDE the message column, in front of the subject
                        (`MessageColumnProvider` draws them there).

                        Notes, avatar and build status are the three columns we do not have; they
                        sit between message and author in GitExtensions.
                    -->
                    <Grid Height="22"
                          ColumnDefinitions="Auto,Auto,*,140,120,70">

                        <!-- Graph column - the one piece that draws itself -->
                        <!--
                            The graph column has a FIXED width and every row shows the same lane
                            window (P03-T21). Tying the width to the per-row lane count made the
                            column ~2200 px wide in real repositories and pushed every other
                            column off screen (measured in P03-T18).

                            The window follows the selected commit; lanes overflowing to either
                            side are announced by markers at the edge.
                        -->
                        <controls:CommitGraphCell
                            Grid.Column="0"
                            Row="{Binding GraphRow}"
                            PreviousRow="{Binding PreviousGraphRow}"
                            HasRefs="{Binding HasBadges}"
                            IsHead="{Binding IsHead}"
                            IsRelative="{Binding IsRelative}"
                            PreviousIsRelative="{Binding PreviousIsRelative}"
                            ClipToBounds="True"
                            Margin="4,0,8,0"
                            FirstLane="{Binding $parent[ListBox].((vm:CommitListViewModel)DataContext).FirstVisibleLane}"
                            VisibleLanes="{Binding $parent[ListBox].((vm:CommitListViewModel)DataContext).VisibleLanes}" />

                        <!--
                            Ref badges, in separate styles BY KIND (P03-T12).
                            The kind comes from for-each-ref, not from git's %D field; %D does not
                            tell a local branch from a remote one (measured).
                        -->
                        <ItemsControl Grid.Column="1"
                                      ItemsSource="{Binding Badges}"
                                      IsVisible="{Binding HasBadges}"
                                      VerticalAlignment="Center"
                                      Margin="0,0,6,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:RefBadge">
                                    <!--
                                        The style is selected by kind through CSS-like classes.
                                        Because classes are bindable, each kind takes its own
                                        colour from UserControl.Styles.
                                    -->
                                    <Border Classes="badge"
                                            Classes.head="{Binding IsHead}"
                                            Classes.local="{Binding IsLocalBranch}"
                                            Classes.remote="{Binding IsRemoteBranch}"
                                            Classes.tag="{Binding IsTag}"
                                            Classes.current="{Binding IsCurrent}">
                                        <TextBlock Text="{Binding Text}" FontSize="10" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Grid.Column="2"
                                   Text="{Binding Subject}"
                                   FontSize="12"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />

                        <TextBlock Grid.Column="3"
                                   Text="{Binding AuthorName}"
                                   FontSize="12"
                                   Opacity="0.75"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />

                        <TextBlock Grid.Column="4"
                                   Text="{Binding DateText}"
                                   FontSize="12"
                                   Opacity="0.65"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />

                        <TextBlock Grid.Column="5"
                                   Text="{Binding ShortId}"
                                   FontFamily="{DynamicResource GitExtMonospaceFont}"
                                   FontSize="12"
                                   Opacity="0.65"
                                   VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
