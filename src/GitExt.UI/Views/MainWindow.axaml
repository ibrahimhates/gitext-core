<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:GitExt.UI.ViewModels"
        xmlns:views="using:GitExt.UI.Views"
        mc:Ignorable="d"
        d:DesignWidth="1000" d:DesignHeight="600"
        x:Class="GitExt.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="gitext-core"
        Width="1000" Height="600"
        MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        DragDrop.AllowDrop="True">

    <Grid RowDefinitions="Auto,Auto,*">

        <!--
            ANA MENÜ — sıra ve öğe adları GitExtensions'tan alındı (P08-T26):
            Start · Dashboard · Repository · Commands · Tools · Help.
            (Plugins ve "Repository hosts" bizde yok.)

            ⚠️ Henüz uygulanmamış komutlar KALDIRILMIYOR, `IsEnabled="False"` ile yerinde
            duruyor. Kullanıcının kuralı: GitExtensions'a alışkın biri aynı öğeyi aynı yerde
            bulmalı; sonradan araya sokmak sırayı bozar.
        -->
        <Menu Grid.Row="0" Name="MainMenu">

            <MenuItem Header="_Başlangıç">
                <MenuItem Name="MenuCreateRepository" Header="Yeni depo oluştur…" IsEnabled="False" />
                <MenuItem Name="MenuOpen" Header="_Aç…" Click="OnOpenClick" />
                <MenuItem Name="MenuClone" Header="Depo k_lonla…" IsEnabled="False" />
                <Separator />
                <MenuItem Name="MenuRecentRepositories"
                          Header="Son _depolar"
                          ItemsSource="{Binding RecentRepositories}">
                    <MenuItem.ItemTemplate>
                        <DataTemplate DataType="vm:RecentRepositoryItem">
                            <TextBlock Text="{Binding Path}" />
                        </DataTemplate>
                    </MenuItem.ItemTemplate>
                    <MenuItem.Styles>
                        <Style Selector="MenuItem > MenuItem" x:DataType="vm:RecentRepositoryItem">
                            <Setter Property="Command" Value="{Binding OpenCommand}" />
                            <Setter Property="CommandParameter" Value="{Binding Path}" />
                        </Style>
                    </MenuItem.Styles>
                </MenuItem>
                <Separator />
                <MenuItem Name="MenuExit" Header="Çı_kış" Click="OnExitClick" />
            </MenuItem>

            <MenuItem Header="_Pano">
                <MenuItem Name="MenuDashboardRefresh"
                          Header="_Yenile"
                          Command="{Binding RefreshCommand}" />
            </MenuItem>

            <MenuItem Header="_Depo" IsEnabled="{Binding HasRepository}">
                <MenuItem Name="MenuRepositoryRefresh"
                          Header="_Yenile"
                          InputGesture="F5"
                          Command="{Binding RefreshCommand}" />
                <MenuItem Name="MenuFileExplorer" Header="Dosya _gezgini" IsEnabled="False" />
                <Separator />
                <MenuItem Name="MenuRemotes"
                          Header="Uzak _depolar…"
                          Command="{Binding ManageRemotesCommand}" />
                <Separator />
                <MenuItem Name="MenuSubmodules" Header="Alt modülleri yö_net…" IsEnabled="False" />
                <MenuItem Name="MenuWorktrees" Header="Ça_lışma ağaçlarını yönet…" IsEnabled="False" />
                <Separator />
                <MenuItem Name="MenuEditGitignore" Header=".git_ignore düzenle" IsEnabled="False" />
                <MenuItem Name="MenuRepositorySettings" Header="Depo aya_rları…" IsEnabled="False" />
                <Separator />
                <MenuItem Name="MenuCloseRepository"
                          Header="_Kapat (panoya dön)"
                          Command="{Binding CloseRepositoryCommand}" />
            </MenuItem>

            <MenuItem Header="_Komutlar" IsEnabled="{Binding HasRepository}">
                <!-- Faz 05 -->
                <MenuItem Name="MenuCommit" Header="_Commit…" Click="OnCommitClick" />
                <MenuItem Name="MenuUndoLastCommit" Header="Son commit'i _geri al…" IsEnabled="False" />
                <!-- Faz 06 -->
                <MenuItem Name="MenuPull" Header="Pull_/Fetch…" Command="{Binding PullCommand}" />
                <MenuItem Name="MenuPush" Header="_Push…" Command="{Binding PushCommand}" />
                <Separator />
                <MenuItem Name="MenuStashes" Header="Stash'leri yö_net…" IsEnabled="False" />
                <MenuItem Name="MenuResetChanges" Header="Değişiklikleri sıfı_rla…" IsEnabled="False" />
                <Separator />
                <MenuItem Name="MenuCreateBranch" Header="_Dal oluştur…"
                          Command="{Binding CreateBranchCommand}" />
                <MenuItem Name="MenuDeleteBranch" Header="Da_l sil…"
                          Command="{Binding DeleteBranchCommand}" />
                <MenuItem Name="MenuCheckoutBranch" Header="Dala geç (chec_kout)…"
                          Command="{Binding CheckoutCommand}" />
                <MenuItem Name="MenuMerge" Header="Dalları _birleştir…" Command="{Binding MergeCommand}" />
                <MenuItem Name="MenuRebase" Header="R_ebase…" IsEnabled="False" />
                <Separator />
                <MenuItem Name="MenuCreateTag" Header="Etiket oluş_tur…" IsEnabled="False" />
                <MenuItem Name="MenuDeleteTag" Header="Etiket si_l…" IsEnabled="False" />
                <Separator />
                <!-- Faz 07 -->
                <MenuItem Name="MenuCherryPick" Header="Cherr_y pick…" IsEnabled="False" />
                <MenuItem Name="MenuCheckoutRevision" Header="Revizyona geç…" IsEnabled="False" />
                <MenuItem Name="MenuBisect" Header="B_isect…" IsEnabled="False" />
                <MenuItem Name="MenuReflog" Header="Reflo_g'u göster…" IsEnabled="False" />
            </MenuItem>

            <MenuItem Header="_Araçlar">
                <MenuItem Name="MenuSettings" Header="Aya_rlar…" IsEnabled="False" />
            </MenuItem>

            <MenuItem Header="_Yardım">
                <MenuItem Name="MenuAbout" Header="_Hakkında" Click="OnAboutClick" />
            </MenuItem>
        </Menu>

        <Border Grid.Row="1"
                Padding="10,7"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">

            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock Grid.Column="0"
                           Text="{Binding Subtitle}"
                           FontSize="12"
                           Opacity="0.75"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />

                <!--
                    Yükleme göstergesi ve iptal (P03-T17). Çok büyük bir depoda kullanıcı
                    yanlış klasörü açtığını fark edebilir; bitmesini beklemek zorunda kalmamalı.
                -->
                <TextBlock Grid.Column="1"
                           Text="{Binding Commits.LoadedCount, StringFormat='{}{0} commit yüklendi…'}"
                           IsVisible="{Binding Commits.IsLoading}"
                           FontSize="12"
                           Opacity="0.7"
                           VerticalAlignment="Center"
                           Margin="8,0" />

                <Button Grid.Column="2"
                        Content="İptal"
                        Command="{Binding CancelLoadingCommand}"
                        IsVisible="{Binding Commits.IsLoading}"
                        FontSize="11"
                        Padding="8,2" />
            </Grid>
        </Border>

        <!--
            Dal işlemi şeridi (P06-T01). Modal bir "tamam" kutusu yerine şerit — P05-T15'teki
            sıfırlama şeridiyle aynı gerekçe: işlemden SONRA gösterilen diyalog yalnızca
            kapatılmayı bekleyen bir engeldir. Hata da buraya yazılıyor; ham stderr değil,
            sınıflandırılmış mesaj.
        -->
        <Border Grid.Row="2"
                Name="BranchNoticeBar"
                VerticalAlignment="Top"
                IsVisible="{Binding BranchNotice, Converter={x:Static ObjectConverters.IsNotNull}}"
                Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                BorderThickness="1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                CornerRadius="3"
                Padding="8,5"
                Margin="10,6"
                ZIndex="10">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           Name="BranchNoticeText"
                           Text="{Binding BranchNotice}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           FontSize="12" />

                <Button Grid.Column="1"
                        Name="DismissBranchNoticeButton"
                        Content="✕"
                        FontSize="12"
                        Margin="4,0,0,0"
                        Click="OnDismissBranchNoticeClick" />
            </Grid>
        </Border>

        <!--
            Ayrık HEAD ve süren işlem şeritleri (P06-T04). İkisi birbirini DIŞLIYOR:
            ölçüldü, rebase ve bisect sırasında HEAD gerçekten ayrık; iki şeridi birden
            göstermek kullanıcıya "hem ayrıksın hem rebase'desin" demek olurdu ve
            "buradan dal oluştur" orada yapılması gereken şey değil.
        -->
        <Border Grid.Row="2"
                Name="DetachedBanner"
                VerticalAlignment="Top"
                IsVisible="{Binding ShowDetachedBanner}"
                Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                BorderThickness="1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                CornerRadius="3"
                Padding="8,5"
                Margin="10,6"
                ZIndex="9">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           Name="DetachedText"
                           Text="Ayrık HEAD: bir dalın üzerinde değilsiniz. Buradan atacağınız commit'ler hiçbir dalda görünmez."
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           FontSize="12" />

                <Button Grid.Column="1"
                        Name="DetachedCreateBranchButton"
                        Content="Buradan dal oluştur…"
                        FontSize="12"
                        Margin="8,0,0,0"
                        Command="{Binding CreateBranchCommand}" />
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Name="OperationBanner"
                VerticalAlignment="Top"
                IsVisible="{Binding ShowOperationBanner}"
                Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                BorderThickness="1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                CornerRadius="3"
                Padding="8,5"
                Margin="10,6"
                ZIndex="9">
            <!--
                P06-T12: süren merge'den çıkış aynı şeritten. Düğme yalnızca merge'de
                görünüyor — rebase/cherry-pick/revert'in iptali farklı komutlar ve
                Faz 07'nin konusu; yanlış komutu sunmak yarım bir işi bozardı.
            -->
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Name="OperationText"
                           Grid.Column="0"
                           Text="{Binding OperationText}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           FontSize="12" />
                <Button Name="AbortMergeButton"
                        Grid.Column="1"
                        Content="Birleştirmeyi iptal et"
                        Margin="8,0,0,0"
                        IsVisible="{Binding CanAbortMerge}"
                        Command="{Binding AbortMergeCommand}" />
            </Grid>
        </Border>

        <!-- Depo açılmadıysa karşılama ekranı; boş pencere göstermek yerine yol gösterilir. -->
        <views:WelcomeView Grid.Row="2" IsVisible="{Binding ShowWelcome}" />

        <!--
            Liste üstte, detay altta — GitExtensions'ın yerleşimi. Ayırıcı sürüklenebilir;
            detay paneli sabit yükseklikte olsaydı uzun commit mesajları okunamazdı.
        -->
        <Grid Grid.Row="2"
              RowDefinitions="*,Auto,Auto"
              IsVisible="{Binding !ShowWelcome}">

            <views:CommitListView Grid.Row="0" DataContext="{Binding Commits}" />

            <!-- Depo açık ama hiç commit yok: yeni `git init`. Boş ekran değil, açıklama. -->
            <Border Grid.Row="0"
                    IsVisible="{Binding Commits.IsEmptyRepository}"
                    Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
                    <TextBlock Text="Bu depoda henüz commit yok."
                               FontSize="14"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="İlk commit atıldığında geçmiş burada görünecek."
                               FontSize="12"
                               Opacity="0.65"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <GridSplitter Grid.Row="1"
                          Height="4"
                          ResizeDirection="Rows"
                          Background="{DynamicResource SystemControlForegroundBaseLowBrush}"
                          IsVisible="{Binding Commits.Details.HasCommit}" />

            <!--
                Alt alan sekmeli: detay ve değişen dosyalar. GitExtensions'ın yerleşimi de
                böyle (grid üstte, altta sekmeli alan). Diff bileşeni bağımsız olduğu için
                aynısı P04-T16'nın ayrı penceresinde de kullanılacak.
            -->
            <TabControl Grid.Row="2"
                        Height="220"
                        MinHeight="80"
                        Padding="0"
                        IsVisible="{Binding Commits.Details.HasCommit}">

                <TabItem Header="Detay" FontSize="12">
                    <views:CommitDetailsView DataContext="{Binding Commits.Details}" />
                </TabItem>

                <TabItem Header="Değişiklikler" FontSize="12">
                    <views:DiffView DataContext="{Binding Commits.Diff}" />
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
