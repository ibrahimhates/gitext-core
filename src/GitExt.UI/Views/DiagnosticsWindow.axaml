<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:GitExt.UI.Localization"
        xmlns:vm="using:GitExt.UI.ViewModels"
        x:Class="GitExt.UI.Views.DiagnosticsWindow"
        x:DataType="vm:DiagnosticsViewModel"
        Title="{loc:Translate diagnostics.performance_diagnostics}"
        Width="720"
        Height="560"
        WindowStartupLocation="CenterOwner">

    <!--
        P09-T03. A hidden panel: not in the menu, opened only by shortcut.
        Collection is always on; what is hidden is the display.

        A summary at the top (memory, frames, uptime), per-command statistics below.
        The frame section appears only when there is a measurement.
    -->
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="10">

        <Grid Grid.Row="0" ColumnDefinitions="*,*" Margin="0,0,0,8">
            <StackPanel Grid.Column="0" Spacing="3">
                <TextBlock Text="{loc:Translate diagnostics.memory}" FontWeight="SemiBold" FontSize="11" />
                <Grid ColumnDefinitions="110,*">
                    <TextBlock Grid.Column="0" Text="{loc:Translate diagnostics.managed}" FontSize="11" Opacity="0.75" />
                    <TextBlock Name="ManagedMemoryText" Grid.Column="1" Text="{Binding ManagedMemory}" FontSize="11" />
                </Grid>
                <Grid ColumnDefinitions="110,*">
                    <TextBlock Grid.Column="0" Text="{loc:Translate diagnostics.process}" FontSize="11" Opacity="0.75" />
                    <TextBlock Name="ProcessMemoryText" Grid.Column="1" Text="{Binding ProcessMemory}" FontSize="11" />
                </Grid>
                <Grid ColumnDefinitions="110,*">
                    <TextBlock Grid.Column="0" Text="{loc:Translate diagnostics.collection}" FontSize="11" Opacity="0.75" />
                    <TextBlock Name="CollectionsText" Grid.Column="1" Text="{Binding Collections}" FontSize="11" />
                </Grid>
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="3">
                <TextBlock Text="{loc:Translate diagnostics.session}" FontWeight="SemiBold" FontSize="11" />
                <Grid ColumnDefinitions="110,*">
                    <TextBlock Grid.Column="0" Text="{loc:Translate diagnostics.uptime}" FontSize="11" Opacity="0.75" />
                    <TextBlock Name="UptimeText" Grid.Column="1" Text="{Binding Uptime}" FontSize="11" />
                </Grid>
                <Grid ColumnDefinitions="110,*">
                    <TextBlock Grid.Column="0" Text="{loc:Translate diagnostics.git_calls}" FontSize="11" Opacity="0.75" />
                    <TextBlock Name="TotalCommandCountText" Grid.Column="1" Text="{Binding TotalCommandCount}" FontSize="11" />
                </Grid>
                <Grid ColumnDefinitions="110,*">
                    <TextBlock Grid.Column="0" Text="{loc:Translate diagnostics.total_time}" FontSize="11" Opacity="0.75" />
                    <TextBlock Name="TotalCommandDurationText" Grid.Column="1" Text="{Binding TotalCommandDuration}" FontSize="11" />
                </Grid>
            </StackPanel>
        </Grid>

        <!-- Frame measurement exists only when it is attached to a window. -->
        <StackPanel Grid.Row="1" Spacing="3" Margin="0,0,0,8" IsVisible="{Binding HasFrameStatistics}">
            <TextBlock Text="{loc:Translate diagnostics.frame_time}" FontWeight="SemiBold" FontSize="11" />
            <Grid ColumnDefinitions="110,*">
                <TextBlock Grid.Column="0" Text="{loc:Translate diagnostics.average}" FontSize="11" Opacity="0.75" />
                <TextBlock Name="AverageFrameTimeText" Grid.Column="1" Text="{Binding AverageFrameTime}" FontSize="11" />
            </Grid>
            <Grid ColumnDefinitions="110,*">
                <TextBlock Grid.Column="0" Text="{loc:Translate diagnostics.worst}" FontSize="11" Opacity="0.75" />
                <TextBlock Name="WorstFrameTimeText" Grid.Column="1" Text="{Binding WorstFrameTime}" FontSize="11" />
            </Grid>
            <Grid ColumnDefinitions="110,*">
                <TextBlock Grid.Column="0" Text="{loc:Translate diagnostics.over_budget}" FontSize="11" Opacity="0.75" />
                <TextBlock Name="DroppedFramesText"
                           Grid.Column="1"
                           Text="{Binding DroppedFrames}"
                           FontSize="11"
                           Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"
                           IsVisible="{Binding HasDroppedFrames}" />
                <TextBlock Grid.Column="1"
                           Text="{Binding DroppedFrames}"
                           FontSize="11"
                           IsVisible="{Binding !HasDroppedFrames}" />
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="2" Spacing="3" Margin="0,0,0,8" IsVisible="{Binding HasActiveOperations}">
            <TextBlock Text="{loc:Translate diagnostics.work_in_progress}" FontWeight="SemiBold" FontSize="11" />
            <ItemsControl Name="ActiveOperationsList" ItemsSource="{Binding ActiveOperations}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontSize="11" Opacity="0.85" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <Grid Grid.Row="3" RowDefinitions="Auto,Auto,*">
            <TextBlock Grid.Row="0" Text="{loc:Translate diagnostics.git_commands}" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4" />

            <Grid Grid.Row="1" ColumnDefinitions="*,60,80,80,80,60" Margin="4,0,4,3">
                <TextBlock Grid.Column="0" Text="{loc:Translate diagnostics.command}" FontWeight="SemiBold" FontSize="11" />
                <TextBlock Grid.Column="1" Text="{loc:Translate diagnostics.count}" FontWeight="SemiBold" FontSize="11" />
                <TextBlock Grid.Column="2" Text="{loc:Translate diagnostics.total}" FontWeight="SemiBold" FontSize="11" />
                <TextBlock Grid.Column="3" Text="{loc:Translate diagnostics.average}" FontWeight="SemiBold" FontSize="11" />
                <TextBlock Grid.Column="4" Text="{loc:Translate diagnostics.longest}" FontWeight="SemiBold" FontSize="11" />
                <TextBlock Grid.Column="5" Text="{loc:Translate diagnostics.error}" FontWeight="SemiBold" FontSize="11" />
            </Grid>

            <ListBox Name="CommandList" Grid.Row="2" ItemsSource="{Binding Commands}">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="vm:CommandStatisticsRowViewModel">
                        <Grid ColumnDefinitions="*,60,80,80,80,60">
                            <TextBlock Grid.Column="0"
                                       Text="{Binding Name}"
                                       FontFamily="{DynamicResource GitExtMonospaceFont}"
                                       FontSize="11"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Count}" FontSize="11" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding Total}" FontSize="11" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="{Binding Average}" FontSize="11" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="4" Text="{Binding Max}" FontSize="11" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="5"
                                       Text="{Binding FailureCount}"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"
                                       IsVisible="{Binding HasFailures}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Name="EmptyText"
                       Grid.Row="2"
                       Text="{loc:Translate diagnostics.no_git_commands_have_run_yet}"
                       FontSize="11"
                       Opacity="0.7"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       IsVisible="{Binding IsEmpty}" />
        </Grid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Name="RefreshButton" Content="{loc:Translate diagnostics.refresh}" Command="{Binding RefreshCommand}" />
            <Button Name="ResetButton" Content="{loc:Translate diagnostics.reset_counters}" Command="{Binding ResetCommand}" />
        </StackPanel>
    </Grid>
</Window>
