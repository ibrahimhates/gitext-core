<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GitExt.UI.ViewModels"
        x:Class="GitExt.UI.Views.CommandLogWindow"
        x:DataType="vm:CommandLogViewModel"
        Title="Git komut günlüğü"
        Width="880"
        Height="520"
        WindowStartupLocation="CenterOwner">

    <!--
        P06-T16. GitExtensions'ta karşılığı "Git command log" penceresi. Sütunlar:
        saat · komut · süre · çıkış kodu. Altta seçili komutun ayrıntısı (stderr).

        Planın maddesi: "Kullanıcı ne olduğunu her zaman görebilmeli."
    -->
    <Grid RowDefinitions="Auto,*,Auto,140" Margin="10">

        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,6">
            <CheckBox Name="OnlyFailuresBox"
                      Grid.Column="0"
                      Content="Yalnızca başarısızlar"
                      IsChecked="{Binding OnlyFailures}" />
            <TextBlock Name="FailureCountText"
                       Grid.Column="1"
                       VerticalAlignment="Center"
                       Margin="10,0"
                       FontSize="11"
                       Opacity="0.8"
                       Text="{Binding FailureCount, StringFormat='{}{0} başarısız komut'}" />
            <Button Name="ClearButton"
                    Grid.Column="2"
                    Content="Temizle"
                    Command="{Binding ClearCommand}" />
        </Grid>

        <Grid Grid.Row="1" RowDefinitions="Auto,*">
            <Grid Grid.Row="0" ColumnDefinitions="70,*,80,60" Margin="4,0,4,3">
                <TextBlock Grid.Column="0" Text="Saat" FontWeight="SemiBold" FontSize="11" />
                <TextBlock Grid.Column="1" Text="Komut" FontWeight="SemiBold" FontSize="11" />
                <TextBlock Grid.Column="2" Text="Süre" FontWeight="SemiBold" FontSize="11" />
                <TextBlock Grid.Column="3" Text="Çıkış" FontWeight="SemiBold" FontSize="11" />
            </Grid>

            <ListBox Name="LogList"
                     Grid.Row="1"
                     ItemsSource="{Binding Rows}"
                     SelectedItem="{Binding Selected}">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="vm:CommandLogRowViewModel">
                        <Grid ColumnDefinitions="70,*,80,60">
                            <TextBlock Grid.Column="0"
                                       Text="{Binding Time}"
                                       FontSize="11"
                                       Opacity="0.75"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding CommandLine}"
                                       FontFamily="{DynamicResource GitExtMonospaceFont}"
                                       FontSize="11"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2"
                                       Text="{Binding Duration}"
                                       FontSize="11"
                                       Opacity="0.75"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3"
                                       Text="{Binding ExitCode}"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"
                                       IsVisible="{Binding !IsSuccess}" />
                            <TextBlock Grid.Column="3"
                                       Text="{Binding ExitCode}"
                                       FontSize="11"
                                       Opacity="0.75"
                                       VerticalAlignment="Center"
                                       IsVisible="{Binding IsSuccess}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Name="EmptyText"
                       Grid.Row="1"
                       Text="Henüz komut çalıştırılmadı."
                       FontSize="11"
                       Opacity="0.7"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       IsVisible="{Binding IsEmpty}" />
        </Grid>

        <TextBlock Grid.Row="2"
                   Text="Seçili komutun çıktısı:"
                   FontSize="11"
                   Opacity="0.8"
                   Margin="0,8,0,3" />

        <TextBox Name="DetailsBox"
                 Grid.Row="3"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="NoWrap"
                 FontFamily="{DynamicResource GitExtMonospaceFont}"
                 FontSize="11"
                 Text="{Binding SelectedDetails}" />
    </Grid>
</Window>
