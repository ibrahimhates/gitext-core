<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GitExt.Desktop.App"
             RequestedThemeVariant="Light">

    <!--
        The LIGHT theme is the default — that is GitExtensions' visual identity and the target
        audience comes from there. Even when the system is in dark mode the default is light;
        "follow the system" is a deliberate choice, not the default.

        The value here is only for the **first frame**: `ThemeService.ApplyStored()` applies the
        user's saved preference at startup (P08-T08). Without a default written beforehand, the
        application would open with the system theme for the time it takes to read the setting
        and then visibly jump.
    -->

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://GitExt.UI/Themes/GitExtTheme.axaml" />
    </Application.Styles>

</Application>
