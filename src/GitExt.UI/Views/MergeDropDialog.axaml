<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:GitExt.UI.Localization"
        x:Class="GitExt.UI.Views.MergeDropDialog"
        Title="{loc:Translate merge_drop.confirm_merge}"
        Width="470"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <!--
        P06-T15. Confirmation is ALWAYS asked for: an accidental drag is a real risk, and an
        operation that silently rewrites history must not start from a single slip of the mouse.
        The drag threshold (6 pixels) is the first line of defence, this screen the second.
    -->
    <StackPanel Margin="16" Spacing="10">
        <TextBlock Name="QuestionText" TextWrapping="Wrap" />

        <StackPanel Spacing="3">
            <TextBlock Text="{loc:Translate merge_drop.command_to_run}" FontSize="11" Opacity="0.8" />
            <TextBox Name="CommandBox"
                     IsReadOnly="True"
                     IsTabStop="False"
                     FontFamily="{DynamicResource GitExtMonospaceFont}"
                     FontSize="11" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Name="CancelButton" Content="{loc:Translate merge_drop.cancel}" MinWidth="90" IsCancel="True" Click="OnCancelClick" />
            <Button Name="ConfirmButton"
                    Content="{loc:Translate merge_drop.merge}"
                    MinWidth="110"
                    IsDefault="True"
                    Click="OnConfirmClick" />
        </StackPanel>
    </StackPanel>
</Window>
