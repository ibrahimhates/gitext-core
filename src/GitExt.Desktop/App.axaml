<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GitExt.Desktop.App"
             RequestedThemeVariant="Light">

    <!--
        Varsayılan AÇIK tema — GitExtensions'ın görsel kimliği bu ve hedef kitle oradan geliyor.
        Sistem koyu temada olsa bile varsayılan açıktır; "sistemi takip et" bilinçli bir
        tercihtir, varsayılan değil.

        Buradaki değer yalnızca **ilk kare** için: `ThemeService.ApplyStored()` açılışta
        kullanıcının kaydettiği tercihi uyguluyor (P08-T08). Öncesinde bir varsayılan
        yazılmasaydı, ayar okunana kadar geçen sürede uygulama sistem temasıyla açılıp
        gözle görülür biçimde zıplardı.
    -->

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://GitExt.UI/Themes/GitExtTheme.axaml" />
    </Application.Styles>

</Application>
