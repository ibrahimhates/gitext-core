<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:GitExt.UI.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:GitExt.UI.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="700" d:DesignHeight="400"
             x:Class="GitExt.UI.Views.GitOutputView"
             x:DataType="vm:GitOutputViewModel">

    <!--
        P05-T07 — the FULL output of the git command.

        The output is MONOSPACE: hooks print column-aligned tables and code fragments (linter
        output being the most common example). This was measured in P04-T13 — with a
        proportional font the alignment breaks.
        ⚠️ The font choice cannot be verified in a headless test (all family names fall back to
        one face); it has to be checked in a real window.
    -->

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*">

        <TextBlock Grid.Row="0"
                   Text="{Binding Summary}"
                   TextWrapping="Wrap"
                   FontWeight="SemiBold"
                   Margin="0,0,0,6" />

        <SelectableTextBlock Grid.Row="1"
                             Text="{Binding CommandLine}"
                             IsVisible="{Binding HasCommandLine}"
                             FontFamily="{DynamicResource GitExtMonospaceFont}"
                             FontSize="11"
                             Opacity="0.75"
                             TextWrapping="Wrap"
                             Margin="0,0,0,4" />

        <TextBlock Grid.Row="2"
                   Text="{Binding ExitCodeText}"
                   IsVisible="{Binding HasExitCode}"
                   FontSize="11"
                   Opacity="0.75"
                   Margin="0,0,0,6" />

        <TextBlock Grid.Row="3"
                   Text="{Binding TruncationNotice}"
                   IsVisible="{Binding HasTruncationNotice}"
                   Foreground="{DynamicResource SystemFillColorCautionBrush}"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Margin="0,0,0,6" />

        <!--
            When a hook has changed the message, the message that ACTUALLY WENT INTO the commit is
            shown. If the text the user wrote differs from the text that was recorded, they would
            only notice it by opening `git log`.
        -->
        <StackPanel Grid.Row="4"
                    IsVisible="{Binding HasFinalMessage}"
                    Margin="0,0,0,8">

            <TextBlock Text="{loc:Translate git_output.saved_message}"
                       FontSize="11"
                       Opacity="0.75"
                       Margin="0,0,0,3" />

            <Border BorderThickness="1"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">

                <SelectableTextBlock Name="FinalMessageText"
                                     Text="{Binding FinalMessage}"
                                     FontFamily="{DynamicResource GitExtMonospaceFont}"
                                     FontSize="12"
                                     Padding="8"
                                     TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <Border Grid.Row="5"
                IsVisible="{Binding HasOutput}"
                BorderThickness="1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">

            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">

                <!--
                    Selectable: the first thing a user does is copy the hook output and search for
                    it. A read-only TextBlock would make that impossible.
                -->
                <SelectableTextBlock Name="OutputText"
                                     Text="{Binding Output}"
                                     FontFamily="{DynamicResource GitExtMonospaceFont}"
                                     FontSize="12"
                                     Padding="8"
                                     TextWrapping="NoWrap" />
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
