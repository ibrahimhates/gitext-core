<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        The application's single theme entry point (P08-T07). `App.axaml` adds only this; which
        dictionaries load in which order lives here, in one place.
    -->

    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://GitExt.UI/Themes/Palette.axaml" />
                <ResourceInclude Source="avares://GitExt.UI/Themes/Typography.axaml" />
                <ResourceInclude Source="avares://GitExt.UI/Themes/Icons.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Styles.Resources>

    <StyleInclude Source="avares://GitExt.UI/Styles/RefBadgeStyles.axaml" />

    <!--
        Focus indicator (P08-T05). The focused panel's border is highlighted.

        🔴 Without an indicator, keyboard navigation is useless: the user cannot see where their
        keystrokes are going and cannot tell whether pressing `F6` did anything.

        `:focus-within` is used, not `:focus` — measured in P08-T00/M09, focus is almost always
        on an element INSIDE the panel (a `ListBoxItem`, a `TextBox`); the panel itself never
        takes focus.
    -->
    <Style Selector="Border.panel">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style Selector="Border.panel:focus-within">
        <Setter Property="BorderBrush" Value="{DynamicResource GitExtAccentBrush}" />
    </Style>

    <!--
        Toolbars (P12-T06/T07). GitExtensions' `ToolStrip` is a thin strip of flat buttons that
        only take on a background under the pointer; a row of framed buttons would turn the top of
        the window into a wall. The 22×22 icon and the 25 px strip are its measurements.
    -->
    <Style Selector="Border.toolbar">
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="BorderBrush" Value="{DynamicResource GitExtSeparatorBrush}" />
    </Style>

    <Style Selector="Border.toolbar Button.tool, Border.toolbar SplitButton.tool, Border.toolbar DropDownButton.tool">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="5,3" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.toolbar Button.toolText, Border.toolbar SplitButton.toolText, Border.toolbar DropDownButton.toolText">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="7,3" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.toolbar PathIcon">
        <Setter Property="Width" Value="15" />
        <Setter Property="Height" Value="15" />
    </Style>

    <!-- A disabled toolbar button stays IN PLACE; it is dimmed, not removed. -->
    <Style Selector="Border.toolbar Button:disabled, Border.toolbar SplitButton:disabled, Border.toolbar DropDownButton:disabled">
        <Setter Property="Opacity" Value="0.4" />
    </Style>

    <!-- `toolStripSeparator`: a hairline between the groups. -->
    <Style Selector="Border.toolSeparator">
        <Setter Property="Width" Value="1" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Margin" Value="4,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource GitExtSeparatorBrush}" />
    </Style>
</Styles>
