<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:GitExt.UI.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="120" d:DesignHeight="30"
             x:Class="GitExt.UI.Views.GitErrorDetailsButton">

    <!--
        P05-T07 — the "Details" next to the error strip.

        A separate control, because the same error is shown in TWO different places: the strip in
        `CommitListView` when a repository is open, and the box in `WelcomeView` when no
        repository could be opened at all. The second is the **most frequent** error path ("this
        folder is not a Git repository") — putting the button on only one of them meant the user
        could not see git's actual output at exactly the moment they needed it most.

        The strip looks deliberately different in the two places (one a box, one a line); what is
        shared is the **behaviour**, so only the button is common.
    -->

    <Button Name="DetailsButton"
            Content="{loc:Translate git_error_details.details}"
            FontSize="11"
            Padding="8,2"
            Click="OnClick" />
</UserControl>
