<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:GitExt.UI.Localization"
        x:Class="GitExt.UI.Views.DeleteBranchDialog"
        Title="{loc:Translate delete_branch.delete_branch}"
        Width="520"
        SizeToContent="Height"
        MinHeight="180"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <!--
        Yerleşim GitExtensions `FormDeleteBranch`'ten (§ 9): dal listesi + "Delete" düğmesi.
        Eklenen: birleştirilmemiş dalda KURTARMA KOMUTU. GitExtensions yalnızca
        "not been merged into HEAD. Proceed?" diye soruyor; ölçüm gösterdi ki silme sonrası
        dalın kendi reflog'u da gidiyor, dolayısıyla kullanıcıya geri dönüş yolunu
        vermezsek gerçekten kaybedebilir.
    -->
    <StackPanel Margin="16" Spacing="10">

        <TextBlock Name="MessageText" TextWrapping="Wrap" FontWeight="SemiBold" />

        <StackPanel Name="UnmergedPanel" Spacing="8" IsVisible="False">
            <TextBlock Name="UnmergedText"
                       TextWrapping="Wrap"
                       Text="{loc:Translate delete_branch.this_branch_contains_commits_that_are_not_me}" />

            <StackPanel Spacing="3">
                <TextBlock Text="{loc:Translate delete_branch.to_restore_it}" FontSize="11" Opacity="0.85" />
                <TextBox Name="RecoveryCommand"
                         IsReadOnly="True"
                         FontFamily="{DynamicResource GitExtMonospaceFont}"
                         FontSize="11" />
                <TextBlock Name="RecoveryNote"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Opacity="0.75"
                           Text="{loc:Translate delete_branch.note_this_command_down_deleting_a_branch_als}" />
            </StackPanel>

            <CheckBox Name="ForceBox" Content="{loc:Translate delete_branch.delete_even_though_it_is_not_merged}" />
        </StackPanel>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8">
            <Button Name="CancelButton" Content="{loc:Translate delete_branch.cancel}" MinWidth="90" IsCancel="True" Click="OnCancelClick" />
            <Button Name="DeleteButton" Content="{loc:Translate delete_branch.delete}" MinWidth="90" IsDefault="True" Click="OnDeleteClick" />
        </StackPanel>
    </StackPanel>
</Window>
