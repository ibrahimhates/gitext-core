<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:GitExt.UI.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:GitExt.UI.ViewModels"
        xmlns:views="using:GitExt.UI.Views"
        mc:Ignorable="d"
        d:DesignWidth="1000" d:DesignHeight="600"
        x:Class="GitExt.UI.Views.CompareWindow"
        x:DataType="vm:CompareViewModel"
        Title="{Binding Title}"
        Width="1000" Height="600"
        MinWidth="600" MinHeight="360"
        WindowStartupLocation="CenterOwner">

    <!--
        The comparison window is MODELESS and more than one can be open at a time; that was the
        user's real need — a single embedded panel made it impossible to put two changes side by
        side. In GitExtensions too, `FormDiff` is opened with `Show()`.

        The content is `DiffView`: it was deliberately written standalone in P04-T08, and is not
        written a second time.
    -->

    <Grid RowDefinitions="Auto,*">

        <Border Grid.Row="0"
                Padding="10,7"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">

            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding FromRevision}"
                               FontFamily="{DynamicResource GitExtMonospaceFont}"
                               FontSize="12"
                               VerticalAlignment="Center" />

                    <TextBlock Text="↔" FontSize="12" Opacity="0.6" VerticalAlignment="Center" />

                    <TextBlock Text="{Binding ToRevision}"
                               IsVisible="{Binding ToRevision, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               FontFamily="{DynamicResource GitExtMonospaceFont}"
                               FontSize="12"
                               VerticalAlignment="Center" />

                    <!-- In a working tree comparison the right-hand side is not a revision. -->
                    <TextBlock Text="{loc:Translate compare.working_tree}"
                               IsVisible="{Binding !!!ToRevision.Length}"
                               FontSize="12"
                               Opacity="0.75"
                               VerticalAlignment="Center" />
                </StackPanel>

                <Button Grid.Column="1"
                        Name="RefreshButton"
                        Content="{loc:Translate compare.refresh}"
                        FontSize="11"
                        Padding="8,2"
                        ToolTip.Tip="{loc:Translate compare.reload_the_comparison_f5}" />
            </Grid>
        </Border>

        <views:DiffView Grid.Row="1" DataContext="{Binding Diff}" />
    </Grid>
</Window>
