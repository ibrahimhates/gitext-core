<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Colour-blind safe diff colours (P08-T09).

        This dictionary is layered ON TOP of the default palette; it changes only the keys that
        rely on a red/green distinction. The rest stay as they are — redefining all of them
        meant one being forgotten and silently diverging between the two palettes.

        The distinction is BLUE/ORANGE instead of red/green: under deuteranopia and protanopia
        red and green look the same, blue and orange stay apart. Colour does not carry it alone
        either — an added/removed line already has its `+`/`-` prefix (P04).
    -->

    <ResourceDictionary.ThemeDictionaries>

        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="GitExtSuccessBrush" Color="#0B5FBF" />
            <SolidColorBrush x:Key="GitExtDangerBrush" Color="#B35C00" />

            <SolidColorBrush x:Key="GitExtDiffAddedBackgroundBrush" Color="#DDEBFF" />
            <SolidColorBrush x:Key="GitExtDiffRemovedBackgroundBrush" Color="#FFEBD6" />
            <SolidColorBrush x:Key="GitExtDiffAddedForegroundBrush" Color="#0B5FBF" />
            <SolidColorBrush x:Key="GitExtDiffRemovedForegroundBrush" Color="#B35C00" />
            <SolidColorBrush x:Key="GitExtDiffAddedWordBrush" Color="#B8D4FF" />
            <SolidColorBrush x:Key="GitExtDiffRemovedWordBrush" Color="#FFD4A8" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="GitExtSuccessBrush" Color="#6CB6FF" />
            <SolidColorBrush x:Key="GitExtDangerBrush" Color="#E3A857" />

            <SolidColorBrush x:Key="GitExtDiffAddedBackgroundBrush" Color="#10233C" />
            <SolidColorBrush x:Key="GitExtDiffRemovedBackgroundBrush" Color="#33230F" />
            <SolidColorBrush x:Key="GitExtDiffAddedForegroundBrush" Color="#6CB6FF" />
            <SolidColorBrush x:Key="GitExtDiffRemovedForegroundBrush" Color="#E3A857" />
            <SolidColorBrush x:Key="GitExtDiffAddedWordBrush" Color="#1E3C63" />
            <SolidColorBrush x:Key="GitExtDiffRemovedWordBrush" Color="#58411A" />
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
