<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:GitExt.UI.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:GitExt.UI.ViewModels"
        xmlns:views="using:GitExt.UI.Views"
        mc:Ignorable="d"
        d:DesignWidth="1000" d:DesignHeight="600"
        x:Class="GitExt.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding WindowTitle}"
        Width="1000" Height="600"
        MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        DragDrop.AllowDrop="True">

    <Grid RowDefinitions="Auto,Auto,Auto,*">

        <!--
            MAIN MENU — the order and item names were taken from GitExtensions (P08-T26):
            Start · Dashboard · Repository · Commands · Tools · Help.
            (We have no Plugins and no "Repository hosts".)

            ⚠️ Commands that are not implemented yet are NOT REMOVED, they stay in place with
            `IsEnabled="False"`. The user's rule: someone used to GitExtensions must find the same
            item in the same place; slotting one in later breaks the order.
        -->
        <Menu Grid.Row="0" Name="MainMenu">

            <MenuItem Header="{loc:Translate main.start}">
                <MenuItem Name="MenuCreateRepository" Header="{loc:Translate main.create_new_repository}" IsEnabled="False" />
                <MenuItem Name="MenuOpen" Header="{loc:Translate main.open}" />
                <MenuItem Name="MenuClone" Header="{loc:Translate main.c_lone_repository}" IsEnabled="False" />
                <Separator />
                <MenuItem Name="MenuRecentRepositories"
                          Header="{loc:Translate main.recent_repositories}"
                          ItemsSource="{Binding RecentRepositories}">
                    <MenuItem.ItemTemplate>
                        <DataTemplate DataType="vm:RecentRepositoryItem">
                            <TextBlock Text="{Binding Path}" />
                        </DataTemplate>
                    </MenuItem.ItemTemplate>
                    <MenuItem.Styles>
                        <Style Selector="MenuItem > MenuItem" x:DataType="vm:RecentRepositoryItem">
                            <Setter Property="Command" Value="{Binding OpenCommand}" />
                            <Setter Property="CommandParameter" Value="{Binding Path}" />
                        </Style>
                    </MenuItem.Styles>
                </MenuItem>
                <Separator />
                <MenuItem Name="MenuExit" Header="{loc:Translate main.e_xit}" />
            </MenuItem>

            <MenuItem Header="{loc:Translate main.dashboard}">
                <MenuItem Name="MenuDashboardRefresh"
                          Header="{loc:Translate main.refresh}"
                          Command="{Binding RefreshCommand}" />
            </MenuItem>

            <MenuItem Header="{loc:Translate main.repository}" IsEnabled="{Binding HasRepository}">
                <!--
                    🔴 The `InputGesture="F5"` that was here has been REMOVED. Measured in
                    P08-T00/M03: `InputGesture` does not run the command, it only draws the label —
                    so F5 was a dead key. Both the label and the real binding now come from the
                    command registry (GlobalShortcuts).
                -->
                <MenuItem Name="MenuRepositoryRefresh" Header="{loc:Translate main.refresh}" />
                <MenuItem Name="MenuFileExplorer" Header="{loc:Translate main.file_explorer}" IsEnabled="False" />
                <Separator />
                <MenuItem Name="MenuRemotes" Header="{loc:Translate main.remotes}" />
                <Separator />
                <MenuItem Name="MenuSubmodules" Header="{loc:Translate main.ma_nage_submodules}" IsEnabled="False" />
                <MenuItem Name="MenuWorktrees" Header="{loc:Translate main.manage_worktrees}" IsEnabled="False" />
                <Separator />
                <MenuItem Name="MenuEditGitignore" Header="{loc:Translate main.edit_git_ignore}" IsEnabled="False" />
                <MenuItem Name="MenuRepositorySettings" Header="{loc:Translate main.repository_setti_ngs}" IsEnabled="False" />
                <Separator />
                <MenuItem Name="MenuCloseRepository" Header="{loc:Translate main.close_back_to_dashboard}" />
            </MenuItem>

            <MenuItem Header="{loc:Translate main.commands}" IsEnabled="{Binding HasRepository}">
                <!-- Faz 05 -->
                <MenuItem Name="MenuCommit" Header="{loc:Translate main.commit}" />
                <MenuItem Name="MenuUndoLastCommit" Header="{loc:Translate main.undo_last_commit}" IsEnabled="False" />
                <!-- Faz 06 -->
                <MenuItem Name="MenuPull" Header="{loc:Translate main.pull_fetch}" />
                <MenuItem Name="MenuPush" Header="{loc:Translate main.push}" />
                <Separator />
                <MenuItem Name="MenuStashes" Header="{loc:Translate main.ma_nage_stashes}" />
                <MenuItem Name="MenuResetChanges" Header="{loc:Translate main.reset_changes}" IsEnabled="False" />
                <Separator />
                <MenuItem Name="MenuCreateBranch" Header="{loc:Translate main.create_branch}" />
                <MenuItem Name="MenuDeleteBranch" Header="{loc:Translate main.de_lete_branch}" />
                <MenuItem Name="MenuCheckoutBranch" Header="{loc:Translate main.chec_k_out_branch}" />
                <MenuItem Name="MenuMerge" Header="{loc:Translate main.merge_branches}" />
                <MenuItem Name="MenuRebase" Header="{loc:Translate main.r_ebase}" />
                <Separator />
                <MenuItem Name="MenuCreateTag" Header="{loc:Translate main.crea_te_tag}" IsEnabled="False" />
                <MenuItem Name="MenuDeleteTag" Header="{loc:Translate main.de_lete_tag}" IsEnabled="False" />
                <Separator />
                <!-- Faz 07 -->
                <MenuItem Name="MenuCherryPick" Header="{loc:Translate main.cherr_y_pick}" />
                <MenuItem Name="MenuCheckoutRevision" Header="{loc:Translate main.check_out_revision}" IsEnabled="False" />
                <MenuItem Name="MenuRevert" Header="{loc:Translate main.re_vert_commit}" />
                <MenuItem Name="MenuResetToCommit" Header="{loc:Translate main.re_set_to_this_commit}" />
                <MenuItem Name="MenuBisect" Header="{loc:Translate main.b_isect}" IsEnabled="False" />
                <MenuItem Name="MenuReflog" Header="{loc:Translate main.show_reflo_g}" />
            </MenuItem>

            <MenuItem Header="{loc:Translate main.tools}">
                <MenuItem Name="MenuCommandLog" Header="{loc:Translate main.git_command_log}" />
                <Separator />
                <MenuItem Name="MenuSettings" Header="{loc:Translate main.setti_ngs}" IsEnabled="False" />
            </MenuItem>

            <MenuItem Header="{loc:Translate main.help}">
                <MenuItem Name="MenuAbout" Header="{loc:Translate main.about}" />
            </MenuItem>
        </Menu>

        <!--
            ==================================================================================
            MAIN TOOLBAR (`ToolStripMain`) — P12-T06
            ==================================================================================

            The order is GitExtensions' own (`FormBrowse.Designer.cs`, `ToolStripMain.Items`):

                Refresh · ─ · toggle left panel · toggle split view · commit info position · ─ ·
                submodules · [worktrees] · working dir · branch · ─ ·
                pull · push · commit · stash · ─ · file explorer · terminal · settings

            ⚠️ Commands that are not implemented yet are NOT REMOVED, they are disabled in
            place — the same rule as the menus. Worktrees is not here at all, because
            GitExtensions hides it too (`toolStripWorktrees.Visible = false`).

            🔴 The strip that used to be here ("path — N commits") is gone: it repeated what the
            title bar and this toolbar already say. The loading indicator it carried moved to the
            right-hand end of this row, where it stays visible.
        -->
        <Border Grid.Row="1" Name="MainToolbar" Classes="toolbar">
            <Grid ColumnDefinitions="*,Auto">

                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" Spacing="1" VerticalAlignment="Center">

                        <Button Name="ToolRefresh" Classes="tool" Command="{Binding RefreshCommand}">
                            <PathIcon Data="{StaticResource IconRefresh}" />
                        </Button>

                        <Border Classes="toolSeparator" />

                        <Button Name="ToolToggleLeftPanel" Classes="tool">
                            <PathIcon Data="{StaticResource IconLayoutSidebarLeft}" />
                        </Button>

                        <Button Name="ToolToggleBottomPanel" Classes="tool">
                            <PathIcon Data="{StaticResource IconLayoutFooter}" />
                        </Button>

                        <DropDownButton Name="ToolCommitInfoPosition"
                                        Classes="tool"
                                        IsEnabled="False"
                                        ToolTip.Tip="{loc:Translate toolbar.commit_info_position}">
                            <PathIcon Data="{StaticResource IconLayoutFooterTab}" />
                            <DropDownButton.Flyout>
                                <MenuFlyout>
                                    <MenuItem Name="CommitInfoBelow" Header="{loc:Translate toolbar.commit_info_below_graph}" />
                                    <MenuItem Name="CommitInfoLeft" Header="{loc:Translate toolbar.commit_info_left_of_graph}" IsEnabled="False" />
                                    <MenuItem Name="CommitInfoRight" Header="{loc:Translate toolbar.commit_info_right_of_graph}" IsEnabled="False" />
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>

                        <Border Classes="toolSeparator" />

                        <Button Name="ToolSubmodules"
                                Classes="tool"
                                IsEnabled="False"
                                ToolTip.Tip="{loc:Translate toolbar.submodules}">
                            <PathIcon Data="{StaticResource IconSubmodules}" />
                        </Button>

                        <!-- `_NO_TRANSLATE_WorkingDir`: the repository's name, with the recent list behind it. -->
                        <DropDownButton Name="ToolWorkingDir"
                                        Classes="toolText"
                                        Content="{Binding RepositoryLabel}"
                                        IsVisible="{Binding HasRepository}">
                            <DropDownButton.Flyout>
                                <MenuFlyout ItemsSource="{Binding RecentRepositories}">
                                    <MenuFlyout.ItemTemplate>
                                        <DataTemplate DataType="vm:RecentRepositoryItem">
                                            <TextBlock Text="{Binding Path}" />
                                        </DataTemplate>
                                    </MenuFlyout.ItemTemplate>
                                    <MenuFlyout.ItemContainerTheme>
                                        <ControlTheme TargetType="MenuItem"
                                                      BasedOn="{StaticResource {x:Type MenuItem}}"
                                                      x:DataType="vm:RecentRepositoryItem">
                                            <Setter Property="Command" Value="{Binding OpenCommand}" />
                                            <Setter Property="CommandParameter" Value="{Binding Path}" />
                                        </ControlTheme>
                                    </MenuFlyout.ItemContainerTheme>
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>

                        <!-- `branchSelect`: the current branch; the dropdown switches to another. -->
                        <SplitButton Name="ToolBranchSelect"
                                     Classes="toolText"
                                     Command="{Binding CheckoutCommand}"
                                     IsVisible="{Binding HasRepository}"
                                     ToolTip.Tip="{loc:Translate toolbar.change_current_branch}">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <PathIcon Data="{StaticResource IconBranch}" />
                                <TextBlock Name="ToolBranchName" Text="{Binding CurrentBranchLabel}" />
                            </StackPanel>
                            <SplitButton.Flyout>
                                <MenuFlyout ItemsSource="{Binding Branches}">
                                    <MenuFlyout.ItemTemplate>
                                        <DataTemplate DataType="vm:ToolbarBranchItem">
                                            <TextBlock Text="{Binding Name}" FontWeight="{Binding IsCurrent, Converter={x:Static vm:BoldWhenTrue.Instance}}" />
                                        </DataTemplate>
                                    </MenuFlyout.ItemTemplate>
                                    <MenuFlyout.ItemContainerTheme>
                                        <ControlTheme TargetType="MenuItem"
                                                      BasedOn="{StaticResource {x:Type MenuItem}}"
                                                      x:DataType="vm:ToolbarBranchItem">
                                            <Setter Property="Command" Value="{Binding CheckoutCommand}" />
                                            <Setter Property="CommandParameter" Value="{Binding Name}" />
                                            <Setter Property="IsEnabled" Value="{Binding CanCheckout}" />
                                        </ControlTheme>
                                    </MenuFlyout.ItemContainerTheme>
                                </MenuFlyout>
                            </SplitButton.Flyout>
                        </SplitButton>

                        <Border Classes="toolSeparator" />

                        <SplitButton Name="ToolPull" Classes="tool" Command="{Binding PullCommand}">
                            <PathIcon Data="{StaticResource IconPull}" />
                            <SplitButton.Flyout>
                                <MenuFlyout>
                                    <MenuItem Name="PullOpenDialog"
                                              Header="{loc:Translate toolbar.open_pull_dialog}"
                                              Command="{Binding PullCommand}" />
                                    <Separator />
                                    <MenuItem Name="PullMerge" Header="{loc:Translate toolbar.pull_merge}" IsEnabled="False" />
                                    <MenuItem Name="PullRebase" Header="{loc:Translate toolbar.pull_rebase}" IsEnabled="False" />
                                    <MenuItem Name="PullFetch" Header="{loc:Translate toolbar.fetch}" IsEnabled="False" />
                                    <MenuItem Name="PullFetchAll" Header="{loc:Translate toolbar.fetch_all}" IsEnabled="False" />
                                    <MenuItem Name="PullFetchPruneAll" Header="{loc:Translate toolbar.fetch_and_prune_all}" IsEnabled="False" />
                                </MenuFlyout>
                            </SplitButton.Flyout>
                        </SplitButton>

                        <Button Name="ToolPush" Classes="tool" Command="{Binding PushCommand}">
                            <PathIcon Data="{StaticResource IconPush}" />
                        </Button>

                        <!-- The one button GitExtensions gives a label to; it is the most used. -->
                        <Button Name="ToolCommit" Classes="toolText">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <PathIcon Data="{StaticResource IconCommit}" />
                                <TextBlock Text="{loc:Translate toolbar.commit}" />
                            </StackPanel>
                        </Button>

                        <SplitButton Name="ToolStash" Classes="tool" Command="{Binding ShowStashCommand}">
                            <PathIcon Data="{StaticResource IconStash}" />
                            <SplitButton.Flyout>
                                <MenuFlyout>
                                    <MenuItem Name="StashChanges" Header="{loc:Translate toolbar.stash}" IsEnabled="False" />
                                    <MenuItem Name="StashStaged" Header="{loc:Translate toolbar.stash_staged}" IsEnabled="False" />
                                    <MenuItem Name="StashPop" Header="{loc:Translate toolbar.stash_pop}" IsEnabled="False" />
                                    <Separator />
                                    <MenuItem Name="StashManage"
                                              Header="{loc:Translate toolbar.manage_stashes}"
                                              Command="{Binding ShowStashCommand}" />
                                    <MenuItem Name="StashCreate" Header="{loc:Translate toolbar.create_a_stash}" IsEnabled="False" />
                                </MenuFlyout>
                            </SplitButton.Flyout>
                        </SplitButton>

                        <Border Classes="toolSeparator" />

                        <Button Name="ToolFileExplorer"
                                Classes="tool"
                                IsEnabled="{Binding HasRepository}"
                                ToolTip.Tip="{loc:Translate toolbar.file_explorer}"
                                Click="OnFileExplorerClick">
                            <PathIcon Data="{StaticResource IconRepositoryOpen}" />
                        </Button>

                        <Button Name="ToolTerminal"
                                Classes="tool"
                                IsEnabled="False"
                                ToolTip.Tip="{loc:Translate toolbar.terminal}">
                            <PathIcon Data="{StaticResource IconTerminal}" />
                        </Button>

                        <Button Name="ToolSettings" Classes="tool">
                            <PathIcon Data="{StaticResource IconSettings}" />
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <!--
                    Loading indicator and cancel (P03-T17). In a very large repository the user
                    may realise they opened the wrong folder; they must not have to wait for it
                    to finish.
                -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="6"
                            VerticalAlignment="Center"
                            IsVisible="{Binding Commits.IsLoading}">
                    <TextBlock Text="{Binding Commits.LoadedCountText}"
                               FontSize="12"
                               Opacity="0.7"
                               VerticalAlignment="Center" />
                    <Button Content="{loc:Translate main.cancel}"
                            Command="{Binding CancelLoadingCommand}"
                            FontSize="11"
                            Padding="8,2" />
                </StackPanel>
            </Grid>
        </Border>

        <!--
            ==================================================================================
            FILTER TOOLBAR (`ToolStripFilters`) — P12-T07
            ==================================================================================

            GitExtensions' order (`FilterToolBar.Designer.cs`, `Items.AddRange`):

                advanced filter · reflog · show branches · "Branches:" · branch combo ·
                branch type · ─ · "Filter:" · filter box · filter type · first parent

            The filtering is REAL: it is git that filters (`-grep` · `-committer` · `-author` ·
            `-G`), not us hiding rows that were read anyway. Two items are disabled — the reflog
            view and the advanced filter dialog do not exist yet.
        -->
        <Border Grid.Row="2" Name="FilterToolbar" Classes="toolbar" IsVisible="{Binding HasRepository}">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">

                    <!--
                        In GitExtensions the funnel's own click opens the advanced filter dialog,
                        which does not exist here. It is a plain dropdown rather than a split
                        button, so "Reset revision filters" stays reachable instead of being
                        locked behind a dead primary action.
                    -->
                    <DropDownButton Name="FilterAdvanced"
                                    Classes="tool"
                                    ToolTip.Tip="{loc:Translate toolbar.advanced_filter}">
                        <PathIcon Data="{StaticResource IconFilter}" />
                        <DropDownButton.Flyout>
                            <MenuFlyout>
                                <MenuItem Name="FilterResetPaths" Header="{loc:Translate toolbar.reset_path_filter}" IsEnabled="False" />
                                <MenuItem Name="FilterResetAll"
                                          Header="{loc:Translate toolbar.reset_revision_filters}"
                                          Command="{Binding Commits.ResetFiltersCommand}" />
                                <Separator />
                                <MenuItem Name="FilterAdvancedDialog" Header="{loc:Translate toolbar.advanced_filter}" IsEnabled="False" />
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>

                    <Button Name="FilterShowReflog"
                            Classes="tool"
                            IsEnabled="False"
                            ToolTip.Tip="{loc:Translate toolbar.show_reflog}">
                        <PathIcon Data="{StaticResource IconReflog}" />
                    </Button>

                    <DropDownButton Name="FilterShowBranches"
                                    Classes="toolText"
                                    Content="{Binding Commits.BranchModeLabel}">
                        <DropDownButton.Flyout>
                            <MenuFlyout>
                                <MenuItem Name="BranchesAll"
                                          Header="{loc:Translate toolbar.all_branches}"
                                          Command="{Binding Commits.SetBranchModeCommand}">
                                    <MenuItem.CommandParameter>
                                        <vm:BranchFilterMode>AllBranches</vm:BranchFilterMode>
                                    </MenuItem.CommandParameter>
                                </MenuItem>
                                <MenuItem Name="BranchesCurrent"
                                          Header="{loc:Translate toolbar.current_branch_only}"
                                          Command="{Binding Commits.SetBranchModeCommand}">
                                    <MenuItem.CommandParameter>
                                        <vm:BranchFilterMode>CurrentBranch</vm:BranchFilterMode>
                                    </MenuItem.CommandParameter>
                                </MenuItem>
                                <MenuItem Name="BranchesFiltered"
                                          Header="{loc:Translate toolbar.filtered_branches}"
                                          Command="{Binding Commits.SetBranchModeCommand}">
                                    <MenuItem.CommandParameter>
                                        <vm:BranchFilterMode>FilteredBranches</vm:BranchFilterMode>
                                    </MenuItem.CommandParameter>
                                </MenuItem>
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>

                    <TextBlock Text="{loc:Translate toolbar.branches_label}"
                               VerticalAlignment="Center"
                               Margin="6,0,2,0"
                               FontSize="12" />

                    <ComboBox Name="BranchFilterBox"
                              ItemsSource="{Binding Branches}"
                              DisplayMemberBinding="{Binding Name}"
                              SelectedItem="{Binding SelectedBranchFilter, Mode=TwoWay}"
                              MinWidth="150"
                              FontSize="12"
                              ToolTip.Tip="{loc:Translate toolbar.branch_filter}" />

                    <DropDownButton Name="BranchFilterType"
                                    Classes="tool"
                                    IsEnabled="False"
                                    ToolTip.Tip="{loc:Translate toolbar.branch_filter}">
                        <PathIcon Data="{StaticResource IconFilter}" />
                    </DropDownButton>

                    <Border Classes="toolSeparator" />

                    <TextBlock Text="{loc:Translate toolbar.filter_label}"
                               VerticalAlignment="Center"
                               Margin="6,0,2,0"
                               FontSize="12" />

                    <TextBox Name="RevisionFilterBox"
                             Text="{Binding Commits.FilterText, Mode=TwoWay}"
                             Width="190"
                             FontSize="12"
                             KeyDown="OnRevisionFilterKeyDown"
                             ToolTip.Tip="{loc:Translate toolbar.text_filter}" />

                    <DropDownButton Name="RevisionFilterType"
                                    Classes="toolText"
                                    Content="{Binding Commits.FilterKindLabel}"
                                    ToolTip.Tip="{loc:Translate toolbar.filter_type}">
                        <DropDownButton.Flyout>
                            <MenuFlyout>
                                <MenuItem Name="FilterByMessage"
                                          Header="{loc:Translate toolbar.commit_message}"
                                          Command="{Binding Commits.SetFilterKindCommand}">
                                    <MenuItem.CommandParameter>
                                        <vm:RevisionFilterKind>Message</vm:RevisionFilterKind>
                                    </MenuItem.CommandParameter>
                                </MenuItem>
                                <MenuItem Name="FilterByCommitter"
                                          Header="{loc:Translate toolbar.committer}"
                                          Command="{Binding Commits.SetFilterKindCommand}">
                                    <MenuItem.CommandParameter>
                                        <vm:RevisionFilterKind>Committer</vm:RevisionFilterKind>
                                    </MenuItem.CommandParameter>
                                </MenuItem>
                                <MenuItem Name="FilterByAuthor"
                                          Header="{loc:Translate toolbar.author}"
                                          Command="{Binding Commits.SetFilterKindCommand}">
                                    <MenuItem.CommandParameter>
                                        <vm:RevisionFilterKind>Author</vm:RevisionFilterKind>
                                    </MenuItem.CommandParameter>
                                </MenuItem>
                                <MenuItem Name="FilterByDiff"
                                          Header="{loc:Translate toolbar.diff_contains_slow}"
                                          Command="{Binding Commits.SetFilterKindCommand}">
                                    <MenuItem.CommandParameter>
                                        <vm:RevisionFilterKind>DiffContains</vm:RevisionFilterKind>
                                    </MenuItem.CommandParameter>
                                </MenuItem>
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>

                    <CheckBox Name="FilterFirstParent"
                              Content="{loc:Translate toolbar.show_only_first_parent}"
                              IsChecked="{Binding Commits.FirstParentOnly}"
                              FontSize="12"
                              Margin="6,0,0,0" />

                    <!--
                        🔴 A filter left on and forgotten is the classic way to conclude that a
                        commit "is gone". While one is active it is said so, in words.
                    -->
                    <TextBlock Name="FilterActiveNotice"
                               Text="{loc:Translate toolbar.filter_is_active}"
                               IsVisible="{Binding Commits.HasActiveFilter}"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"
                               FontSize="11"
                               Foreground="{DynamicResource GitExtAttentionBrush}" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!--
            The branch operation strip (P06-T01). A strip rather than a modal "OK" box — same
            reasoning as the reset strip in P05-T15: a dialog shown AFTER the operation is nothing
            but an obstacle waiting to be dismissed. Errors go here too; not raw stderr, but the
            classified message.
        -->
        <Border Grid.Row="3"
                Name="BranchNoticeBar"
                VerticalAlignment="Top"
                IsVisible="{Binding BranchNotice, Converter={x:Static ObjectConverters.IsNotNull}}"
                Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                BorderThickness="1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                CornerRadius="3"
                Padding="8,5"
                Margin="10,6"
                ZIndex="10">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           Name="BranchNoticeText"
                           Text="{Binding BranchNotice}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           FontSize="12" />

                <Button Grid.Column="1"
                        Name="DismissBranchNoticeButton"
                        Content="✕"
                        FontSize="12"
                        Margin="4,0,0,0"
                        Click="OnDismissBranchNoticeClick" />
            </Grid>
        </Border>

        <!--
            The detached HEAD and in-progress operation strips (P06-T04). The two are MUTUALLY
            EXCLUSIVE: it was measured that during a rebase or a bisect HEAD really is detached;
            showing both strips would tell the user "you are both detached and mid-rebase", and
            "create a branch here" is not the thing to do at that point.
        -->
        <Border Grid.Row="3"
                Name="DetachedBanner"
                VerticalAlignment="Top"
                IsVisible="{Binding ShowDetachedBanner}"
                Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                BorderThickness="1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                CornerRadius="3"
                Padding="8,5"
                Margin="10,6"
                ZIndex="9">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           Name="DetachedText"
                           Text="{loc:Translate main.detached_head_you_are_not_on_a_branch_commit}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           FontSize="12" />

                <Button Grid.Column="1"
                        Name="DetachedCreateBranchButton"
                        Content="{loc:Translate main.create_branch_from_here}"
                        FontSize="12"
                        Margin="8,0,0,0"
                        Command="{Binding CreateBranchCommand}" />
            </Grid>
        </Border>

        <Border Grid.Row="3"
                Name="OperationBanner"
                VerticalAlignment="Top"
                IsVisible="{Binding ShowOperationBanner}"
                Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                BorderThickness="1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                CornerRadius="3"
                Padding="8,5"
                Margin="10,6"
                ZIndex="9">
            <!--
                P07-T11: the way out of EVERY half-finished operation comes from the same strip.
                In P06-T12 only merge was offered, because aborting the others takes different
                commands. In Phase 07 IConflictResolver picks the right verb FROM THE STATE FILES,
                so rebase/cherry-pick/revert can be aborted from here as well.
                Bisect is left out: it has no abort, and its "reset" is a different thing entirely.
            -->
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock Name="OperationText"
                           Grid.Column="0"
                           Text="{Binding OperationText}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           FontSize="12" />
                <Button Name="ResolveConflictsButton"
                        Grid.Column="1"
                        Content="{loc:Translate main.resolve_conflicts}"
                        Margin="8,0,0,0"
                        IsVisible="{Binding CanResolveConflicts}"
                        Command="{Binding ResolveConflictsCommand}" />
                <Button Name="AbortOperationButton"
                        Grid.Column="2"
                        Content="{loc:Translate main.cancel_the_operation}"
                        Margin="8,0,0,0"
                        IsVisible="{Binding CanAbortOperation}"
                        Command="{Binding AbortOperationCommand}" />
            </Grid>
        </Border>

        <!-- With no repository open, the welcome screen; rather than an empty window, a way forward. -->
        <views:WelcomeView Grid.Row="3" IsVisible="{Binding ShowWelcome}" />

        <!--
            List on top, details below — GitExtensions' layout. The splitter is draggable; with a
            fixed-height details panel, long commit messages would be unreadable.
        -->
        <!--
            P06-T13: the branch panel is on the LEFT with a draggable splitter — the same place as
            GitExtensions' RepoObjectsTree (§ 9).
        -->
        <!--
            GitExtensions' content panel has 6 px of padding around the splitters
            (`toolPanel.ContentPanel.Padding`), so the panels do not sit flush against the window
            frame. The dashboard is deliberately left flush: its own coloured panels run to the
            edge there too.
        -->
        <Grid Grid.Row="3"
              Name="MainSplitGrid"
              ColumnDefinitions="220,4,*"
              Margin="6"
              IsVisible="{Binding !ShowWelcome}">

            <!--
                Focus ring (P08-T05): the focused panel's border is highlighted. Without an
                indicator, keyboard navigation is useless — the user cannot see where their
                keystrokes are going.
            -->
            <Border Grid.Column="0" Name="BranchPanelHost" Classes="panel" MinWidth="120">
                <views:RefTreeView Name="BranchPanel" DataContext="{Binding RefTree}" />
            </Border>

            <GridSplitter Name="BranchPanelSplitter"
                          Grid.Column="1"
                          Width="4"
                          ResizeDirection="Columns"
                          Background="{DynamicResource GitExtSeparatorBrush}" />

        <Grid Grid.Column="2"
              Name="RightSplitGrid"
              RowDefinitions="*,4,220">

            <Border Grid.Row="0" Classes="panel">
                <views:CommitListView Name="CommitList" DataContext="{Binding Commits}" />
            </Border>

            <!-- Repository open but no commits at all: a fresh `git init`. Not a blank screen, an explanation. -->
            <Border Grid.Row="0"
                    IsVisible="{Binding Commits.IsEmptyRepository}"
                    Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
                    <TextBlock Text="{loc:Translate main.no_commits_in_this_repository_yet}"
                               FontSize="14"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{loc:Translate main.history_will_appear_here_once_the_first_comm}"
                               FontSize="12"
                               Opacity="0.65"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <GridSplitter Grid.Row="1"
                          Name="BottomPanelSplitter"
                          Height="4"
                          ResizeDirection="Rows"
                          Background="{DynamicResource GitExtSeparatorBrush}"
                          IsVisible="{Binding Commits.Details.HasCommit}" />

            <!--
                The lower area is tabbed: details and changed files. GitExtensions' layout is the
                same (grid on top, tabbed area below). Because the diff component is standalone,
                the same one will also be used in P04-T16's separate window.
            -->
            <TabControl Grid.Row="2"
                        Name="BottomPanel"
                        MinHeight="80"
                        Padding="0"
                        IsVisible="{Binding Commits.Details.HasCommit}">

                <TabItem Header="{loc:Translate main.details}" FontSize="12">
                    <Border Classes="panel">
                        <views:CommitDetailsView Name="Details" DataContext="{Binding Commits.Details}" />
                    </Border>
                </TabItem>

                <TabItem Header="{loc:Translate main.changes}" FontSize="12">
                    <Border Classes="panel">
                        <views:DiffView Name="ChangesDiff" DataContext="{Binding Commits.Diff}" />
                    </Border>
                </TabItem>
            </TabControl>
        </Grid>
        </Grid>
    </Grid>
</Window>
