<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="using:System">

    <!--
        Typography (P08-T10).

        The font family and the sizes are THEME-INDEPENDENT: switching light/dark must not change
        the type. That is why they are not inside `ThemeDictionaries`.

        The values are overwritten at runtime by `TypographyService` (user setting, P08-T14).
        The ones here are only for the first frame, before the setting is read.

        ⚠️ The monospace family is a LIST: "monospace" alone works on Linux but has no
        counterpart on Windows or macOS. The order matters — the first family found is used.
    -->

    <FontFamily x:Key="GitExtMonospaceFont">Cascadia Mono,Consolas,Menlo,DejaVu Sans Mono,monospace</FontFamily>

    <sys:Double x:Key="GitExtUiFontSize">12</sys:Double>
    <sys:Double x:Key="GitExtMonospaceFontSize">12</sys:Double>

    <!-- Derived sizes: when the user changes the base size, these shift with it. -->
    <sys:Double x:Key="GitExtSmallFontSize">11</sys:Double>
    <sys:Double x:Key="GitExtLargeFontSize">14</sys:Double>
</ResourceDictionary>
