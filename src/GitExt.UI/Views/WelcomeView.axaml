<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:GitExt.UI.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:GitExt.UI.ViewModels"
             xmlns:views="using:GitExt.UI.Views"
             mc:Ignorable="d"
             d:DesignWidth="900" d:DesignHeight="500"
             x:Class="GitExt.UI.Views.WelcomeView"
             x:DataType="vm:MainWindowViewModel">

    <!--
        The welcome screen — the LAYOUT was taken from GitExtensions' `Dashboard` (P08-T25):
        a fixed-width panel on the left, "Start" links at the top
        (Create new repository · Open repository · Clone repository), "Contribute" below;
        the list of recently opened repositories in the middle/right.

        The user's rule: it does not have to look identical, but the BUTTONS MUST BE IN THE SAME
        PLACE — someone used to GitExtensions must be able to look in the same spot.
    -->

    <UserControl.Styles>
        <!-- An entry whose folder no longer exists looks dimmed but stays in the list. -->
        <Style Selector="Button.missing">
            <Setter Property="Opacity" Value="0.45" />
        </Style>

        <!-- The links in the left panel: buttons that look like plain text. -->
        <Style Selector="Button.link">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,5" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style Selector="Button.link:disabled">
            <Setter Property="Opacity" Value="0.4" />
        </Style>

        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="0.8" />
            <Setter Property="Margin" Value="4,0,0,6" />
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="230,*">

        <!-- SOL PANEL — GitExtensions'ta `pnlLeft` -->
        <Border Grid.Column="0"
                BorderThickness="0,0,1,0"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                Background="{DynamicResource SystemControlBackgroundAltHighBrush}">

            <Grid RowDefinitions="Auto,*,Auto" Margin="16,18">

                <!-- Logo area (`pnlLogo`) -->
                <StackPanel Grid.Row="0" Spacing="2" Margin="4,0,0,18">
                    <TextBlock Text="{loc:Translate welcome.gitext_core}" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="{loc:Translate welcome.git_extensions_core}" FontSize="11" Opacity="0.55" />
                </StackPanel>

                <!-- Start links (`flpnlStart`) — in GitExtensions' order -->
                <StackPanel Grid.Row="1" Spacing="2">
                    <TextBlock Text="{loc:Translate welcome.start}" Classes="section" />

                    <!--
                        Commands that are not implemented yet are NOT REMOVED, they are disabled:
                        breaking the order is worse than slotting one in later (muscle memory).
                        Creating and cloning a repository arrive in Phase 06.
                    -->
                    <Button Name="CreateRepositoryButton"
                            Classes="link"
                            Content="{loc:Translate welcome.create_new_repository}"
                            IsEnabled="False"
                            ToolTip.Tip="{loc:Translate welcome.coming_in_phase_06}" />

                    <Button Name="OpenFolderButton"
                            Classes="link"
                            Content="{loc:Translate welcome.open_repository}"
                            Click="OnOpenFolderClick" />

                    <Button Name="CloneRepositoryButton"
                            Classes="link"
                            Content="{loc:Translate welcome.clone_repository}"
                            IsEnabled="False"
                            ToolTip.Tip="{loc:Translate welcome.coming_in_phase_06}" />

                    <TextBlock Text="{loc:Translate welcome.or_drag_a_folder_onto_the_window}"
                               FontSize="11"
                               Opacity="0.5"
                               TextWrapping="Wrap"
                               Margin="4,10,0,0" />
                </StackPanel>

                <!-- Contribute (`flpnlContribute`) — altta sabit -->
                <StackPanel Grid.Row="2" Spacing="2">
                    <TextBlock Text="{loc:Translate welcome.contribute}" Classes="section" />

                    <Button Name="DevelopButton"
                            Classes="link"
                            Content="{loc:Translate welcome.develop}"
                            Click="OnDevelopClick" />

                    <Button Name="IssuesButton"
                            Classes="link"
                            Content="{loc:Translate welcome.report_an_issue}"
                            Click="OnIssuesClick" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- RIGHT/MIDDLE — recently opened repositories (`userRepositoriesList`) -->
        <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*" Margin="20,18">

            <TextBlock Grid.Row="0"
                       Text="{loc:Translate welcome.recently_opened_repositories}"
                       Classes="section" />

            <!-- If opening failed, the reason is here; visible without leaving the screen. -->
            <Border Grid.Row="1"
                    IsVisible="{Binding Commits.ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}"
                    Background="{DynamicResource GitExtErrorBackgroundBrush}"
                    BorderBrush="{DynamicResource GitExtErrorBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="10,7"
                    Margin="0,0,0,10">
                <StackPanel Spacing="6">
                    <TextBlock Text="{Binding Commits.ErrorMessage}"
                               FontSize="12"
                               Foreground="{DynamicResource GitExtErrorForegroundBrush}"
                               TextWrapping="Wrap" />

                    <!--
                        P05-T07 — git's actual output. This is the MOST FREQUENT error path
                        ("this folder is not a Git repository"); the summary alone does not let
                        anyone diagnose it.
                    -->
                    <views:GitErrorDetailsButton Details="{Binding Commits.ErrorDetails}"
                                                 HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <!--
                ⚠️ `IsVisible="{Binding …Count}"` silently does not work in Avalonia (measured in
                Phase 03); a separate bool property is used.
            -->
            <TextBlock Grid.Row="2"
                       Text="{loc:Translate welcome.no_repository_open_yet_start_with_open_repos}"
                       IsVisible="{Binding !HasRecentRepositories}"
                       FontSize="12"
                       Opacity="0.55"
                       Margin="4,6,0,0" />

            <ScrollViewer Grid.Row="2" IsVisible="{Binding HasRecentRepositories}">
                <ItemsControl ItemsSource="{Binding RecentRepositories}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:RecentRepositoryItem">
                            <Button Command="{Binding OpenCommand}"
                                    CommandParameter="{Binding Path}"
                                    Classes.missing="{Binding !Exists}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="8,6"
                                    Margin="0,0,0,2">
                                <StackPanel Spacing="1">
                                    <TextBlock Text="{Binding Name}" FontSize="13" />

                                    <!--
                                        A missing folder is not removed, it is shown dimmed: a
                                        drive that is not mounted is no reason to prune the list.
                                    -->
                                    <TextBlock Text="{Binding Path}"
                                               FontSize="11"
                                               Opacity="0.55"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
