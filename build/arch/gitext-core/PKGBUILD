# Maintainer: gitext-core contributors <https://github.com/ibrahimhates/gitext-core>
#
# gitext-core — built from source (P10-T13).
#
# For a prebuilt binary see the `gitext-core-bin` package; that is the one recommended for
# most users. This package downloads the .NET SDK and builds (~1 GB, a few minutes).

pkgname=gitext-core
pkgver=0.0.0
pkgrel=1
pkgdesc="Fast native Git GUI — browse history, stage changes and manage branches (built from source)"
arch=('x86_64')
url="https://github.com/ibrahimhates/gitext-core"
license=('GPL-3.0-or-later')

depends=('git>=2.30')
makedepends=('dotnet-sdk>=10.0')

provides=('gitext-core')
conflicts=('gitext-core-bin')

# A self-contained publish: the binary carries the .NET runtime and must not be stripped.
options=('!strip')

source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('SKIP')

build() {
    cd "${srcdir}/${pkgname}-${pkgver}"

    # ⚠️ MinVerVersionOverride is REQUIRED: the source archive has NO .git, so MinVer cannot
    # see a tag and falls back to 0.0.0-alpha.0. `-p:Version=` does not work — MinVer
    # overrides it (measured in P10-T00). The version comes from pkgver.
    dotnet publish src/GitExt.Desktop \
        -c Release \
        -r linux-x64 \
        --self-contained \
        -p:PublishSingleFile=true \
        -p:PublishTrimmed=true \
        -p:PublishReadyToRun=true \
        -p:MinVerVersionOverride="${pkgver}" \
        -o "${srcdir}/publish"

    # The icons are generated from SVG (skipped when rsvg-convert is missing — the package
    # still installs, it just ends up without icons).
    if command -v rsvg-convert >/dev/null; then
        build/icons/generate.sh "${srcdir}/icons"
    fi
}

check() {
    cd "${srcdir}/${pkgname}-${pkgver}"

    # The core tests: the git output parsing logic, against the user's real git version.
    # The UI tests are skipped because they need the headless backend.
    dotnet test tests/GitExt.Core.Tests -c Release
}

package() {
    cd "${srcdir}/${pkgname}-${pkgver}"

    install -Dm755 "${srcdir}/publish/gitext-core" "${pkgdir}/usr/bin/gitext-core"

    install -Dm644 build/linux/io.github.ibrahimhates.GitExtCore.desktop \
        "${pkgdir}/usr/share/applications/io.github.ibrahimhates.GitExtCore.desktop"

    install -Dm644 build/linux/io.github.ibrahimhates.GitExtCore.metainfo.xml \
        "${pkgdir}/usr/share/metainfo/io.github.ibrahimhates.GitExtCore.metainfo.xml"

    if [ -d "${srcdir}/icons/hicolor" ]; then
        find "${srcdir}/icons/hicolor" -type f | while read -r icon; do
            rel="${icon#"${srcdir}/icons/"}"
            install -Dm644 "$icon" "${pkgdir}/usr/share/icons/${rel}"
        done
    fi

    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}

post_install() {
    gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor 2>/dev/null || true
    update-desktop-database -q /usr/share/applications 2>/dev/null || true
}

post_upgrade() {
    post_install
}
