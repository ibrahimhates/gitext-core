<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Avalonia arayüzü: View'lar, ViewModel'lar, özel kontroller, temalar.
    Avalonia'ya bağımlı tek kütüphane projesi (ADR-0003).
  -->

  <PropertyGroup>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../GitExt.Core/GitExt.Core.csproj" />
    <ProjectReference Include="../GitExt.Graph/GitExt.Graph.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Dil dosyaları ikiliye gömülüyor (P11-T01). JOKER bilinçli: yeni bir dil eklemek
      yalnızca bu klasöre bir JSON bırakmak olmalı — .csproj'a da, C# koduna da dokunmadan.
      Translator dilleri çalışma anında gömülü kaynak adlarından keşfediyor.

      Gömülü (EmbeddedResource), yanına kopyalanan (Content) DEĞİL: tek dosyalık publish
      çıktısında yan dosya bırakmak, kullanıcının silebileceği/bozabileceği bir bağımlılık
      yaratırdı.
    -->
    <EmbeddedResource Include="Locales\*.json" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Görünümlerin test kancaları (örn. CommitListView.ComparisonRequested) testlere açık
      ama public API'nin parçası değil: pencere açmayı headless ortamda saymak güvenilir
      olmadığı için tuş → komut bağlantısı bu olay üzerinden doğrulanıyor.
    -->
    <InternalsVisibleTo Include="GitExt.UI.Tests" />
  </ItemGroup>

</Project>
