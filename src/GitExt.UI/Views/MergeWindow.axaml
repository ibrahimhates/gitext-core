<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:GitExt.UI.Localization"
        xmlns:vm="using:GitExt.UI.ViewModels"
        x:Class="GitExt.UI.Views.MergeWindow"
        x:DataType="vm:MergeViewModel"
        Title="{loc:Translate merge.merge}"
        Width="580"
        SizeToContent="Height"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <!--
        Yerleşim GitExtensions `FormMergeBranch.Designer.cs`'ten (§ 9), sıra birebir:
          "Merge branch" (dal seçimi) -> "Into current branch" (salt okunur) ->
          fast forward / always create a merge commit -> "Do not commit" ->
          "Show advanced options" -> (squash · allow unrelated histories · merge message)
          -> "Merge" düğmesi.

        Bizde OLMAYAN: "Use non-default merge strategy" (resolve/octopus/ours/subtree) ve
        "Add log messages" — yerinde ama devre dışı; ikisi de ileri seviye ve Faz 07'nin
        çakışma çözümüyle birlikte anlam kazanıyor.

        EKLENEN: seçilen dalın NE getireceği (ileri sarılabilir mi, kaç commit) ve
        çalıştırılacak KOMUT. Ayrıca squash seçilince ne olacağı ÖNCEDEN yazılı.
    -->
    <StackPanel Margin="16" Spacing="10">

        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
            <TextBlock Grid.Row="0" Grid.Column="0"
                       Text="{loc:Translate merge.branch_to_merge}"
                       VerticalAlignment="Center"
                       Margin="0,0,8,4" />
            <ComboBox Name="SourceBox"
                      Grid.Row="0" Grid.Column="1"
                      HorizontalAlignment="Stretch"
                      Margin="0,0,0,4"
                      ItemsSource="{Binding Sources}"
                      SelectedItem="{Binding Source}" />

            <TextBlock Grid.Row="1" Grid.Column="0"
                       Text="{loc:Translate merge.into_current_branch}"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0" />
            <TextBox Name="CurrentBranchBox"
                     Grid.Row="1" Grid.Column="1"
                     IsReadOnly="True"
                     IsTabStop="False"
                     Text="{Binding CurrentBranch}" />
        </Grid>

        <TextBlock Name="PreviewNoticeText"
                   FontSize="11"
                   Opacity="0.85"
                   TextWrapping="Wrap"
                   IsVisible="{Binding HasPreviewNotice}"
                   Text="{Binding PreviewNotice}" />

        <StackPanel Spacing="4">
            <RadioButton Name="FastForwardRadio"
                         GroupName="MergeMode"
                         Content="{loc:Translate merge.keep_a_single_line_where_possible_fast_forwa}"
                         IsChecked="{Binding IsFastForward}" />
            <RadioButton Name="MergeCommitRadio"
                         GroupName="MergeMode"
                         Content="{loc:Translate merge.always_create_a_merge_commit}"
                         IsChecked="{Binding IsMergeCommit}" />
        </StackPanel>

        <CheckBox Name="NoCommitBox"
                  Content="{loc:Translate merge.do_not_commit}"
                  IsChecked="{Binding NoCommit}" />

        <ToggleButton Name="ShowAdvancedToggle"
                      Content="{loc:Translate merge.show_advanced_options}"
                      HorizontalAlignment="Left"
                      IsChecked="{Binding ShowAdvanced}" />

        <StackPanel Name="AdvancedPanel" Spacing="6" IsVisible="{Binding ShowAdvanced}">
            <!-- Yerinde ama devre dışı (§ 9): Faz 07'nin çakışma çözümüyle anlam kazanıyor. -->
            <CheckBox Name="CustomStrategyBox"
                      Content="{loc:Translate merge.use_a_non_default_merge_strategy}"
                      IsEnabled="False" />

            <CheckBox Name="SquashBox"
                      Content="{loc:Translate merge.squash_commits_into_a_single_change}"
                      IsChecked="{Binding IsSquash}" />

            <TextBlock Name="SquashNoticeText"
                       FontSize="11"
                       Opacity="0.9"
                       TextWrapping="Wrap"
                       Margin="20,0,0,0"
                       IsVisible="{Binding HasSquashNotice}"
                       Text="{Binding SquashNotice}" />

            <CheckBox Name="UnrelatedBox"
                      Content="{loc:Translate merge.allow_unrelated_histories}"
                      IsChecked="{Binding AllowUnrelatedHistories}" />

            <CheckBox Name="AddLogMessagesBox"
                      Content="{loc:Translate merge.add_log_messages}"
                      IsEnabled="False" />

            <TextBlock Text="{loc:Translate merge.merge_message_git_s_default_if_empty}"
                       FontSize="11"
                       Opacity="0.8" />
            <TextBox Name="MessageBox"
                     AcceptsReturn="True"
                     Height="60"
                     Text="{Binding Message}" />
        </StackPanel>

        <!-- "Komutu göster" ilkesi. -->
        <StackPanel Spacing="3">
            <TextBlock Text="{loc:Translate merge.command_to_run}" FontSize="11" Opacity="0.8" />
            <TextBox Name="CommandPreviewBox"
                     IsReadOnly="True"
                     IsTabStop="False"
                     FontFamily="{DynamicResource GitExtMonospaceFont}"
                     FontSize="11"
                     Text="{Binding CommandPreview}" />
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock Name="WarningText"
                       FontSize="11"
                       TextWrapping="Wrap"
                       IsVisible="{Binding HasWarning}"
                       Text="{Binding Warning}"
                       Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}" />
            <TextBlock Name="NoticeText"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Opacity="0.85"
                       Text="{Binding Notice}" />
            <StackPanel Name="RecoveryPanel" Spacing="2" IsVisible="{Binding HasRecoveryCommand}">
                <TextBlock Text="{loc:Translate merge.to_undo_this}" FontSize="11" Opacity="0.8" />
                <TextBox Name="RecoveryCommandBox"
                         IsReadOnly="True"
                         FontFamily="{DynamicResource GitExtMonospaceFont}"
                         FontSize="11"
                         Text="{Binding RecoveryCommand}" />
            </StackPanel>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Name="CloseButton" Content="{loc:Translate merge.close}" MinWidth="90" IsCancel="True" Click="OnCloseClick" />
            <Button Name="MergeButton"
                    Content="{loc:Translate merge.merge}"
                    MinWidth="110"
                    IsDefault="True"
                    Command="{Binding RunCommand}" />
        </StackPanel>
    </StackPanel>
</Window>
