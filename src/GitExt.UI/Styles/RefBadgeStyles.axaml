<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Ref badge styles (P03-T12). Both the commit list and the details panel use them;
        copying them into two places meant changing one and forgetting the other.

        The colours are NO LONGER here: they all live in Themes/Palette.axaml, separately for
        light and dark (P08-T07). The styles here only say which badge carries which meaning.
    -->

    <Style Selector="Border.badge">
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Padding" Value="5,1" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{DynamicResource GitExtBadgeBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GitExtBadgeBorderBrush}" />
    </Style>

    <Style Selector="Border.badge > TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource GitExtBadgeForegroundBrush}" />
    </Style>

    <!-- Yerel dal: mavi -->
    <Style Selector="Border.badge.local">
        <Setter Property="Background" Value="{DynamicResource GitExtBadgeLocalBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GitExtBadgeLocalBorderBrush}" />
    </Style>
    <Style Selector="Border.badge.local > TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource GitExtBadgeLocalForegroundBrush}" />
    </Style>

    <!-- Remote branch: purple, paler (so it reads apart from a local one) -->
    <Style Selector="Border.badge.remote">
        <Setter Property="Background" Value="{DynamicResource GitExtBadgeRemoteBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GitExtBadgeRemoteBorderBrush}" />
    </Style>
    <Style Selector="Border.badge.remote > TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource GitExtBadgeRemoteForegroundBrush}" />
    </Style>

    <!-- Tag: yellow/amber -->
    <Style Selector="Border.badge.tag">
        <Setter Property="Background" Value="{DynamicResource GitExtBadgeTagBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GitExtBadgeTagBorderBrush}" />
    </Style>
    <Style Selector="Border.badge.tag > TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource GitExtBadgeTagForegroundBrush}" />
    </Style>

    <!-- HEAD (detached): red, attention-grabbing -->
    <Style Selector="Border.badge.head">
        <Setter Property="Background" Value="{DynamicResource GitExtBadgeHeadBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GitExtBadgeHeadBorderBrush}" />
    </Style>
    <Style Selector="Border.badge.head > TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource GitExtBadgeHeadForegroundBrush}" />
    </Style>

    <!-- Checked-out branch: bold type — where you are should be obvious at a glance -->
    <Style Selector="Border.badge.current > TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.badge.current">
        <Setter Property="BorderThickness" Value="2" />
    </Style>
</Styles>
