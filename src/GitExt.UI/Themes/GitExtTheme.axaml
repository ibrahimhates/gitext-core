<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Uygulamanın tek tema girişi (P08-T07). `App.axaml` yalnızca bunu ekler; hangi
        sözlüklerin hangi sırayla yükleneceği burada, tek yerde duruyor.
    -->

    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://GitExt.UI/Themes/Palette.axaml" />
                <ResourceInclude Source="avares://GitExt.UI/Themes/Typography.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Styles.Resources>

    <StyleInclude Source="avares://GitExt.UI/Styles/RefBadgeStyles.axaml" />

    <!--
        Odak göstergesi (P08-T05). Odaklı panelin kenarlığı vurgulanıyor.

        🔴 Gösterge olmadan klavye gezinmesi işe yaramaz: kullanıcı tuşlarının nereye
        gittiğini göremez ve `F6` bastığında bir şey olup olmadığını anlayamaz.

        `:focus-within` kullanılıyor, `:focus` değil — P08-T00/M09'da ölçüldü, odak
        neredeyse her zaman panelin İÇİNDEKİ bir öğede (bir `ListBoxItem`, bir `TextBox`);
        panelin kendisi hiç odak almıyor.
    -->
    <Style Selector="Border.panel">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style Selector="Border.panel:focus-within">
        <Setter Property="BorderBrush" Value="{DynamicResource GitExtAccentBrush}" />
    </Style>
</Styles>
