<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:GitExt.UI.Localization"
        xmlns:vm="using:GitExt.UI.ViewModels"
        x:Class="GitExt.UI.Views.ResetDialog"
        x:DataType="vm:ResetViewModel"
        Title="{loc:Translate reset.reset_current_branch}" Width="580" SizeToContent="Height"
        WindowStartupLocation="CenterOwner">

  <!-- GitExtensions FormResetCurrentBranch (§ 9): radyo düğmeleri + açıklama + onay. -->
  <StackPanel Margin="16" Spacing="10">

    <TextBlock Name="TargetLabel" FontWeight="Bold"
               Text="{Binding Target, StringFormat='Reset to {0}'}" />

    <TextBlock Name="DroppedLabel" Text="{Binding DroppedText}" TextWrapping="Wrap" />

    <StackPanel Spacing="4">
      <RadioButton Name="SoftRadio" GroupName="mode" Content="{loc:Translate reset.soft_keep_changes_staged}"
                   IsChecked="{Binding IsSoft}" />
      <RadioButton Name="MixedRadio" GroupName="mode" Content="{loc:Translate reset.mixed_keep_changes_unstage_them}"
                   IsChecked="{Binding IsMixed}" />
      <RadioButton Name="HardRadio" GroupName="mode" Content="{loc:Translate reset.hard_discard_all_changes}"
                   IsChecked="{Binding IsHard}" />
    </StackPanel>

    <Border Background="{DynamicResource GitExtSubtleBackgroundBrush}" CornerRadius="4" Padding="8">
      <TextBlock Name="ModeDescriptionLabel" Text="{Binding ModeDescription}" TextWrapping="Wrap" />
    </Border>

    <!-- Ek onay yalnızca GERİ ALINAMAYAN kayıpta: hard mod + kirli ağaç. -->
    <CheckBox Name="ConfirmBox"
              IsChecked="{Binding Confirmed}"
              IsVisible="{Binding RequiresConfirmation}"
              Content="{loc:Translate reset.i_understand_that_uncommitted_changes_will_b}" />

    <TextBlock Name="CommandLabel" FontFamily="{DynamicResource GitExtMonospaceFont}" FontSize="11" Opacity="0.7"
               Text="{Binding CommandLine}" />

    <TextBlock Name="ResultLabel" Text="{Binding Result}" TextWrapping="Wrap"
               IsVisible="{Binding Result, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    <TextBlock Name="ErrorLabel" Text="{Binding Error}" Foreground="{DynamicResource GitExtErrorBrush}" TextWrapping="Wrap"
               IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
      <Button Name="ResetButton" Content="{loc:Translate reset.reset}" Command="{Binding ResetCommand}" IsDefault="True" />
      <Button Name="CancelButton" Content="{loc:Translate reset.close}" Click="OnClose" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>
