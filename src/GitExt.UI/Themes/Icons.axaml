<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        ===================================================================================
        Icons (P12-T03)
        ===================================================================================

        GitExtensions ships its icons as PNG resources. Here they are geometry: a vector scales
        with the interface font (P08-T09 makes that adjustable), needs no per-DPI variants, and —
        the reason that decides it — takes its colour from the theme. A bitmap drawn for a light
        background is the thing that goes unreadable when the dark theme is switched on, and
        nothing fails when it does.

        All paths are drawn on a 16×16 box; `PathIcon` scales them. `F0` at the start of a path
        means the even-odd fill rule — that is how the rings (globe, magnifier) get their hole.
    -->

    <!-- Start links (`flpnlStart`) ................................................. -->

    <!-- Create new repository: a plus. -->
    <StreamGeometry x:Key="IconRepositoryCreate">M7,3 H9 V7 H13 V9 H9 V13 H7 V9 H3 V7 H7 Z</StreamGeometry>

    <!-- Open repository: an open folder. -->
    <StreamGeometry x:Key="IconRepositoryOpen">M1.5,2.5 H6 L7.5,4.5 H13 V6 H5.2 L2.6,12.5 H1.5 Z M6.2,7 H15 L12.4,13.5 H3.6 Z</StreamGeometry>

    <!-- Clone repository: a copy of one thing into another. -->
    <StreamGeometry x:Key="IconRepositoryClone">M2,2 H9.5 V4 H4 V10.5 H2 Z M5.5,5.5 H14 V14 H5.5 Z</StreamGeometry>

    <!-- Contribute links (`flpnlContribute`) ....................................... -->

    <!-- Develop: code brackets. -->
    <StreamGeometry x:Key="IconDevelop">M5.4,3.4 L6.8,4.8 L3.6,8 L6.8,11.2 L5.4,12.6 L0.8,8 Z M10.6,3.4 L15.2,8 L10.6,12.6 L9.2,11.2 L12.4,8 L9.2,4.8 Z</StreamGeometry>

    <!-- Translate: a globe. -->
    <StreamGeometry x:Key="IconTranslate">F0 M1,8 A7,7 0 1 0 15,8 A7,7 0 1 0 1,8 Z M3,8 A5,5 0 1 1 13,8 A5,5 0 1 1 3,8 Z M2,7.4 H14 V8.6 H2 Z M7.4,2 H8.6 V14 H7.4 Z</StreamGeometry>

    <!-- Report an issue: a bug. -->
    <StreamGeometry x:Key="IconIssue">M8,2.5 A3.5,3.5 0 0 1 11.5,6 V9.5 A3.5,3.5 0 0 1 4.5,9.5 V6 A3.5,3.5 0 0 1 8,2.5 Z M0.8,6 H3.6 V7.2 H0.8 Z M12.4,6 H15.2 V7.2 H12.4 Z M0.8,10 H3.6 V11.2 H0.8 Z M12.4,10 H15.2 V11.2 H12.4 Z</StreamGeometry>

    <!-- Repository tiles (`listView1`) .............................................. -->

    <!-- The folder of a repository. -->
    <StreamGeometry x:Key="IconRepositoryFolder">M1.5,2.5 H6 L7.5,4.5 H14.5 V13.5 H1.5 Z</StreamGeometry>

    <!--
        A folder that can no longer be reached: the same shape with a gap struck out of it, so it
        is told apart by its FORM and not only by its colour — colour alone is not a signal
        everybody can see (P08-T11, the colour-blind palette).
    -->
    <StreamGeometry x:Key="IconRepositoryFolderMissing">F0 M1.5,2.5 H6 L7.5,4.5 H14.5 V13.5 H1.5 Z M5.4,6.6 L6.4,5.6 L8,7.2 L9.6,5.6 L10.6,6.6 L9,8.2 L10.6,9.8 L9.6,10.8 L8,9.2 L6.4,10.8 L5.4,9.8 L7,8.2 Z</StreamGeometry>

    <!-- A repository filed under a category — GitExtensions draws the same star. -->
    <StreamGeometry x:Key="IconStar">M8,1.4 L9.9,5.4 L14.3,6 L11.1,9.1 L11.9,13.5 L8,11.4 L4.1,13.5 L4.9,9.1 L1.7,6 L6.1,5.4 Z</StreamGeometry>

    <!-- The branch the repository is on. -->
    <StreamGeometry x:Key="IconBranch">M4.5,1.5 A2,2 0 1 1 3.9,5.4 V10.6 A2,2 0 1 1 5.1,10.6 V8.6 A3,3 0 0 0 8.1,5.6 H9.4 A2,2 0 1 0 9.4,4.4 H8.1 A3,3 0 0 0 5.1,1.5 Z</StreamGeometry>

    <!-- The search box. -->
    <StreamGeometry x:Key="IconSearch">F0 M6.5,1 A5.5,5.5 0 1 0 6.51,1 Z M6.5,3 A3.5,3.5 0 1 1 6.49,3 Z M10.2,11.3 L11.3,10.2 L15.3,14.2 L14.2,15.3 Z</StreamGeometry>

</ResourceDictionary>
