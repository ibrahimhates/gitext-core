<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:GitExt.UI.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:GitExt.UI.ViewModels"
        xmlns:views="using:GitExt.UI.Views"
        mc:Ignorable="d"
        d:DesignWidth="700" d:DesignHeight="420"
        x:Class="GitExt.UI.Views.GitOutputWindow"
        x:DataType="vm:GitOutputViewModel"
        Title="{Binding Title}"
        Width="700" Height="420"
        MinWidth="420" MinHeight="240"
        WindowStartupLocation="CenterOwner">

    <!--
        The window is MODELESS (`Show()`): the user must be able to keep the hook output open and
        go back to the code — the answer to "which file had the error" is in there. With
        `ShowDialog` they would have to close it before they could read the output. Same reasoning
        as the comparison window in P04-T16.
    -->

    <Grid RowDefinitions="*,Auto" Margin="12">

        <views:GitOutputView Grid.Row="0" />

        <Button Grid.Row="1"
                Name="CloseButton"
                Content="{loc:Translate git_output.close}"
                HorizontalAlignment="Right"
                IsCancel="True"
                Margin="0,10,0,0"
                Click="OnCloseClick" />
    </Grid>
</Window>
