<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="GitExt.UI.Views.RemoveRemoteDialog"
        Title="Uzak depoyu kaldır"
        Width="560"
        SizeToContent="Height"
        MinHeight="200"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <!--
        GitExtensions'ta bu ekranın karşılığı yalnızca "Delete" düğmesi ve basit bir onay.
        Ölçüm bunun yetmediğini gösterdi: silme sonrası uzak izleme dalları VE reflog'ları
        gidiyor, budayan bir `git gc` sonrası yalnız o dallarda duran commit KAYBOLUYOR.
        (XML yorumunda iki tire yan yana yazılamıyor — Faz 01'deki tuzağın aynısı.)
        Bu yüzden P06-T03'teki kurtarma bölümü buraya da kondu — farkıyla birlikte:
        kurtarma `fetch` gerektiriyor, yani uzak depo hâlâ erişilebilir olmalı.
    -->
    <StackPanel Margin="16" Spacing="10">

        <TextBlock Name="MessageText" TextWrapping="Wrap" FontWeight="SemiBold" />

        <TextBlock Name="ImpactText" TextWrapping="Wrap" />

        <StackPanel Spacing="3">
            <TextBlock Text="Geri getirmek için:" FontSize="11" Opacity="0.85" />
            <TextBox Name="RecoveryCommands"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     MaxHeight="120"
                     FontFamily="{DynamicResource GitExtMonospaceFont}"
                     FontSize="11" />
            <TextBlock Name="RecoveryNote"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Opacity="0.75"
                       Text="Bu komutlar yapılandırmayı geri kurar; commit'ler ise ancak yeniden fetch ile döner — yani uzak depoya erişiminiz olmalı." />
        </StackPanel>

        <CheckBox Name="ConfirmBox" Content="Kaldırmayı onaylıyorum" />

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8">
            <Button Name="CancelButton" Content="İptal" MinWidth="90" IsCancel="True" Click="OnCancelClick" />
            <Button Name="RemoveButton" Content="Kaldır" MinWidth="90" IsDefault="True" Click="OnRemoveClick" />
        </StackPanel>
    </StackPanel>
</Window>
