<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        ===================================================================================
        GitExt colour palette (P08-T07)
        ===================================================================================

        NO colour is embedded inside the XAML views. Going into Phase 08 there were 47 embedded
        colours and every one of them had been picked against a light background; those were
        exactly the ones that would be unreadable in the dark theme. This is the single source.

        ⚠️ Usage rule: views use **DynamicResource**, NOT StaticResource. Measured in
        P08-T00/M08b: `ThemeDictionaries` update live only with a dynamic resource; a static
        binding freezes on the first theme and the theme switch stays half-done over part of the
        screen — a half theme is worse than no theme (P08-T08).

        Naming: `GitExt<Purpose><Kind>Brush`. The purpose is the MEANING, not the colour: it is
        called "Error", not "Red" — in the dark theme the same meaning is met by a different
        colour.

        The light theme values are close to GitHub's light palette (the existing code already
        came from there: #E6FFEC / #FFEBE9 are GitHub's diff colours). The dark theme
        counterparts were derived from GitHub's dark palette.
    -->

    <ResourceDictionary.ThemeDictionaries>

        <!-- =========================================================== LIGHT (default) -->
        <ResourceDictionary x:Key="Light">

            <!-- Structural -->
            <SolidColorBrush x:Key="GitExtBorderBrush" Color="#D0D7DE" />
            <SolidColorBrush x:Key="GitExtSeparatorBrush" Color="#40808080" />
            <SolidColorBrush x:Key="GitExtSubtleBackgroundBrush" Color="#20808080" />
            <SolidColorBrush x:Key="GitExtMutedBrush" Color="#6B6B6B" />
            <SolidColorBrush x:Key="GitExtAccentBrush" Color="#0969DA" />
            <SolidColorBrush x:Key="GitExtOverlayBrush" Color="#E6FFFFFF" />

            <!-- Durum renkleri -->
            <SolidColorBrush x:Key="GitExtSuccessBrush" Color="#1A7F37" />
            <SolidColorBrush x:Key="GitExtDangerBrush" Color="#CF222E" />
            <SolidColorBrush x:Key="GitExtAttentionBrush" Color="#BC4C00" />
            <SolidColorBrush x:Key="GitExtRenameBrush" Color="#5B4BB5" />

            <!-- Error strip -->
            <SolidColorBrush x:Key="GitExtErrorBrush" Color="#B3261E" />
            <SolidColorBrush x:Key="GitExtErrorBackgroundBrush" Color="#FBE0DE" />
            <SolidColorBrush x:Key="GitExtErrorBorderBrush" Color="#E39D98" />
            <SolidColorBrush x:Key="GitExtErrorForegroundBrush" Color="#6E1F1A" />

            <!-- Warning strip -->
            <SolidColorBrush x:Key="GitExtWarningBrush" Color="#8A5A00" />
            <SolidColorBrush x:Key="GitExtWarningBackgroundBrush" Color="#FFF6D8" />
            <SolidColorBrush x:Key="GitExtWarningBorderBrush" Color="#E0C169" />

            <!-- Diff -->
            <SolidColorBrush x:Key="GitExtDiffAddedBackgroundBrush" Color="#E6FFEC" />
            <SolidColorBrush x:Key="GitExtDiffRemovedBackgroundBrush" Color="#FFEBE9" />
            <SolidColorBrush x:Key="GitExtDiffHunkHeaderBackgroundBrush" Color="#EEF2F7" />
            <SolidColorBrush x:Key="GitExtDiffGutterBackgroundBrush" Color="#E9E9EF" />
            <SolidColorBrush x:Key="GitExtDiffSelectionBorderBrush" Color="#0969DA" />
            <SolidColorBrush x:Key="GitExtDiffAddedForegroundBrush" Color="#1A7F37" />
            <SolidColorBrush x:Key="GitExtDiffRemovedForegroundBrush" Color="#CF222E" />
            <SolidColorBrush x:Key="GitExtDiffAddedWordBrush" Color="#ABF2BC" />
            <SolidColorBrush x:Key="GitExtDiffRemovedWordBrush" Color="#FFC9C6" />

            <!-- Ref rozetleri -->
            <SolidColorBrush x:Key="GitExtBadgeBackgroundBrush" Color="#EEEEEE" />
            <SolidColorBrush x:Key="GitExtBadgeBorderBrush" Color="#CCCCCC" />
            <SolidColorBrush x:Key="GitExtBadgeForegroundBrush" Color="#333333" />

            <SolidColorBrush x:Key="GitExtBadgeLocalBackgroundBrush" Color="#DCEBF9" />
            <SolidColorBrush x:Key="GitExtBadgeLocalBorderBrush" Color="#8FB8DC" />
            <SolidColorBrush x:Key="GitExtBadgeLocalForegroundBrush" Color="#12395C" />

            <SolidColorBrush x:Key="GitExtBadgeRemoteBackgroundBrush" Color="#EDE7F6" />
            <SolidColorBrush x:Key="GitExtBadgeRemoteBorderBrush" Color="#B9A7DA" />
            <SolidColorBrush x:Key="GitExtBadgeRemoteForegroundBrush" Color="#3B2A63" />

            <SolidColorBrush x:Key="GitExtBadgeTagBackgroundBrush" Color="#FCF0D0" />
            <SolidColorBrush x:Key="GitExtBadgeTagBorderBrush" Color="#E0C169" />
            <SolidColorBrush x:Key="GitExtBadgeTagForegroundBrush" Color="#5C4409" />

            <SolidColorBrush x:Key="GitExtBadgeHeadBackgroundBrush" Color="#FBE0DE" />
            <SolidColorBrush x:Key="GitExtBadgeHeadBorderBrush" Color="#E39D98" />
            <SolidColorBrush x:Key="GitExtBadgeHeadForegroundBrush" Color="#6E1F1A" />

            <SolidColorBrush x:Key="GitExtStashBadgeBackgroundBrush" Color="#7D3C98" />
            <SolidColorBrush x:Key="GitExtStashBadgeForegroundBrush" Color="#FFFFFF" />

            <!--
                Dashboard (P12-T03). These values are GitExtensions' own: `DashboardTheme.Light`
                in the source (the palette it links to is paletton.com/#uid=13I0u0k7UUa3cZA5wXlaiQ5cFL3).
                The dashboard is the first thing the user sees; taking the colours from anywhere
                else would make the application look like something other than GitExtensions at
                exactly the moment recognition matters most.
            -->
            <SolidColorBrush x:Key="GitExtDashboardBackgroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="GitExtDashboardLogoBackgroundBrush" Color="#137AD4" />
            <SolidColorBrush x:Key="GitExtDashboardLogoForegroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="GitExtDashboardStartBackgroundBrush" Color="#DBEBF8" />
            <SolidColorBrush x:Key="GitExtDashboardContributeBackgroundBrush" Color="#E6F1FA" />
            <SolidColorBrush x:Key="GitExtDashboardHeaderBackgroundBrush" Color="#ACD0EF" />
            <SolidColorBrush x:Key="GitExtDashboardSearchBackgroundBrush" Color="#F8F8FF" />
            <SolidColorBrush x:Key="GitExtDashboardPrimaryTextBrush" Color="#1E1E1E" />
            <SolidColorBrush x:Key="GitExtDashboardHeadingBrush" Color="#696969" />
            <SolidColorBrush x:Key="GitExtDashboardBranchBrush" Color="#647FD2" />
            <SolidColorBrush x:Key="GitExtDashboardFavouriteBrush" Color="#B8860B" />
            <SolidColorBrush x:Key="GitExtDashboardHoverBrush" Color="#DBEBF8" />
            <SolidColorBrush x:Key="GitExtDashboardFolderBrush" Color="#E0A030" />
            <SolidColorBrush x:Key="GitExtDashboardFolderMissingBrush" Color="#CF222E" />
        </ResourceDictionary>

        <!-- ======================================================================= KOYU -->
        <ResourceDictionary x:Key="Dark">

            <SolidColorBrush x:Key="GitExtBorderBrush" Color="#3D444D" />
            <SolidColorBrush x:Key="GitExtSeparatorBrush" Color="#40A0A0A0" />
            <SolidColorBrush x:Key="GitExtSubtleBackgroundBrush" Color="#20A0A0A0" />
            <SolidColorBrush x:Key="GitExtMutedBrush" Color="#9198A1" />
            <SolidColorBrush x:Key="GitExtAccentBrush" Color="#4493F8" />
            <SolidColorBrush x:Key="GitExtOverlayBrush" Color="#E6161B22" />

            <SolidColorBrush x:Key="GitExtSuccessBrush" Color="#3FB950" />
            <SolidColorBrush x:Key="GitExtDangerBrush" Color="#F85149" />
            <SolidColorBrush x:Key="GitExtAttentionBrush" Color="#D29922" />
            <SolidColorBrush x:Key="GitExtRenameBrush" Color="#AB7DF8" />

            <SolidColorBrush x:Key="GitExtErrorBrush" Color="#FF7B72" />
            <SolidColorBrush x:Key="GitExtErrorBackgroundBrush" Color="#2D1416" />
            <SolidColorBrush x:Key="GitExtErrorBorderBrush" Color="#6E2B28" />
            <SolidColorBrush x:Key="GitExtErrorForegroundBrush" Color="#FFB4AE" />

            <SolidColorBrush x:Key="GitExtWarningBrush" Color="#E3B341" />
            <SolidColorBrush x:Key="GitExtWarningBackgroundBrush" Color="#2B2413" />
            <SolidColorBrush x:Key="GitExtWarningBorderBrush" Color="#6B5A20" />

            <SolidColorBrush x:Key="GitExtDiffAddedBackgroundBrush" Color="#12261E" />
            <SolidColorBrush x:Key="GitExtDiffRemovedBackgroundBrush" Color="#25171C" />
            <SolidColorBrush x:Key="GitExtDiffHunkHeaderBackgroundBrush" Color="#1C2128" />
            <SolidColorBrush x:Key="GitExtDiffGutterBackgroundBrush" Color="#22272E" />
            <SolidColorBrush x:Key="GitExtDiffSelectionBorderBrush" Color="#4493F8" />
            <SolidColorBrush x:Key="GitExtDiffAddedForegroundBrush" Color="#3FB950" />
            <SolidColorBrush x:Key="GitExtDiffRemovedForegroundBrush" Color="#F85149" />
            <SolidColorBrush x:Key="GitExtDiffAddedWordBrush" Color="#1F4B2E" />
            <SolidColorBrush x:Key="GitExtDiffRemovedWordBrush" Color="#5A2027" />

            <SolidColorBrush x:Key="GitExtBadgeBackgroundBrush" Color="#2A2F37" />
            <SolidColorBrush x:Key="GitExtBadgeBorderBrush" Color="#444C56" />
            <SolidColorBrush x:Key="GitExtBadgeForegroundBrush" Color="#D6DBE1" />

            <SolidColorBrush x:Key="GitExtBadgeLocalBackgroundBrush" Color="#132C4A" />
            <SolidColorBrush x:Key="GitExtBadgeLocalBorderBrush" Color="#2A5A8C" />
            <SolidColorBrush x:Key="GitExtBadgeLocalForegroundBrush" Color="#A8CBF0" />

            <SolidColorBrush x:Key="GitExtBadgeRemoteBackgroundBrush" Color="#2A2140" />
            <SolidColorBrush x:Key="GitExtBadgeRemoteBorderBrush" Color="#584A7A" />
            <SolidColorBrush x:Key="GitExtBadgeRemoteForegroundBrush" Color="#C7B7EC" />

            <SolidColorBrush x:Key="GitExtBadgeTagBackgroundBrush" Color="#38300F" />
            <SolidColorBrush x:Key="GitExtBadgeTagBorderBrush" Color="#75651F" />
            <SolidColorBrush x:Key="GitExtBadgeTagForegroundBrush" Color="#E9D48A" />

            <SolidColorBrush x:Key="GitExtBadgeHeadBackgroundBrush" Color="#3A1B1D" />
            <SolidColorBrush x:Key="GitExtBadgeHeadBorderBrush" Color="#7A3733" />
            <SolidColorBrush x:Key="GitExtBadgeHeadForegroundBrush" Color="#FFB4AE" />

            <SolidColorBrush x:Key="GitExtStashBadgeBackgroundBrush" Color="#6B3486" />
            <SolidColorBrush x:Key="GitExtStashBadgeForegroundBrush" Color="#FFFFFF" />

            <!--
                Dashboard, dark (P12-T03). GitExtensions' dark dashboard is built from the system
                control colours, which do not exist here — the values are the same ROLES carried
                over onto the GitHub-dark palette this file already uses: the light theme's blue
                identity survives in the logo strip and in the branch name, the rest goes grey.
                The blue of the light theme cannot be reused as-is: #DBEBF8 on a dark background
                is a white slab.
            -->
            <SolidColorBrush x:Key="GitExtDashboardBackgroundBrush" Color="#0D1117" />
            <SolidColorBrush x:Key="GitExtDashboardLogoBackgroundBrush" Color="#0B3A75" />
            <SolidColorBrush x:Key="GitExtDashboardLogoForegroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="GitExtDashboardStartBackgroundBrush" Color="#161B22" />
            <SolidColorBrush x:Key="GitExtDashboardContributeBackgroundBrush" Color="#1C2128" />
            <SolidColorBrush x:Key="GitExtDashboardHeaderBackgroundBrush" Color="#22272E" />
            <SolidColorBrush x:Key="GitExtDashboardSearchBackgroundBrush" Color="#0D1117" />
            <SolidColorBrush x:Key="GitExtDashboardPrimaryTextBrush" Color="#E6EDF3" />
            <SolidColorBrush x:Key="GitExtDashboardHeadingBrush" Color="#9198A1" />
            <SolidColorBrush x:Key="GitExtDashboardBranchBrush" Color="#79C0FF" />
            <SolidColorBrush x:Key="GitExtDashboardFavouriteBrush" Color="#D29922" />
            <SolidColorBrush x:Key="GitExtDashboardHoverBrush" Color="#30363D" />
            <SolidColorBrush x:Key="GitExtDashboardFolderBrush" Color="#D9A036" />
            <SolidColorBrush x:Key="GitExtDashboardFolderMissingBrush" Color="#F85149" />
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
