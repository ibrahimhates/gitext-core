<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:GitExt.UI.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:GitExt.UI.ViewModels"
             xmlns:model="using:GitExt.Core.Model"
             xmlns:controls="using:GitExt.UI.Controls"
             mc:Ignorable="d"
             d:DesignWidth="700" d:DesignHeight="300"
             x:Class="GitExt.UI.Views.DiffView"
             x:DataType="vm:DiffViewModel">

    <!--
        This view is STANDALONE: it knows nothing about the main window or the commit list.
        The same component is used both in the main window's panel and in the comparison
        window from P04-T16 (the decision came from looking at GitExtensions — it has an
        embedded diff area plus a modeless comparison window as well).
    -->

    <UserControl.Styles>
        <!-- Status letter: the same letters git emits raw, reinforced with colour. -->
        <Style Selector="TextBlock.status">
            <Setter Property="Width" Value="14" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource GitExtMutedBrush}" />
        </Style>
        <Style Selector="TextBlock.status.added">
            <Setter Property="Foreground" Value="{DynamicResource GitExtSuccessBrush}" />
        </Style>
        <Style Selector="TextBlock.status.deleted">
            <Setter Property="Foreground" Value="{DynamicResource GitExtErrorBrush}" />
        </Style>
        <Style Selector="TextBlock.status.renamed">
            <Setter Property="Foreground" Value="{DynamicResource GitExtRenameBrush}" />
        </Style>

        <Style Selector="TextBlock.added-count">
            <Setter Property="Foreground" Value="{DynamicResource GitExtSuccessBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.removed-count">
            <Setter Property="Foreground" Value="{DynamicResource GitExtErrorBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!--
            Line backgrounds. The colours are for the LIGHT theme; they move into the theme
            resource dictionary in Phase 08 (same reason as the badges).
        -->
        <!--
            🔴 MEASURED (P05-T11): the line background COMPLETELY covered `ListBoxItem`'s
            selection highlight — the selection was visible only on context lines, never on
            added or deleted ones. Those are exactly the lines a user selects for partial
            staging; unable to see the selection, the user stages the wrong lines and git
            accepts it (the patch is valid, the content is silently wrong — the finding of
            P05-T04).

            The fix is the line's OWN border: a thick accent on the left edge plus a thin
            top/bottom rule. The border has the SAME thickness on every line (transparent
            when unselected) — otherwise the row height shifts as the selection moves and
            the list jumps.
        -->
        <Style Selector="Border.line">
            <Setter Property="BorderThickness" Value="3,1,0,1" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="ListBoxItem:selected Border.line">
            <Setter Property="BorderBrush" Value="{DynamicResource GitExtDiffSelectionBorderBrush}" />
        </Style>

        <Style Selector="Border.line.added">
            <Setter Property="Background" Value="{DynamicResource GitExtDiffAddedBackgroundBrush}" />
        </Style>
        <Style Selector="Border.line.removed">
            <Setter Property="Background" Value="{DynamicResource GitExtDiffRemovedBackgroundBrush}" />
        </Style>
        <Style Selector="Border.line.hunk">
            <Setter Property="Background" Value="{DynamicResource GitExtDiffHunkHeaderBackgroundBrush}" />
        </Style>

        <!--
            INTRA-line highlighting is now drawn inside `DiffTextPresenter` via
            `Run.Background` (because word wrap does not work in a horizontal panel). The
            colours live there; they must stay consistent with the line backgrounds here.
        -->

        <!--
            Filler: the side with no counterpart in the side-by-side view. It is painted
            DIFFERENTLY from an empty context line — otherwise the user takes a line that
            does not exist for one that does.
        -->
        <Style Selector="Border.line.filler">
            <Setter Property="Background" Value="{DynamicResource GitExtDiffGutterBackgroundBrush}" />
        </Style>

        <Style Selector="TextBlock.gutter">
            <Setter Property="Width" Value="42" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Opacity" Value="0.5" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Padding" Value="0,0,6,0" />
            <!-- When a line wraps the number must stay at the TOP; centred, it drifts to the middle. -->
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

        <!--
            Code lines must be MONOSPACE; previously they used the theme font (proportional)
            and code did not line up. The chain resolves differently per platform: on Linux
            the `monospace` fontconfig alias (which resolves to Noto Sans Mono on this
            machine), Consolas on Windows, Menlo on macOS.
            ⚠️ Not verifiable in a headless test: there every font name falls back to a
            single face (four different names all gave the same width). Checked in a real
            window.
        -->
        <Style Selector="TextBlock.code">
            <Setter Property="FontFamily" Value="{DynamicResource GitExtMonospaceFont}" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

        <!--
            Word wrap is switched on through a single class. `TextWrapping` is NOT
            inherited, so a selector is used instead of binding it on every text element in
            the template; font size, being inherited, is set once on the root element.
        -->
        <Style Selector="Grid.wrap TextBlock.code">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style Selector="TextBlock.dim">
            <Setter Property="Opacity" Value="0.55" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*"
          Classes.wrap="{Binding WordWrap}"
          TextElement.FontSize="{Binding FontSize}">

        <!-- Toolbar: filter + view toggles -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="6,4">
            <TextBox Grid.Column="0"
                     Text="{Binding Filter}"
                     PlaceholderText="{loc:Translate diff.filter_files}"
                     FontSize="12" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="6,0,0,0">
                <ToggleButton IsChecked="{Binding ShowAsTree}"
                              Content="{loc:Translate diff.tree}"
                              FontSize="11"
                              Padding="8,2"
                              ToolTip.Tip="{loc:Translate diff.toggle_between_tree_and_flat_list}" />

                <ToggleButton IsChecked="{Binding ShowSideBySide}"
                              Content="{loc:Translate diff.side_by_side}"
                              FontSize="11"
                              Padding="8,2"
                              ToolTip.Tip="{loc:Translate diff.toggle_between_unified_and_side_by_side_diff}" />

                <!--
                    Display settings (P04-T13). They sit in a flyout so the toolbar does not
                    bloat; each is rarely used but essential when it is needed.
                    ⚠️ They currently live only for the session — persisting them depends on
                    the settings infrastructure (`P08-T14`).
                -->
                <!--
                    Whitespace and context change WHAT GIT PRODUCES, so they sit in their own
                    button; the "View" flyout next to it only changes how the text in hand is
                    drawn. GitExtensions keeps the same split (the first group is in the file
                    viewer's context menu, the display ones on the toolbar).

                    The three levels are GitExtensions' own
                    (`ignoreWhitespaceAtEol` · `ignoreWhitespaceChanges` · `ignoreAllWhitespace`)
                    and they really are three: MEASURED, a line whose whitespace changed INSIDE
                    it is still shown by "at end of line" and dropped by "changes".
                -->
                <Button Name="DiffOptionsButton"
                        Content="{loc:Translate diff.ignore_whitespace}"
                        FontSize="11"
                        Padding="8,2">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuItem Name="WhitespaceNone"
                                      Header="{loc:Translate diff.dont_ignore_whitespace}"
                                      Click="OnWhitespaceNoneClick"
                                      ToggleType="Radio"
                                      IsChecked="{Binding IsWhitespaceIncluded, Mode=OneWay}" />
                            <MenuItem Name="WhitespaceEol"
                                      Header="{loc:Translate diff.ignore_whitespace_at_eol}"
                                      Click="OnWhitespaceEolClick"
                                      ToggleType="Radio"
                                      IsChecked="{Binding IsWhitespaceEolIgnored, Mode=OneWay}" />
                            <MenuItem Name="WhitespaceChange"
                                      Header="{loc:Translate diff.ignore_whitespace_changes}"
                                      Click="OnWhitespaceChangeClick"
                                      ToggleType="Radio"
                                      IsChecked="{Binding IsWhitespaceChangeIgnored, Mode=OneWay}" />
                            <MenuItem Name="WhitespaceAll"
                                      Header="{loc:Translate diff.ignore_all_whitespace}"
                                      Click="OnWhitespaceAllClick"
                                      ToggleType="Radio"
                                      IsChecked="{Binding IsWhitespaceAllIgnored, Mode=OneWay}" />
                            <Separator />
                            <MenuItem Name="MoreContext"
                                      Header="{loc:Translate diff.more_context_lines}"
                                      Click="OnMoreContextClick" />
                            <MenuItem Name="LessContext"
                                      Header="{loc:Translate diff.fewer_context_lines}"
                                      Click="OnLessContextClick" />
                            <MenuItem Name="EntireFile"
                                      Header="{loc:Translate diff.show_entire_file}"
                                      Click="OnEntireFileClick"
                                      ToggleType="CheckBox"
                                      IsChecked="{Binding ShowEntireFile, Mode=OneWay}" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>

                <TextBlock Name="ContextLabel"
                           Text="{Binding ContextLinesLabel}"
                           FontSize="11"
                           Opacity="0.7"
                           VerticalAlignment="Center" />

                <Button Content="{loc:Translate diff.view}" FontSize="11" Padding="8,2">
                    <Button.Flyout>
                        <Flyout Placement="Bottom">
                            <StackPanel Spacing="8" Width="220">
                                <CheckBox IsChecked="{Binding ShowWhitespace}"
                                          Content="{loc:Translate diff.show_whitespace}"
                                          FontSize="12"
                                          ToolTip.Tip="{loc:Translate diff.spaces_shown_as_and_tabs_as}" />

                                <CheckBox IsChecked="{Binding WordWrap}"
                                          Content="{loc:Translate diff.wrap_lines}"
                                          FontSize="12" />

                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{loc:Translate diff.tab_width}"
                                               FontSize="12"
                                               VerticalAlignment="Center" />
                                    <NumericUpDown Value="{Binding TabWidth}"
                                                   Minimum="1"
                                                   Maximum="16"
                                                   Increment="1"
                                                   FormatString="0"
                                                   FontSize="12"
                                                   Width="90" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{loc:Translate diff.size}"
                                               FontSize="12"
                                               VerticalAlignment="Center" />
                                    <NumericUpDown Value="{Binding FontSize}"
                                                   Minimum="8"
                                                   Maximum="28"
                                                   Increment="1"
                                                   FormatString="0"
                                                   FontSize="12"
                                                   Width="90" />
                                </StackPanel>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <!--
                    Search INSIDE the diff (P04-T12). Separate from the file filter: one
                    decides which files are listed, the other where to jump in the selected
                    file.
                -->
                <TextBox Name="LineSearch"
                         Text="{Binding LineSearchText}"
                         PlaceholderText="{loc:Translate diff.search_in_the_diff_ctrl_f}"
                         Width="200"
                         FontSize="12"
                         ToolTip.Tip="{loc:Translate diff.enter_f3_for_next_shift_enter_shift_f3_for_p}" />
            </StackPanel>
        </Grid>

        <!-- Loading / error / empty states -->
        <ProgressBar Grid.Row="0"
                     IsIndeterminate="True"
                     Height="2"
                     VerticalAlignment="Bottom"
                     IsVisible="{Binding IsLoading}" />

        <TextBlock Grid.Row="1"
                   ZIndex="1"
                   Text="{Binding ErrorMessage}"
                   IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}"
                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                   TextWrapping="Wrap"
                   Margin="8"
                   VerticalAlignment="Top" />

        <!-- When a search finds nothing, it does not stay silent (P04-T12). -->
        <TextBlock Grid.Row="0"
                   Text="{Binding LineSearchStatus}"
                   IsVisible="{Binding LineSearchStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   Foreground="{DynamicResource SystemFillColorCautionBrush}"
                   FontSize="11"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   Margin="0,0,8,-14"
                   ZIndex="1" />

        <TextBlock Grid.Row="1"
                   Text="{loc:Translate diff.this_commit_did_not_change_any_files}"
                   IsVisible="{Binding IsEmpty}"
                   Opacity="0.65"
                   FontSize="12"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />

        <!-- Lower area: file list on the left, the selected file's diff on the right. -->
        <!--
            The file list column can be hidden (P05-T09): in the working directory view the
            list sits on the left in a separate component. With width `Auto`, a hidden column
            takes up no space.
        -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*">

        <!-- Flat list -->
        <ListBox Grid.Column="0"
                 Name="FileList"
                 Width="260"
                 ItemsSource="{Binding Files}"
                 SelectedIndex="{Binding SelectedIndex}"
                 IsVisible="{Binding ShowFlatFileList}"
                 Background="Transparent"
                 BorderThickness="0">

            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="4,1" />
                    <Setter Property="MinHeight" Value="22" />
                </Style>
            </ListBox.Styles>

            <ListBox.ItemTemplate>
                <DataTemplate DataType="vm:FileChangeRow">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" Height="20">
                        <TextBlock Grid.Column="0"
                                   Classes="status"
                                   Classes.added="{Binding IsAdded}"
                                   Classes.deleted="{Binding IsDeleted}"
                                   Classes.renamed="{Binding IsRenamed}"
                                   Text="{Binding StatusLetter}" />

                        <!-- The flat list shows the FULL path; the tree view splits off the folder. -->
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Path}"
                                   FontSize="12"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"
                                   ToolTip.Tip="{Binding RenamedFrom}" />

                        <!-- For binary and very large files, a label instead of a count. -->
                        <TextBlock Grid.Column="2"
                                   Classes="dim"
                                   Text="{loc:Translate diff.binary}"
                                   IsVisible="{Binding IsBinary}"
                                   Margin="6,0" />

                        <TextBlock Grid.Column="2"
                                   Classes="dim"
                                   Text="{loc:Translate diff.too_large}"
                                   IsVisible="{Binding IsTooLarge}"
                                   Margin="6,0" />

                        <!--
                            The space on the right is for the scrollbar: without it the last
                            character of a "−12" count sat underneath the bar (seen in a
                            render).
                        -->
                        <StackPanel Grid.Column="3"
                                    Orientation="Horizontal"
                                    Spacing="6"
                                    IsVisible="{Binding HasLineCounts}"
                                    Margin="6,0,10,0">
                            <TextBlock Classes="added-count"
                                       Text="{Binding AddedLines, StringFormat='+{0}'}" />
                            <TextBlock Classes="removed-count"
                                       Text="{Binding RemovedLines, StringFormat='−{0}'}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Tree -->
        <TreeView Grid.Column="0"
                  Name="FileTree"
                  Width="260"
                  ItemsSource="{Binding Tree}"
                  IsVisible="{Binding ShowTreeFileList}"
                  Background="Transparent"
                  BorderThickness="0">
            <TreeView.ItemTemplate>
                <TreeDataTemplate DataType="vm:FileTreeNode" ItemsSource="{Binding Children}">
                    <Grid ColumnDefinitions="Auto,*,Auto" Height="20">
                        <TextBlock Grid.Column="0"
                                   Classes="status"
                                   Classes.added="{Binding File.IsAdded, FallbackValue=False}"
                                   Classes.deleted="{Binding File.IsDeleted, FallbackValue=False}"
                                   Classes.renamed="{Binding File.IsRenamed, FallbackValue=False}"
                                   Text="{Binding File.StatusLetter, FallbackValue=''}"
                                   IsVisible="{Binding !IsFolder}" />

                        <TextBlock Grid.Column="1"
                                   Text="{Binding Name}"
                                   FontSize="12"
                                   VerticalAlignment="Center" />

                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    Spacing="6"
                                    IsVisible="{Binding File.HasLineCounts, FallbackValue=False}"
                                    Margin="8,0,0,0">
                            <TextBlock Classes="added-count"
                                       Text="{Binding File.AddedLines, StringFormat='+{0}'}" />
                            <TextBlock Classes="removed-count"
                                       Text="{Binding File.RemovedLines, StringFormat='−{0}'}" />
                        </StackPanel>
                    </Grid>
                </TreeDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>

            <GridSplitter Grid.Column="1"
                          IsVisible="{Binding ShowFileList}"
                          Width="4"
                          ResizeDirection="Columns"
                          Background="{DynamicResource SystemControlForegroundBaseLowBrush}" />

            <!--
                Unified diff. A VIRTUALISED ListBox: hunk headers and content lines flow in
                one flat list. A grouped structure would mean creating a control per line
                (same reasoning as the commit list in Phase 03).
            -->
            <ListBox Grid.Column="2"
                     Name="DiffLines"
                     ItemsSource="{Binding Lines}"
                     IsVisible="{Binding ShowUnifiedLines}"
                     SelectionMode="Multiple"
                     Background="Transparent"
                     BorderThickness="0">

                <!--
                    DIFF CONTEXT MENU ═ the item order was taken verbatim from
                    GitExtensions' `FileViewer` `contextMenu` (P05-T10):

                      stage selected lines · unstage selected lines · reset selected lines ·
                      copy · copy patch · copy new version · copy old version · separator ·
                      display options…

                    ⚠️ Stage and unstage are MUTUALLY EXCLUSIVE: in GitExtensions stage
                    appears only on the working tree side, unstage only on the index side.
                    Unimplemented commands are not removed, they stay disabled (§ 9).
                -->
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Name="StageLinesMenuItem"
                                  Header="{loc:Translate diff.stage_selected_lines}"
                                  IsEnabled="{Binding CanStageSelection}"
                                  Click="OnStageLinesClick" />

                        <MenuItem Name="UnstageLinesMenuItem"
                                  Header="{loc:Translate diff.revert_selected_lines}"
                                  IsEnabled="{Binding CanUnstageSelection}"
                                  Click="OnUnstageLinesClick" />

                        <MenuItem Name="ResetLinesMenuItem"
                                  Header="{loc:Translate diff.reset_selected_lines}"
                                  IsEnabled="{Binding CanDiscardSelection}"
                                  Click="OnResetLinesClick" />

                        <MenuItem Header="{loc:Translate diff.copy}" Click="OnCopyCodeClick" />
                        <MenuItem Header="{loc:Translate diff.copy_as_patch}" Click="OnCopyPatchClick" />
                        <MenuItem Header="{loc:Translate diff.copy_new_version}" Click="OnCopyNewClick" />
                        <MenuItem Header="{loc:Translate diff.copy_old_version}" Click="OnCopyOldClick" />

                        <!--
                            GitExtensions puts the context and whitespace items in this menu, in
                            this order (`FileViewer.Designer.cs`): increase - decrease - show
                            entire file - ... - ignore at eol - ignore changes - ignore all.
                            They are the same commands the toolbar button carries; a second path
                            would be a second place to forget the re-read.
                        -->
                        <Separator />
                        <MenuItem Name="MenuMoreContext"
                                  Header="{loc:Translate diff.more_context_lines}"
                                  Click="OnMoreContextClick" />
                        <MenuItem Name="MenuLessContext"
                                  Header="{loc:Translate diff.fewer_context_lines}"
                                  Click="OnLessContextClick" />
                        <MenuItem Name="MenuEntireFile"
                                  Header="{loc:Translate diff.show_entire_file}"
                                  Click="OnEntireFileClick"
                                  ToggleType="CheckBox"
                                  IsChecked="{Binding ShowEntireFile, Mode=OneWay}" />
                        <MenuItem Name="MenuWhitespaceEol"
                                  Header="{loc:Translate diff.ignore_whitespace_at_eol}"
                                  Click="OnWhitespaceEolClick"
                                  ToggleType="CheckBox"
                                  IsChecked="{Binding IsWhitespaceEolIgnored, Mode=OneWay}" />
                        <MenuItem Name="MenuWhitespaceChange"
                                  Header="{loc:Translate diff.ignore_whitespace_changes}"
                                  Click="OnWhitespaceChangeClick"
                                  ToggleType="CheckBox"
                                  IsChecked="{Binding IsWhitespaceChangeIgnored, Mode=OneWay}" />
                        <MenuItem Name="MenuWhitespaceAll"
                                  Header="{loc:Translate diff.ignore_all_whitespace}"
                                  Click="OnWhitespaceAllClick"
                                  ToggleType="CheckBox"
                                  IsChecked="{Binding IsWhitespaceAllIgnored, Mode=OneWay}" />
                    </ContextMenu>
                </ListBox.ContextMenu>


                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="MinHeight" Value="18" />
                    </Style>
                </ListBox.Styles>

                <ListBox.ItemTemplate>
                    <DataTemplate DataType="vm:DiffLineRow">
                        <Border Classes="line"
                                Classes.added="{Binding IsAdded}"
                                Classes.removed="{Binding IsRemoved}"
                                Classes.hunk="{Binding IsHunkHeader}">
                            <!-- The height is NOT FIXED: with word wrap on, a row must be able to grow. -->
                            <Grid ColumnDefinitions="Auto,Auto,*" MinHeight="18">
                                <TextBlock Grid.Column="0"
                                           Classes="gutter"
                                           Text="{Binding OldLineNumber}" />

                                <TextBlock Grid.Column="1"
                                           Classes="gutter"
                                           Text="{Binding NewLineNumber}" />

                                <!--
                                    A line is always drawn from SEGMENTS; when no intra-line
                                    diff was computed, a single segment arrives.
                                    ⚠️ Segments are drawn as `Run`s inside ONE TextBlock: word
                                    wrap DOES NOT WORK in a horizontal StackPanel (measured).
                                -->
                                <TextBlock Grid.Column="2"
                                           Classes="code"
                                           controls:DiffTextPresenter.Segments="{Binding Segments}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!--
                Side-by-side diff (P04-T10). ONE virtualised list with two columns per row —
                chosen over synchronising the scroll of two separate lists: that way the
                synchronised-scrolling problem never arises at all, and the two sides' lines
                stay structurally aligned.

                The alignment is produced by `SideBySideDiff` (the core layer) and uses the
                SAME mapping as the intra-line highlighting.
            -->
            <ListBox Grid.Column="2"
                     Name="SideDiffLines"
                     ItemsSource="{Binding SideLines}"
                     IsVisible="{Binding ShowSideLines}"
                     SelectionMode="Multiple"
                     Background="Transparent"
                     BorderThickness="0">

                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="MinHeight" Value="18" />
                    </Style>
                </ListBox.Styles>

                <ListBox.ItemTemplate>
                    <DataTemplate DataType="vm:SideBySideLineRow">
                        <Grid ColumnDefinitions="*,1,*" MinHeight="18">

                            <!-- The hunk header spans both columns. -->
                            <Border Grid.Column="0" Grid.ColumnSpan="3"
                                    Classes="line hunk"
                                    IsVisible="{Binding IsHunkHeader}">
                                <TextBlock Classes="code"
                                           Text="{Binding Header}"
                                           Margin="6,0,0,0" />
                            </Border>

                            <!-- Left: the old state -->
                            <Border Grid.Column="0"
                                    Classes="line"
                                    Classes.removed="{Binding Left.IsRemoved}"
                                    Classes.filler="{Binding Left.IsFiller}"
                                    IsVisible="{Binding !IsHunkHeader}">
                                <Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Grid.Column="0"
                                               Classes="gutter"
                                               Text="{Binding Left.OldLineNumber}" />

                                    <TextBlock Grid.Column="1"
                                               Classes="code"
                                               controls:DiffTextPresenter.Segments="{Binding Left.Segments}" />
                                </Grid>
                            </Border>

                            <Border Grid.Column="1"
                                    Background="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                    IsVisible="{Binding !IsHunkHeader}" />

                            <!-- Right: the new state -->
                            <Border Grid.Column="2"
                                    Classes="line"
                                    Classes.added="{Binding Right.IsAdded}"
                                    Classes.filler="{Binding Right.IsFiller}"
                                    IsVisible="{Binding !IsHunkHeader}">
                                <Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Grid.Column="0"
                                               Classes="gutter"
                                               Text="{Binding Right.NewLineNumber}" />

                                    <TextBlock Grid.Column="1"
                                               Classes="code"
                                               controls:DiffTextPresenter.Segments="{Binding Right.Segments}" />
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- When there is no content, WHY is stated; leaving a blank area looks like a bug. -->
            <TextBlock Grid.Column="2"
                       Text="{Binding ContentNotice}"
                       IsVisible="{Binding ContentNotice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       Opacity="0.65"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="12"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </Grid>
    </Grid>
</UserControl>
