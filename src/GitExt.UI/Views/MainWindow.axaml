<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:GitExt.UI.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:GitExt.UI.ViewModels"
        xmlns:views="using:GitExt.UI.Views"
        mc:Ignorable="d"
        d:DesignWidth="1000" d:DesignHeight="600"
        x:Class="GitExt.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{loc:Translate main.gitext_core}"
        Width="1000" Height="600"
        MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        DragDrop.AllowDrop="True">

    <Grid RowDefinitions="Auto,Auto,*">

        <!--
            MAIN MENU — the order and item names were taken from GitExtensions (P08-T26):
            Start · Dashboard · Repository · Commands · Tools · Help.
            (We have no Plugins and no "Repository hosts".)

            ⚠️ Commands that are not implemented yet are NOT REMOVED, they stay in place with
            `IsEnabled="False"`. The user's rule: someone used to GitExtensions must find the same
            item in the same place; slotting one in later breaks the order.
        -->
        <Menu Grid.Row="0" Name="MainMenu">

            <MenuItem Header="{loc:Translate main.start}">
                <MenuItem Name="MenuCreateRepository" Header="{loc:Translate main.create_new_repository}" IsEnabled="False" />
                <MenuItem Name="MenuOpen" Header="{loc:Translate main.open}" />
                <MenuItem Name="MenuClone" Header="{loc:Translate main.c_lone_repository}" IsEnabled="False" />
                <Separator />
                <MenuItem Name="MenuRecentRepositories"
                          Header="{loc:Translate main.recent_repositories}"
                          ItemsSource="{Binding RecentRepositories}">
                    <MenuItem.ItemTemplate>
                        <DataTemplate DataType="vm:RecentRepositoryItem">
                            <TextBlock Text="{Binding Path}" />
                        </DataTemplate>
                    </MenuItem.ItemTemplate>
                    <MenuItem.Styles>
                        <Style Selector="MenuItem > MenuItem" x:DataType="vm:RecentRepositoryItem">
                            <Setter Property="Command" Value="{Binding OpenCommand}" />
                            <Setter Property="CommandParameter" Value="{Binding Path}" />
                        </Style>
                    </MenuItem.Styles>
                </MenuItem>
                <Separator />
                <MenuItem Name="MenuExit" Header="{loc:Translate main.e_xit}" />
            </MenuItem>

            <MenuItem Header="{loc:Translate main.dashboard}">
                <MenuItem Name="MenuDashboardRefresh"
                          Header="{loc:Translate main.refresh}"
                          Command="{Binding RefreshCommand}" />
            </MenuItem>

            <MenuItem Header="{loc:Translate main.repository}" IsEnabled="{Binding HasRepository}">
                <!--
                    🔴 The `InputGesture="F5"` that was here has been REMOVED. Measured in
                    P08-T00/M03: `InputGesture` does not run the command, it only draws the label —
                    so F5 was a dead key. Both the label and the real binding now come from the
                    command registry (GlobalShortcuts).
                -->
                <MenuItem Name="MenuRepositoryRefresh" Header="{loc:Translate main.refresh}" />
                <MenuItem Name="MenuFileExplorer" Header="{loc:Translate main.file_explorer}" IsEnabled="False" />
                <Separator />
                <MenuItem Name="MenuRemotes" Header="{loc:Translate main.remotes}" />
                <Separator />
                <MenuItem Name="MenuSubmodules" Header="{loc:Translate main.ma_nage_submodules}" IsEnabled="False" />
                <MenuItem Name="MenuWorktrees" Header="{loc:Translate main.manage_worktrees}" IsEnabled="False" />
                <Separator />
                <MenuItem Name="MenuEditGitignore" Header="{loc:Translate main.edit_git_ignore}" IsEnabled="False" />
                <MenuItem Name="MenuRepositorySettings" Header="{loc:Translate main.repository_setti_ngs}" IsEnabled="False" />
                <Separator />
                <MenuItem Name="MenuCloseRepository" Header="{loc:Translate main.close_back_to_dashboard}" />
            </MenuItem>

            <MenuItem Header="{loc:Translate main.commands}" IsEnabled="{Binding HasRepository}">
                <!-- Faz 05 -->
                <MenuItem Name="MenuCommit" Header="{loc:Translate main.commit}" />
                <MenuItem Name="MenuUndoLastCommit" Header="{loc:Translate main.undo_last_commit}" IsEnabled="False" />
                <!-- Faz 06 -->
                <MenuItem Name="MenuPull" Header="{loc:Translate main.pull_fetch}" />
                <MenuItem Name="MenuPush" Header="{loc:Translate main.push}" />
                <Separator />
                <MenuItem Name="MenuStashes" Header="{loc:Translate main.ma_nage_stashes}" />
                <MenuItem Name="MenuResetChanges" Header="{loc:Translate main.reset_changes}" IsEnabled="False" />
                <Separator />
                <MenuItem Name="MenuCreateBranch" Header="{loc:Translate main.create_branch}" />
                <MenuItem Name="MenuDeleteBranch" Header="{loc:Translate main.de_lete_branch}" />
                <MenuItem Name="MenuCheckoutBranch" Header="{loc:Translate main.chec_k_out_branch}" />
                <MenuItem Name="MenuMerge" Header="{loc:Translate main.merge_branches}" />
                <MenuItem Name="MenuRebase" Header="{loc:Translate main.r_ebase}" />
                <Separator />
                <MenuItem Name="MenuCreateTag" Header="{loc:Translate main.crea_te_tag}" IsEnabled="False" />
                <MenuItem Name="MenuDeleteTag" Header="{loc:Translate main.de_lete_tag}" IsEnabled="False" />
                <Separator />
                <!-- Faz 07 -->
                <MenuItem Name="MenuCherryPick" Header="{loc:Translate main.cherr_y_pick}" />
                <MenuItem Name="MenuCheckoutRevision" Header="{loc:Translate main.check_out_revision}" IsEnabled="False" />
                <MenuItem Name="MenuRevert" Header="{loc:Translate main.re_vert_commit}" />
                <MenuItem Name="MenuResetToCommit" Header="{loc:Translate main.re_set_to_this_commit}" />
                <MenuItem Name="MenuBisect" Header="{loc:Translate main.b_isect}" IsEnabled="False" />
                <MenuItem Name="MenuReflog" Header="{loc:Translate main.show_reflo_g}" />
            </MenuItem>

            <MenuItem Header="{loc:Translate main.tools}">
                <MenuItem Name="MenuCommandLog" Header="{loc:Translate main.git_command_log}" />
                <Separator />
                <MenuItem Name="MenuSettings" Header="{loc:Translate main.setti_ngs}" IsEnabled="False" />
            </MenuItem>

            <MenuItem Header="{loc:Translate main.help}">
                <MenuItem Name="MenuAbout" Header="{loc:Translate main.about}" />
            </MenuItem>
        </Menu>

        <Border Grid.Row="1"
                Padding="10,7"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">

            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock Grid.Column="0"
                           Text="{Binding Subtitle}"
                           FontSize="12"
                           Opacity="0.75"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />

                <!--
                    Loading indicator and cancel (P03-T17). In a very large repository the user may
                    realise they opened the wrong folder; they must not have to wait for it to
                    finish.
                -->
                <TextBlock Grid.Column="1"
                           Text="{Binding Commits.LoadedCountText}"
                           IsVisible="{Binding Commits.IsLoading}"
                           FontSize="12"
                           Opacity="0.7"
                           VerticalAlignment="Center"
                           Margin="8,0" />

                <Button Grid.Column="2"
                        Content="{loc:Translate main.cancel}"
                        Command="{Binding CancelLoadingCommand}"
                        IsVisible="{Binding Commits.IsLoading}"
                        FontSize="11"
                        Padding="8,2" />
            </Grid>
        </Border>

        <!--
            The branch operation strip (P06-T01). A strip rather than a modal "OK" box — same
            reasoning as the reset strip in P05-T15: a dialog shown AFTER the operation is nothing
            but an obstacle waiting to be dismissed. Errors go here too; not raw stderr, but the
            classified message.
        -->
        <Border Grid.Row="2"
                Name="BranchNoticeBar"
                VerticalAlignment="Top"
                IsVisible="{Binding BranchNotice, Converter={x:Static ObjectConverters.IsNotNull}}"
                Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                BorderThickness="1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                CornerRadius="3"
                Padding="8,5"
                Margin="10,6"
                ZIndex="10">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           Name="BranchNoticeText"
                           Text="{Binding BranchNotice}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           FontSize="12" />

                <Button Grid.Column="1"
                        Name="DismissBranchNoticeButton"
                        Content="✕"
                        FontSize="12"
                        Margin="4,0,0,0"
                        Click="OnDismissBranchNoticeClick" />
            </Grid>
        </Border>

        <!--
            The detached HEAD and in-progress operation strips (P06-T04). The two are MUTUALLY
            EXCLUSIVE: it was measured that during a rebase or a bisect HEAD really is detached;
            showing both strips would tell the user "you are both detached and mid-rebase", and
            "create a branch here" is not the thing to do at that point.
        -->
        <Border Grid.Row="2"
                Name="DetachedBanner"
                VerticalAlignment="Top"
                IsVisible="{Binding ShowDetachedBanner}"
                Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                BorderThickness="1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                CornerRadius="3"
                Padding="8,5"
                Margin="10,6"
                ZIndex="9">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           Name="DetachedText"
                           Text="{loc:Translate main.detached_head_you_are_not_on_a_branch_commit}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           FontSize="12" />

                <Button Grid.Column="1"
                        Name="DetachedCreateBranchButton"
                        Content="{loc:Translate main.create_branch_from_here}"
                        FontSize="12"
                        Margin="8,0,0,0"
                        Command="{Binding CreateBranchCommand}" />
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Name="OperationBanner"
                VerticalAlignment="Top"
                IsVisible="{Binding ShowOperationBanner}"
                Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                BorderThickness="1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                CornerRadius="3"
                Padding="8,5"
                Margin="10,6"
                ZIndex="9">
            <!--
                P07-T11: the way out of EVERY half-finished operation comes from the same strip.
                In P06-T12 only merge was offered, because aborting the others takes different
                commands. In Phase 07 IConflictResolver picks the right verb FROM THE STATE FILES,
                so rebase/cherry-pick/revert can be aborted from here as well.
                Bisect is left out: it has no abort, and its "reset" is a different thing entirely.
            -->
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock Name="OperationText"
                           Grid.Column="0"
                           Text="{Binding OperationText}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           FontSize="12" />
                <Button Name="ResolveConflictsButton"
                        Grid.Column="1"
                        Content="{loc:Translate main.resolve_conflicts}"
                        Margin="8,0,0,0"
                        IsVisible="{Binding CanResolveConflicts}"
                        Command="{Binding ResolveConflictsCommand}" />
                <Button Name="AbortOperationButton"
                        Grid.Column="2"
                        Content="{loc:Translate main.cancel_the_operation}"
                        Margin="8,0,0,0"
                        IsVisible="{Binding CanAbortOperation}"
                        Command="{Binding AbortOperationCommand}" />
            </Grid>
        </Border>

        <!-- With no repository open, the welcome screen; rather than an empty window, a way forward. -->
        <views:WelcomeView Grid.Row="2" IsVisible="{Binding ShowWelcome}" />

        <!--
            List on top, details below — GitExtensions' layout. The splitter is draggable; with a
            fixed-height details panel, long commit messages would be unreadable.
        -->
        <!--
            P06-T13: the branch panel is on the LEFT with a draggable splitter — the same place as
            GitExtensions' RepoObjectsTree (§ 9).
        -->
        <Grid Grid.Row="2"
              Name="MainSplitGrid"
              ColumnDefinitions="220,4,*"
              IsVisible="{Binding !ShowWelcome}">

            <!--
                Focus ring (P08-T05): the focused panel's border is highlighted. Without an
                indicator, keyboard navigation is useless — the user cannot see where their
                keystrokes are going.
            -->
            <Border Grid.Column="0" Name="BranchPanelHost" Classes="panel" MinWidth="120">
                <views:RefTreeView Name="BranchPanel" DataContext="{Binding RefTree}" />
            </Border>

            <GridSplitter Name="BranchPanelSplitter"
                          Grid.Column="1"
                          Width="4"
                          ResizeDirection="Columns"
                          Background="{DynamicResource GitExtSeparatorBrush}" />

        <Grid Grid.Column="2"
              Name="RightSplitGrid"
              RowDefinitions="*,4,220">

            <Border Grid.Row="0" Classes="panel">
                <views:CommitListView Name="CommitList" DataContext="{Binding Commits}" />
            </Border>

            <!-- Repository open but no commits at all: a fresh `git init`. Not a blank screen, an explanation. -->
            <Border Grid.Row="0"
                    IsVisible="{Binding Commits.IsEmptyRepository}"
                    Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
                    <TextBlock Text="{loc:Translate main.no_commits_in_this_repository_yet}"
                               FontSize="14"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{loc:Translate main.history_will_appear_here_once_the_first_comm}"
                               FontSize="12"
                               Opacity="0.65"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <GridSplitter Grid.Row="1"
                          Name="BottomPanelSplitter"
                          Height="4"
                          ResizeDirection="Rows"
                          Background="{DynamicResource GitExtSeparatorBrush}"
                          IsVisible="{Binding Commits.Details.HasCommit}" />

            <!--
                The lower area is tabbed: details and changed files. GitExtensions' layout is the
                same (grid on top, tabbed area below). Because the diff component is standalone,
                the same one will also be used in P04-T16's separate window.
            -->
            <TabControl Grid.Row="2"
                        Name="BottomPanel"
                        MinHeight="80"
                        Padding="0"
                        IsVisible="{Binding Commits.Details.HasCommit}">

                <TabItem Header="{loc:Translate main.details}" FontSize="12">
                    <Border Classes="panel">
                        <views:CommitDetailsView Name="Details" DataContext="{Binding Commits.Details}" />
                    </Border>
                </TabItem>

                <TabItem Header="{loc:Translate main.changes}" FontSize="12">
                    <Border Classes="panel">
                        <views:DiffView Name="ChangesDiff" DataContext="{Binding Commits.Diff}" />
                    </Border>
                </TabItem>
            </TabControl>
        </Grid>
        </Grid>
    </Grid>
</Window>
