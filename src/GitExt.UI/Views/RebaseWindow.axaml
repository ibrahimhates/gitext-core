<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GitExt.UI.ViewModels"
        x:Class="GitExt.UI.Views.RebaseWindow"
        x:DataType="vm:RebaseViewModel"
        Title="Rebase" Width="820" Height="600"
        WindowStartupLocation="CenterOwner">

  <!-- GitExtensions FormRebase (§ 9): üstte hedef, ortada todo listesi, altta eylemler. -->
  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="12">

    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6">
      <TextBlock Text="Rebase onto" VerticalAlignment="Center" />
      <TextBox Name="UpstreamBox" Width="220" Text="{Binding Upstream}" />
      <CheckBox Name="InteractiveBox" Content="Interactive" IsChecked="{Binding IsInteractive}" />
      <CheckBox Name="AutoStashBox" Content="Autostash" IsChecked="{Binding AutoStash}" />
    </StackPanel>

    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" Margin="0,8,0,6"
                IsVisible="{Binding IsInteractive}">
      <Button Name="MoveUpButton" Content="Move up" Command="{Binding MoveUpCommand}" />
      <Button Name="MoveDownButton" Content="Move down" Command="{Binding MoveDownCommand}" />
      <TextBlock VerticalAlignment="Center" Opacity="0.6" FontSize="11"
                 Text="Steps run top to bottom. Drag to reorder." />
    </StackPanel>

    <ListBox Grid.Row="2" Name="StepList"
             ItemsSource="{Binding Steps}" SelectedItem="{Binding Selected}"
             IsVisible="{Binding IsInteractive}">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:RebaseStepViewModel">
          <Grid ColumnDefinitions="110,80,*" >
            <ComboBox Grid.Column="0" Name="ActionBox" Width="100"
                      ItemsSource="{x:Static vm:RebaseStepViewModel.Actions}"
                      SelectedItem="{Binding Action}" />
            <TextBlock Grid.Column="1" Text="{Binding ShortId}" FontFamily="monospace"
                       VerticalAlignment="Center" Margin="6,0" />
            <TextBlock Grid.Column="2" Text="{Binding Subject}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <StackPanel Grid.Row="3" Margin="0,10,0,0" Spacing="6">
      <TextBlock Name="ValidationLabel" Text="{Binding ValidationError}" Foreground="#b9770e"
                 TextWrapping="Wrap"
                 IsVisible="{Binding ValidationError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <TextBlock Name="CommandLabel" FontFamily="monospace" FontSize="11" Opacity="0.7"
                 Text="{Binding CommandLine}" />
      <TextBlock Name="ResultLabel" Text="{Binding Result}" TextWrapping="Wrap"
                 IsVisible="{Binding Result, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <TextBlock Name="ErrorLabel" Text="{Binding Error}" Foreground="#c0392b" TextWrapping="Wrap"
                 IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
        <Button Name="RunButton" Content="Rebase" Command="{Binding RunCommand}" IsDefault="True" />
        <Button Name="CancelButton" Content="Close" Click="OnClose" IsCancel="True" />
      </StackPanel>
    </StackPanel>
  </Grid>
</Window>
