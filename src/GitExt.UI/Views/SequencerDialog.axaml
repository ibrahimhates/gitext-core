<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:GitExt.UI.Localization"
        xmlns:vm="using:GitExt.UI.ViewModels"
        x:Class="GitExt.UI.Views.SequencerDialog"
        x:DataType="vm:SequencerViewModel"
        Title="{Binding Title}" Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner">

  <StackPanel Margin="16" Spacing="10">

    <TextBlock Name="SummaryLabel" Text="{Binding Summary}" FontWeight="Bold" />

    <CheckBox Name="NoCommitBox" Content="{loc:Translate sequencer.stage_the_changes_without_committing}"
              IsChecked="{Binding NoCommit}" />

    <CheckBox Name="RecordOriginBox" Content="{loc:Translate sequencer.record_the_source_commit_in_the_message_x}"
              IsChecked="{Binding RecordOrigin}"
              IsVisible="{Binding SupportsRecordOrigin}" />

    <!--
      Choosing a parent is MANDATORY on a merge commit: measured, without -m it gives rc=128
      ("is a merge but no -m option was given").
    -->
    <StackPanel Name="MainlinePanel" Spacing="4" IsVisible="{Binding IsMergeCommit}">
      <TextBlock Text="{loc:Translate sequencer.this_is_a_merge_commit_which_parent_is_the_m}" TextWrapping="Wrap" />
      <NumericUpDown Name="MainlineBox" Minimum="1" Increment="1"
                     Maximum="{Binding ParentCount}"
                     Value="{Binding MainlineParent}" />
    </StackPanel>

    <TextBlock Name="CommandLabel" FontFamily="{DynamicResource GitExtMonospaceFont}" FontSize="11" Opacity="0.7"
               Text="{Binding CommandLine}" TextWrapping="Wrap" />

    <TextBlock Name="ResultLabel" Text="{Binding Result}" TextWrapping="Wrap"
               IsVisible="{Binding Result, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    <TextBlock Name="ErrorLabel" Text="{Binding Error}" Foreground="{DynamicResource GitExtErrorBrush}" TextWrapping="Wrap"
               IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
      <Button Name="RunButton" Content="{loc:Translate sequencer.run}" Command="{Binding RunCommand}" IsDefault="True" />
      <Button Name="CancelButton" Content="{loc:Translate sequencer.close}" Click="OnClose" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>
