<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:GitExt.UI.Localization"
        x:Class="GitExt.UI.Views.CheckoutBranchDialog"
        Title="{loc:Translate checkout_branch.switch_branch}"
        Width="540"
        SizeToContent="Height"
        MinHeight="200"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <!--
        Yerleşim GitExtensions `FormCheckoutBranch.Designer.cs`'ten (§ 9).
        `flpnlLocalOptions` sırası: rbDontChange, rbMerge, rbStash, rbReset.
        Düğme: cmdOk metni "Checkout".

        "Yerel değişiklikler" grubu yalnızca kirli ağaçta gösteriliyor: temiz ağaçta
        dört seçeneğin hepsi aynı şeyi yapar ve kullanıcıya anlamsız bir karar sordurur.
    -->
    <StackPanel Margin="16" Spacing="10">

        <StackPanel Spacing="4">
            <TextBlock Name="TargetLabel" Text="{loc:Translate checkout_branch.branch_to_switch_to}" />
            <TextBox Name="TargetText" IsReadOnly="True" IsTabStop="False" />
        </StackPanel>

        <TextBlock Name="DetachWarning"
                   FontSize="11"
                   TextWrapping="Wrap"
                   IsVisible="False"
                   Opacity="0.85"
                   Text="{loc:Translate checkout_branch.this_is_not_a_branch_but_a_commit_after_chec}" />

        <StackPanel Name="LocalChangesGroup" Spacing="4" IsVisible="False">
            <TextBlock Text="{loc:Translate checkout_branch.local_changes}" FontWeight="SemiBold" />

            <RadioButton Name="KeepOption" GroupName="LocalChanges" IsChecked="True"
                         Content="{loc:Translate checkout_branch.leave_alone}" />
            <RadioButton Name="MergeOption" GroupName="LocalChanges"
                         Content="{loc:Translate checkout_branch.merge}" />
            <RadioButton Name="StashOption" GroupName="LocalChanges"
                         Content="{loc:Translate checkout_branch.stash_including_untracked_files}" />
            <RadioButton Name="DiscardOption" GroupName="LocalChanges"
                         Content="{loc:Translate checkout_branch.reset_discard_local_changes}" />

            <TextBlock Name="ActionHint"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Opacity="0.85"
                       Margin="0,2,0,0" />
        </StackPanel>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8">
            <Button Name="CancelButton" Content="{loc:Translate checkout_branch.cancel}" MinWidth="90" IsCancel="True" Click="OnCancelClick" />
            <Button Name="CheckoutButton" Content="{loc:Translate checkout_branch.switch}" MinWidth="90" IsDefault="True" Click="OnCheckoutClick" />
        </StackPanel>
    </StackPanel>
</Window>
