<Project>

  <!-- Tüm projeler için ortak ayarlar. Bkz. ADR-0006. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Uyarı birikmesini ilk günden engelle (P01-T07). Sonradan açmak pratikte hiç yapılmaz. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>

    <!--
      Bağımlılık ağacını sabitle (ADR-0006). Lock dosyaları commit'lenir.

      Koşul ÖNEMLİ: RID belirtilen restore'lar (publish -r linux-x64 gibi) lock dosyasına
      RID'e özgü girdiler ve trimming'in ILLink.Tasks'ı gibi ek paketler yazar. Bu, sonraki
      RID'siz kilitli restore çağrısını NU1004 ile kırar.
      Lock dosyalarını yalnızca RID'siz restore üretsin/doğrulasın; publish onlara dokunmasın.
    -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>

    <!--
      RID'li restore'ları ayrı bir lock dosyasına yönlendir.
      NuGet, packages.lock.json diskte varsa RestorePackagesWithLockFile'dan bağımsız olarak
      onu günceller; bu yüzden koşullu kapatmak yetmez. Yolu obj/ altına taşımak, publish'in
      commit'lenen lock dosyasına dokunmasını engeller (obj/ zaten .gitignore'da).
    -->
    <NuGetLockFilePath Condition="'$(RuntimeIdentifier)' != ''">$(MSBuildProjectDirectory)/obj/packages.$(RuntimeIdentifier).lock.json</NuGetLockFilePath>

    <!--
      Sürüm git tag'inden türetiliyor (P10-T01, ADR-0006). Hiçbir dosyaya elle yazılmaz.

      MinVerTagPrefix ZORUNLU: ADR-0006 tag'leri `v` önekli tanımlıyor (v1.0.0) ama MinVer
      varsayılan olarak öneksiz bekliyor ve `v1.0.0`'ı "non-version tag" diyip ATLIYOR —
      uyarı vermeden 0.0.0-alpha.0'a düşerek. Ölçüldü (P10-T00).
    -->
    <MinVerTagPrefix>v</MinVerTagPrefix>

    <!--
      Tag yokken (temiz klon, fork, sığ klon) MinVer 0.0.0-alpha.0 üretir. Bu değer
      yayınlanabilir bir sürüm DEĞİL; yayın hattı P10-T02'deki doğrulama adımıyla
      böyle bir çıktının paketlenmesini engelliyor.
    -->
    <MinVerDefaultPreReleaseIdentifiers>alpha.0</MinVerDefaultPreReleaseIdentifiers>

    <Product>gitext-core</Product>
    <Company>gitext-core contributors</Company>
    <Authors>gitext-core contributors</Authors>
    <Copyright>Copyright (C) 2026 gitext-core contributors</Copyright>
    <RepositoryUrl>https://github.com/ibrahimhates/gitext-core</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <!-- ADR-0005: GPL-3.0-or-later. FSF'nin önerdiği "or later" biçimi kullanılıyor;
         ileride GPLv4 çıkarsa proje ona geçebilir. -->
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>

    <!-- IDE0005 (gereksiz using) yalnızca doküman dosyası üretildiğinde çalışır.
         Bkz. https://github.com/dotnet/roslyn/issues/41640 -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- CS1591: her public üye için XML yorumu zorunlu değil (doküman dosyası yalnızca
         IDE0005 için üretiliyor). CA1416: platforma özgü API uyarıları. -->
    <NoWarn>$(NoWarn);CS1591;CA1416</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>portable</DebugType>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

    <!--
      Derleme yolunu çıktıdan sil (P10-T05). Deponun DİSKTEKİ KONUMU derlemeye sızıyor:
      ölçüldü, aynı kaynak /work-a ve /work-bbbbb altında derlendiğinde farklı SHA
      üretiyor ve ikilinin içinde ".../obj/Release/net10.0/..." mutlak yolu duruyor.

      ContinuousIntegrationBuild bunu TEK BAŞINA çözmüyor — o kaynak dosya yollarını
      normalleştiriyor, ara çıktı yollarını değil. PathMap ile iki koşu bit-bit özdeş
      hâle geldi (ölçüldü).

      Yan fayda: kullanıcıya giden ikilide geliştiricinin ev dizini yazmıyor.
    -->
    <PathMap>$(MSBuildThisFileDirectory)=/_/</PathMap>
  </PropertyGroup>

  <ItemGroup>
    <!-- PrivateAssets=all: MinVer yalnızca derleme zamanı aracı, çalışma zamanına sızmaz. -->
    <PackageReference Include="MinVer" PrivateAssets="all" />
  </ItemGroup>

  <!--
    Sürümün MinVer tarafından türetildiğinin KANITI (P10-T01).

    🔴 SABOTAJ DOĞRULAMASI BURAYI DOĞURDU: MinVer devre dışı bırakıldığında (MinVerSkip=true)
    testlerin tamamı geçmeye devam etti. Sebep — SDK varsayılan sürümü `1.0.0`: geçerli
    semver, tüm derlemelerde tutarlı, sha'sı bile yerinde. Yani sürümleme altyapısı sessizce
    kapansa uygulama "gitext-core 1.0.0" derdi ve hiçbir test itiraz etmezdi.

    Ayırt edici işaret olarak MinVer'in kendi ürettiği MinVerVersion derlemeye gömülüyor.
    MinVer çalışmazsa bu öznitelik boş kalır ve test kırılır.
  -->
  <Target Name="EmbedMinVerEvidence" AfterTargets="MinVer" BeforeTargets="GetAssemblyAttributes">
    <ItemGroup>
      <AssemblyMetadata Include="MinVerVersion" Value="$(MinVerVersion)" />
    </ItemGroup>
  </Target>

</Project>
