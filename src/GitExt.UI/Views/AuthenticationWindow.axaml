<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GitExt.UI.ViewModels"
        x:Class="GitExt.UI.Views.AuthenticationWindow"
        x:DataType="vm:AuthenticationViewModel"
        Title="Kimlik doğrulama"
        Width="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <!--
        GitExtensions'ta bunun tam karşılığı yok: orada kimlik doğrulama PuTTY/pageant
        etrafında kurulu (§ 9'un kapsamı Windows araçları). Linux'ta karşılığı SSH agent
        ve credential helper; bu yüzden ekran GitExtensions'ın "Load SSH key" düğmesinin
        yerini alıyor, onu taklit etmiyor.

        Sıra: ne oldu -> hangi adres -> ne yapılabilir (öneriler) -> kimlik alanları.
        Kimlik alanları YALNIZCA HTTPS'te görünüyor: SSH'ta istenen şey bir parola değil,
        anahtar; alan göstermek yanlış bir vaat olurdu.
    -->
    <StackPanel Margin="16" Spacing="12">

        <TextBlock Name="ExplanationText"
                   TextWrapping="Wrap"
                   Text="{Binding Explanation}" />

        <StackPanel Spacing="2" IsVisible="{Binding HasUrl}">
            <TextBlock Text="Uzak depo:" FontSize="11" Opacity="0.8" />
            <TextBox Name="UrlBox"
                     IsReadOnly="True"
                     IsTabStop="False"
                     FontFamily="Cascadia Mono,Consolas,Menlo,DejaVu Sans Mono,monospace"
                     FontSize="11"
                     Text="{Binding Url}" />
        </StackPanel>

        <StackPanel Name="SuggestionPanel" Spacing="4" IsVisible="{Binding HasSuggestions}">
            <TextBlock Text="Şunları deneyebilirsiniz:" FontSize="11" Opacity="0.8" />
            <ItemsControl Name="SuggestionList" ItemsSource="{Binding Suggestions}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="x:String">
                        <TextBox IsReadOnly="True"
                                 Margin="0,0,0,3"
                                 FontFamily="Cascadia Mono,Consolas,Menlo,DejaVu Sans Mono,monospace"
                                 FontSize="11"
                                 Text="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <StackPanel Name="CredentialPanel" Spacing="6" IsVisible="{Binding CanEnterCredentials}">
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="Kullanıcı adı"
                           VerticalAlignment="Center"
                           Margin="0,0,8,4" />
                <TextBox Name="UsernameBox"
                         Grid.Row="0" Grid.Column="1"
                         Margin="0,0,0,4"
                         Text="{Binding Username}" />

                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="Parola / token"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0" />
                <TextBox Name="SecretBox"
                         Grid.Row="1" Grid.Column="1"
                         PasswordChar="•"
                         Text="{Binding Secret}" />
            </Grid>

            <TextBlock Name="StorageNoticeText"
                       FontSize="11"
                       Opacity="0.85"
                       TextWrapping="Wrap"
                       Text="Girdiğiniz bilgi hiçbir yere kaydedilmiyor; yalnızca bu işlem için kullanılıyor. Kalıcı olarak saklamak isterseniz yukarıdaki credential helper komutlarından birini çalıştırın." />
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Name="CancelButton" Content="İptal" MinWidth="90" IsCancel="True" Click="OnCancelClick" />
            <Button Name="SubmitButton"
                    Content="Tekrar dene"
                    MinWidth="110"
                    IsDefault="True"
                    IsVisible="{Binding CanEnterCredentials}"
                    Command="{Binding SubmitCommand}" />
        </StackPanel>
    </StackPanel>
</Window>
