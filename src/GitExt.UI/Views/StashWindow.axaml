<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:GitExt.UI.Localization"
        xmlns:vm="using:GitExt.UI.ViewModels"
        x:Class="GitExt.UI.Views.StashWindow"
        x:DataType="vm:StashViewModel"
        Title="{loc:Translate stash.stashes}" Width="900" Height="560"
        WindowStartupLocation="CenterOwner">

  <!-- Yerleşim GitExtensions FormStash'ten (§ 9): solda liste, sağda diff, altta eylemler. -->
  <Grid RowDefinitions="Auto,*,Auto" Margin="12">

    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6" Margin="0,0,0,8">
      <TextBox Name="MessageBox" Width="280"
               PlaceholderText="Stash message (optional)"
               Text="{Binding NewMessage}" />
      <CheckBox Name="UntrackedBox" Content="{loc:Translate stash.include_untracked}" IsChecked="{Binding IncludeUntracked}" />
      <CheckBox Name="KeepIndexBox" Content="{loc:Translate stash.keep_index}" IsChecked="{Binding KeepIndex}" />
      <Button Name="PushButton" Content="{loc:Translate stash.stash_changes}" Command="{Binding PushCommand}" />
    </StackPanel>

    <Grid Grid.Row="1" ColumnDefinitions="300,4,*">
      <ListBox Grid.Column="0" Name="StashList"
               ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:StashRowViewModel">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="{Binding Selector}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Badge}" FontSize="10" Opacity="0.7"
                           IsVisible="{Binding HasBadge}" />
              </StackPanel>
              <TextBlock Text="{Binding Message}" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding Timestamp}" FontSize="10" Opacity="0.6" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <GridSplitter Grid.Column="1" Background="Transparent" />

      <TextBox Grid.Column="2" Name="DiffBox"
               Text="{Binding Diff}" IsReadOnly="True" AcceptsReturn="True"
               FontFamily="{DynamicResource GitExtMonospaceFont}" TextWrapping="NoWrap" />
    </Grid>

    <StackPanel Grid.Row="2" Margin="0,10,0,0" Spacing="6">
      <TextBlock Name="NoticeLabel" Text="{Binding Notice}" TextWrapping="Wrap"
                 IsVisible="{Binding Notice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <TextBlock Name="ErrorLabel" Text="{Binding Error}" Foreground="{DynamicResource GitExtErrorBrush}" TextWrapping="Wrap"
                 IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <StackPanel Orientation="Horizontal" Spacing="6">
        <Button Name="ApplyButton" Content="{loc:Translate stash.apply}" Command="{Binding ApplyCommand}" />
        <Button Name="PopButton" Content="{loc:Translate stash.pop}" Command="{Binding PopCommand}" />
        <Button Name="DropButton" Content="{loc:Translate stash.drop}" Command="{Binding DropCommand}" />
        <Border Width="1" Background="{DynamicResource GitExtSeparatorBrush}" Margin="4,2" />
        <TextBox Name="BranchNameBox" Width="160" PlaceholderText="New branch name" />
        <Button Name="BranchButton" Content="{loc:Translate stash.branch_from_stash}" Command="{Binding BranchCommand}" />
        <Button Name="CloseButton" Content="{loc:Translate stash.close}" Click="OnClose" />
      </StackPanel>
    </StackPanel>
  </Grid>
</Window>
