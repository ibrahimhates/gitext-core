<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Giriş noktası ve DI composition root (ADR-0003, ADR-0004).
    Servis kayıtları YALNIZCA burada yapılır.
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>gitext-core</AssemblyName>
    <RootNamespace>GitExt.Desktop</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

    <!-- Publish boyutunu küçültür, ICU bağımlılığını kaldırır (ADR-0006).
         P01-T18'de UTF-8 dosya adlarını etkilemediği doğrulanacak. -->
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Self-contained publish varsayılanları; komut satırından -r ile RID verilir. -->
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <!-- Koşulsuz: Program.cs içindeki UseWayland() çağrısı her RID için derlenebilmeli.
         Paketin native varlıkları zaten yalnızca linux RID'lerinde kopyalanır. -->
    <PackageReference Include="Avalonia.Wayland" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../GitExt.UI/GitExt.UI.csproj" />
  </ItemGroup>

  <!--
    P01-T18/T19 — Native pdb'leri publish çıktısından çıkar.
    SkiaSharp ve HarfBuzzSharp, native kütüphanelerinin sembol dosyalarını da taşır:
    libSkiaSharp.pdb ~84 MB, libHarfBuzzSharp.pdb ~21 MB. Bunlar dağıtılan pakete
    gereksiz ~105 MB ekler. Yönetilen (managed) pdb'ler birkaç KB olduğu ve çökme
    teşhisinde işe yaradığı için korunur.
  -->
  <Target Name="RemoveNativeSymbolsFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish
        Remove="@(ResolvedFileToPublish)"
        Condition="'%(Extension)' == '.pdb' and $([System.String]::Copy('%(Filename)').StartsWith('lib'))" />
    </ItemGroup>
  </Target>

</Project>
