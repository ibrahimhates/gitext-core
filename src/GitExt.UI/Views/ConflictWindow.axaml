<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GitExt.UI.ViewModels"
        x:Class="GitExt.UI.Views.ConflictWindow"
        x:DataType="vm:ConflictViewModel"
        Title="Resolve conflicts"
        Width="1000" Height="640"
        WindowStartupLocation="CenterOwner">

    <!--
      Yerleşim GitExtensions FormResolveConflicts'ten (§ 9):
      solda çakışan dosyalar, sağda Base | Ours | Theirs, altta eylemler.
    -->
    <Grid RowDefinitions="Auto,*,Auto" Margin="12">

        <TextBlock Grid.Row="0"
                   Name="RemainingLabel"
                   Text="{Binding RemainingText}"
                   FontWeight="Bold"
                   Margin="0,0,0,8" />

        <Grid Grid.Row="1" ColumnDefinitions="260,4,*">

            <!-- Çakışan dosyalar -->
            <ListBox Grid.Column="0"
                     Name="ConflictList"
                     ItemsSource="{Binding Files}"
                     SelectedItem="{Binding Selected}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ConflictFileViewModel">
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Description}"
                                       FontSize="11"
                                       Opacity="0.7" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <GridSplitter Grid.Column="1" Background="Transparent" />

            <Grid Grid.Column="2" RowDefinitions="*,4,*" IsVisible="{Binding HasSelection}">

                <!-- Üç yollu paneller; varlık çakışmasında gizleniyor. -->
                <Grid Grid.Row="0"
                      Name="ThreeWayPanel"
                      ColumnDefinitions="*,*,*"
                      IsVisible="{Binding ShowThreeWay}">

                    <Grid Grid.Column="0" RowDefinitions="Auto,*" Margin="0,0,4,0">
                        <TextBlock Grid.Row="0" Text="Base (common ancestor)" FontSize="11" Opacity="0.7" />
                        <TextBox Grid.Row="1" Name="BaseBox"
                                 Text="{Binding BaseText}"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 FontFamily="{DynamicResource GitExtMonospaceFont}"
                                 TextWrapping="NoWrap" />
                    </Grid>

                    <Grid Grid.Column="1" RowDefinitions="Auto,*" Margin="4,0">
                        <TextBlock Grid.Row="0" Text="Ours (current branch)" FontSize="11" Opacity="0.7" />
                        <TextBox Grid.Row="1" Name="OursBox"
                                 Text="{Binding OursText}"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 FontFamily="{DynamicResource GitExtMonospaceFont}"
                                 TextWrapping="NoWrap" />
                    </Grid>

                    <Grid Grid.Column="2" RowDefinitions="Auto,*" Margin="4,0,0,0">
                        <TextBlock Grid.Row="0" Text="Theirs (incoming)" FontSize="11" Opacity="0.7" />
                        <TextBox Grid.Row="1" Name="TheirsBox"
                                 Text="{Binding TheirsText}"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 FontFamily="{DynamicResource GitExtMonospaceFont}"
                                 TextWrapping="NoWrap" />
                    </Grid>
                </Grid>

                <GridSplitter Grid.Row="1" Background="Transparent" />

                <Grid Grid.Row="2" RowDefinitions="Auto,*">
                    <TextBlock Grid.Row="0" Text="Result" FontSize="11" Opacity="0.7" />
                    <TextBox Grid.Row="1" Name="MergedBox"
                             Text="{Binding MergedText}"
                             AcceptsReturn="True"
                             FontFamily="{DynamicResource GitExtMonospaceFont}"
                             TextWrapping="NoWrap" />
                </Grid>
            </Grid>
        </Grid>

        <StackPanel Grid.Row="2" Margin="0,10,0,0" Spacing="6">

            <TextBlock Name="ErrorLabel"
                       Text="{Binding Error}"
                       Foreground="{DynamicResource GitExtErrorBrush}"
                       TextWrapping="Wrap"
                       IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Name="TakeOursButton" Content="Take ours" Command="{Binding TakeOursCommand}" />
                <Button Name="TakeTheirsButton" Content="Take theirs" Command="{Binding TakeTheirsCommand}" />
                <Button Name="TakeBothButton" Content="Take both" Command="{Binding TakeBothCommand}" />
                <Button Name="SaveMergedButton" Content="Save result" Command="{Binding SaveMergedCommand}" />
                <Button Name="RemoveButton" Content="Delete file" Command="{Binding RemoveCommand}" />
                <Button Name="MergeToolButton" Content="Open merge tool" Command="{Binding OpenMergeToolCommand}" />

                <Border Width="1" Background="{DynamicResource GitExtSeparatorBrush}" Margin="4,2" />

                <!-- Devam yalnızca hepsi çözülünce etkin: erken çalıştırmak rc=128. -->
                <Button Name="ContinueButton"
                        Content="Continue"
                        Command="{Binding ContinueCommand}"
                        IsDefault="True" />
                <Button Name="AbortButton" Content="Abort" Command="{Binding AbortCommand}" />
                <Button Name="CloseButton" Content="Close" Click="OnClose" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
