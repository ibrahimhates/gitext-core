<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GitExt.UI.ViewModels"
        x:Class="GitExt.UI.Views.DiagnosticsWindow"
        x:DataType="vm:DiagnosticsViewModel"
        Title="Performans teşhisi"
        Width="720"
        Height="560"
        WindowStartupLocation="CenterOwner">

    <!--
        P09-T03. Gizli panel: menüde yok, yalnızca kısayolla açılıyor.
        Toplama her zaman açık; gizli olan gösterim.

        Üstte özet (bellek, kare, çalışma süresi), altta komut başına istatistik.
        Kare bölümü yalnızca ölçüm varsa görünüyor.
    -->
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="10">

        <Grid Grid.Row="0" ColumnDefinitions="*,*" Margin="0,0,0,8">
            <StackPanel Grid.Column="0" Spacing="3">
                <TextBlock Text="Bellek" FontWeight="SemiBold" FontSize="11" />
                <Grid ColumnDefinitions="110,*">
                    <TextBlock Grid.Column="0" Text="Yönetilen" FontSize="11" Opacity="0.75" />
                    <TextBlock Name="ManagedMemoryText" Grid.Column="1" Text="{Binding ManagedMemory}" FontSize="11" />
                </Grid>
                <Grid ColumnDefinitions="110,*">
                    <TextBlock Grid.Column="0" Text="Süreç" FontSize="11" Opacity="0.75" />
                    <TextBlock Name="ProcessMemoryText" Grid.Column="1" Text="{Binding ProcessMemory}" FontSize="11" />
                </Grid>
                <Grid ColumnDefinitions="110,*">
                    <TextBlock Grid.Column="0" Text="Toplama" FontSize="11" Opacity="0.75" />
                    <TextBlock Name="CollectionsText" Grid.Column="1" Text="{Binding Collections}" FontSize="11" />
                </Grid>
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="3">
                <TextBlock Text="Oturum" FontWeight="SemiBold" FontSize="11" />
                <Grid ColumnDefinitions="110,*">
                    <TextBlock Grid.Column="0" Text="Çalışma süresi" FontSize="11" Opacity="0.75" />
                    <TextBlock Name="UptimeText" Grid.Column="1" Text="{Binding Uptime}" FontSize="11" />
                </Grid>
                <Grid ColumnDefinitions="110,*">
                    <TextBlock Grid.Column="0" Text="Git çağrısı" FontSize="11" Opacity="0.75" />
                    <TextBlock Name="TotalCommandCountText" Grid.Column="1" Text="{Binding TotalCommandCount}" FontSize="11" />
                </Grid>
                <Grid ColumnDefinitions="110,*">
                    <TextBlock Grid.Column="0" Text="Toplam süre" FontSize="11" Opacity="0.75" />
                    <TextBlock Name="TotalCommandDurationText" Grid.Column="1" Text="{Binding TotalCommandDuration}" FontSize="11" />
                </Grid>
            </StackPanel>
        </Grid>

        <!-- Kare ölçümü yalnızca bir pencereye bağlıysa var. -->
        <StackPanel Grid.Row="1" Spacing="3" Margin="0,0,0,8" IsVisible="{Binding HasFrameStatistics}">
            <TextBlock Text="Kare süresi" FontWeight="SemiBold" FontSize="11" />
            <Grid ColumnDefinitions="110,*">
                <TextBlock Grid.Column="0" Text="Ortalama" FontSize="11" Opacity="0.75" />
                <TextBlock Name="AverageFrameTimeText" Grid.Column="1" Text="{Binding AverageFrameTime}" FontSize="11" />
            </Grid>
            <Grid ColumnDefinitions="110,*">
                <TextBlock Grid.Column="0" Text="En kötü" FontSize="11" Opacity="0.75" />
                <TextBlock Name="WorstFrameTimeText" Grid.Column="1" Text="{Binding WorstFrameTime}" FontSize="11" />
            </Grid>
            <Grid ColumnDefinitions="110,*">
                <TextBlock Grid.Column="0" Text="Bütçeyi aşan" FontSize="11" Opacity="0.75" />
                <TextBlock Name="DroppedFramesText"
                           Grid.Column="1"
                           Text="{Binding DroppedFrames}"
                           FontSize="11"
                           Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"
                           IsVisible="{Binding HasDroppedFrames}" />
                <TextBlock Grid.Column="1"
                           Text="{Binding DroppedFrames}"
                           FontSize="11"
                           IsVisible="{Binding !HasDroppedFrames}" />
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="2" Spacing="3" Margin="0,0,0,8" IsVisible="{Binding HasActiveOperations}">
            <TextBlock Text="Devam eden işler" FontWeight="SemiBold" FontSize="11" />
            <ItemsControl Name="ActiveOperationsList" ItemsSource="{Binding ActiveOperations}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontSize="11" Opacity="0.85" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <Grid Grid.Row="3" RowDefinitions="Auto,Auto,*">
            <TextBlock Grid.Row="0" Text="Git komutları" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4" />

            <Grid Grid.Row="1" ColumnDefinitions="*,60,80,80,80,60" Margin="4,0,4,3">
                <TextBlock Grid.Column="0" Text="Komut" FontWeight="SemiBold" FontSize="11" />
                <TextBlock Grid.Column="1" Text="Adet" FontWeight="SemiBold" FontSize="11" />
                <TextBlock Grid.Column="2" Text="Toplam" FontWeight="SemiBold" FontSize="11" />
                <TextBlock Grid.Column="3" Text="Ortalama" FontWeight="SemiBold" FontSize="11" />
                <TextBlock Grid.Column="4" Text="En uzun" FontWeight="SemiBold" FontSize="11" />
                <TextBlock Grid.Column="5" Text="Hata" FontWeight="SemiBold" FontSize="11" />
            </Grid>

            <ListBox Name="CommandList" Grid.Row="2" ItemsSource="{Binding Commands}">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="vm:CommandStatisticsRowViewModel">
                        <Grid ColumnDefinitions="*,60,80,80,80,60">
                            <TextBlock Grid.Column="0"
                                       Text="{Binding Name}"
                                       FontFamily="{DynamicResource GitExtMonospaceFont}"
                                       FontSize="11"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Count}" FontSize="11" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding Total}" FontSize="11" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="{Binding Average}" FontSize="11" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="4" Text="{Binding Max}" FontSize="11" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="5"
                                       Text="{Binding FailureCount}"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"
                                       IsVisible="{Binding HasFailures}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Name="EmptyText"
                       Grid.Row="2"
                       Text="Henüz git komutu çalıştırılmadı."
                       FontSize="11"
                       Opacity="0.7"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       IsVisible="{Binding IsEmpty}" />
        </Grid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Name="RefreshButton" Content="Tazele" Command="{Binding RefreshCommand}" />
            <Button Name="ResetButton" Content="Sayaçları sıfırla" Command="{Binding ResetCommand}" />
        </StackPanel>
    </Grid>
</Window>
