<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:GitExt.UI.Localization"
        x:Class="GitExt.UI.Views.RenameBranchDialog"
        Title="{loc:Translate rename_branch.rename_branch}"
        Width="480"
        SizeToContent="Height"
        MinHeight="180"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <!--
        The layout comes from GitExtensions `FormRenameBranch.Designer.cs` (§ 9):
        label1 "New name" plus the box, button "Rename".
    -->
    <StackPanel Margin="16" Spacing="10">

        <StackPanel Spacing="4">
            <TextBlock Name="CurrentNameLabel" Text="{loc:Translate rename_branch.current_name}" />
            <TextBox Name="CurrentNameText" IsReadOnly="True" IsTabStop="False" />
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock Text="{loc:Translate rename_branch.new_name}" />
            <TextBox Name="NewNameTextBox" />
            <TextBlock Name="ValidationText"
                       FontSize="11"
                       TextWrapping="Wrap"
                       IsVisible="False"
                       Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}" />
        </StackPanel>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8">
            <Button Name="CancelButton" Content="{loc:Translate rename_branch.cancel}" MinWidth="90" IsCancel="True" Click="OnCancelClick" />
            <Button Name="RenameButton" Content="{loc:Translate rename_branch.rename}" MinWidth="90" IsDefault="True" Click="OnRenameClick" />
        </StackPanel>
    </StackPanel>
</Window>
