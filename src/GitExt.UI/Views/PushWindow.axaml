<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:GitExt.UI.Localization"
        xmlns:vm="using:GitExt.UI.ViewModels"
        x:Class="GitExt.UI.Views.PushWindow"
        x:DataType="vm:PushViewModel"
        Title="{loc:Translate push.push}"
        Width="660"
        SizeToContent="Height"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <!--
        The layout comes from GitExtensions `FormPush.Designer.cs` (§ 9), order verbatim:
          GroupBox2 "Push to" (Remote / Url) →
          TabControlTagBranch (Push branches · Push tags · Push multiple branches) →
          bottom row: Pull · Load SSH key · Push.

        What we DO NOT have: the "Url" option and "Load SSH key" (in place but disabled — both
        depend on P06-T09's authentication flow), "Recursive submodules" (submodules are Phase
        08), "Create pull request after push" (repository host integration is out of scope).

        DISABLED, WITH THE REASON WRITTEN OUT: "Force push". A plan decision — the bare force flag
        is not offered. Leaving the box out entirely would give the impression that this program
        cannot force at all.
        (The flag itself CANNOT BE WRITTEN here: an XML comment may not contain two hyphens. The
        same trap came up in Phase 01 in Directory.Build.props and again in P06-T05.)

        ADDED: which end the lease will be judged against, and the COMMAND that will run.
    -->
    <StackPanel Margin="16" Spacing="10">

        <HeaderedContentControl Header="{loc:Translate push.push_to}">
            <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" Margin="8,4">
                <RadioButton Name="ToRemoteRadio"
                             Grid.Row="0" Grid.Column="0"
                             GroupName="PushTo"
                             Content="{loc:Translate push.remote}"
                             IsChecked="True"
                             Margin="0,0,8,0" />
                <ComboBox Name="RemoteBox"
                          Grid.Row="0" Grid.Column="1"
                          HorizontalAlignment="Stretch"
                          ItemsSource="{Binding Remotes}"
                          SelectedItem="{Binding SelectedRemote}" />
                <Button Name="ManageRemotesButton"
                        Grid.Row="0" Grid.Column="2"
                        Content="{loc:Translate push.manage}"
                        Margin="8,0,0,0"
                        Click="OnManageRemotesClick" />

                <!-- In place but disabled (§ 9): pushing to a URL depends on P06-T09. -->
                <RadioButton Name="ToUrlRadio"
                             Grid.Row="1" Grid.Column="0"
                             GroupName="PushTo"
                             Content="{loc:Translate push.url}"
                             IsEnabled="False"
                             Margin="0,6,8,0" />
                <TextBox Name="UrlBox"
                         Grid.Row="1" Grid.Column="1"
                         IsEnabled="False"
                         Margin="0,6,0,0" />
            </Grid>
        </HeaderedContentControl>

        <TabControl Name="TargetTabs" Margin="0,4">

            <TabItem Name="BranchTab" Header="{loc:Translate push.push_branch}" IsSelected="{Binding IsBranchTab}">
                <StackPanel Margin="8" Spacing="8">
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="{loc:Translate push.branch_to_push}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,4" />
                        <ComboBox Name="SourceBranchBox"
                                  Grid.Row="0" Grid.Column="1"
                                  HorizontalAlignment="Stretch"
                                  Margin="0,0,0,4"
                                  ItemsSource="{Binding SourceBranches}"
                                  SelectedItem="{Binding SourceBranch}" />

                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="{loc:Translate push.target}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <TextBox Name="RemoteBranchBox"
                                 Grid.Row="1" Grid.Column="1"
                                 Text="{Binding RemoteBranch}" />
                    </Grid>

                    <TextBlock Name="NewBranchNotice"
                               FontSize="11"
                               Opacity="0.85"
                               TextWrapping="Wrap"
                               IsVisible="{Binding WouldCreateRemoteBranch}"
                               Text="{loc:Translate push.this_name_does_not_exist_on_the_remote_a_new}" />

                    <ToggleButton Name="ShowOptionsToggle"
                                  Content="{loc:Translate push.show_options}"
                                  HorizontalAlignment="Left"
                                  IsChecked="{Binding ShowOptions}" />

                    <StackPanel Name="PushOptionsPanel"
                                Spacing="4"
                                IsVisible="{Binding ShowOptions}">
                        <CheckBox Name="SetUpstreamBox"
                                  Content="{loc:Translate push.set_upstream_tracking_reference}"
                                  IsChecked="{Binding SetUpstream}" />
                        <CheckBox Name="ForceWithLeaseBox"
                                  Content="{loc:Translate push.force_with_lease}"
                                  IsChecked="{Binding ForceWithLease}" />

                        <!-- In place but disabled: a plan decision, the line below states why. -->
                        <CheckBox Name="ForcePushBox"
                                  Content="{loc:Translate push.force_push}"
                                  IsEnabled="False" />
                        <TextBlock Name="ForceDisabledText"
                                   FontSize="11"
                                   Opacity="0.8"
                                   TextWrapping="Wrap"
                                   Margin="20,0,0,0"
                                   Text="{Binding ForceDisabledReason}" />

                        <CheckBox Name="RecursiveSubmodulesBox"
                                  Content="{loc:Translate push.push_submodules_as_well}"
                                  IsEnabled="False" />
                        <CheckBox Name="CreatePullRequestBox"
                                  Content="{loc:Translate push.create_a_pull_request_after_pushing}"
                                  IsEnabled="False" />
                    </StackPanel>

                    <TextBlock Name="LeaseNoticeText"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Opacity="0.85"
                               IsVisible="{Binding HasLeaseNotice}"
                               Text="{Binding LeaseNotice}" />
                </StackPanel>
            </TabItem>

            <TabItem Name="TagTab" Header="{loc:Translate push.push_tag}" IsSelected="{Binding IsTagTab}">
                <StackPanel Margin="8" Spacing="8">
                    <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Grid.Column="0"
                                   Text="{loc:Translate push.tag_to_push}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <ComboBox Name="TagBox"
                                  Grid.Column="1"
                                  HorizontalAlignment="Stretch"
                                  IsEnabled="{Binding !AllTags}"
                                  ItemsSource="{Binding Tags}"
                                  SelectedItem="{Binding SelectedTag}" />
                    </Grid>

                    <CheckBox Name="AllTagsBox"
                              Content="{loc:Translate push.push_all_tags}"
                              IsChecked="{Binding AllTags}" />

                    <CheckBox Name="ForceTagBox"
                              Content="{loc:Translate push.force_push}"
                              IsEnabled="False" />
                </StackPanel>
            </TabItem>

            <TabItem Name="MultipleTab" Header="{loc:Translate push.multiple_branches}" IsSelected="{Binding IsMultipleTab}">
                <StackPanel Margin="8" Spacing="6">
                    <!--
                        GitExtensions uses a `DataGridView` here. Avalonia's `DataGrid` is a
                        separate NuGet package; adding a dependency for a single screen would also
                        widen ADR-0006's lock file. It was built with an `ItemsControl` while
                        keeping the column order and headers verbatim.
                    -->
                    <Grid Name="BranchGridHeader" ColumnDefinitions="*,*,90,70,110" Margin="2,0">
                        <TextBlock Grid.Column="0" Text="{loc:Translate push.local_branch}" FontWeight="SemiBold" FontSize="11" />
                        <TextBlock Grid.Column="1" Text="{loc:Translate push.remote_branch}" FontWeight="SemiBold" FontSize="11" />
                        <TextBlock Grid.Column="2" Text="{loc:Translate push.ahead_behind}" FontWeight="SemiBold" FontSize="11" />
                        <TextBlock Grid.Column="3" Text="{loc:Translate push.push}" FontWeight="SemiBold" FontSize="11" />
                        <TextBlock Grid.Column="4" Text="{loc:Translate push.delete_on_remote}" FontWeight="SemiBold" FontSize="11" />
                    </Grid>

                    <ScrollViewer Height="180">
                        <ItemsControl Name="BranchGrid" ItemsSource="{Binding Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:PushBranchRowViewModel">
                                    <Grid ColumnDefinitions="*,*,90,70,110" Margin="2,3">
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding LocalBranch}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding RemoteBranch}"
                                                   Opacity="0.85"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding AheadBehind}"
                                                   FontSize="11"
                                                   Opacity="0.85"
                                                   VerticalAlignment="Center" />
                                        <CheckBox Grid.Column="3" IsChecked="{Binding Push}" />
                                        <CheckBox Grid.Column="4"
                                                  IsChecked="{Binding Delete}"
                                                  IsEnabled="{Binding CanDelete}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock Name="DeleteWarningText"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Opacity="0.85"
                               Text="{loc:Translate push.deleting_a_remote_branch_makes_its_tip_commi}" />
                </StackPanel>
            </TabItem>
        </TabControl>

        <!-- The "show the command" principle: what will happen must be readable before the button is pressed. -->
        <StackPanel Spacing="3">
            <TextBlock Text="{loc:Translate push.command_to_run}" FontSize="11" Opacity="0.8" />
            <TextBox Name="CommandPreviewBox"
                     IsReadOnly="True"
                     IsTabStop="False"
                     FontFamily="{DynamicResource GitExtMonospaceFont}"
                     FontSize="11"
                     Text="{Binding CommandPreview}" />
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock Name="WarningText"
                       FontSize="11"
                       TextWrapping="Wrap"
                       IsVisible="{Binding HasWarning}"
                       Text="{Binding Warning}"
                       Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}" />
            <TextBlock Name="AdviceText"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Opacity="0.9"
                       IsVisible="{Binding HasAdvice}"
                       Text="{Binding Advice}" />
            <TextBlock Name="NoticeText"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Opacity="0.85"
                       Text="{Binding Notice}" />
        </StackPanel>

        <!--
            Progress and cancel (P06-T10). Measured: git writes its progress lines with a carriage
            return, which is why stderr is read as a stream. The cancel button really does kill the
            process; a fetch interrupted halfway leaves no lock behind.
        -->
        <StackPanel Name="ProgressPanel" Spacing="4" IsVisible="{Binding IsBusy}">
            <TextBlock Name="ProgressText"
                       FontSize="11"
                       Opacity="0.9"
                       TextWrapping="Wrap"
                       Text="{Binding ProgressText}" />
            <Grid ColumnDefinitions="*,Auto">
                <ProgressBar Name="ProgressBar"
                             Grid.Column="0"
                             Minimum="0"
                             Maximum="100"
                             Height="6"
                             VerticalAlignment="Center"
                             IsIndeterminate="{Binding IsProgressIndeterminate}"
                             Value="{Binding ProgressPercent}" />
                <Button Name="CancelRunButton"
                        Grid.Column="1"
                        Content="{loc:Translate push.cancel}"
                        MinWidth="80"
                        Margin="8,0,0,0"
                        Command="{Binding CancelCommand}" />
            </Grid>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Name="PullButton" Content="{loc:Translate push.pull}" MinWidth="90" Click="OnPullClick" />
            <Button Name="LoadSshKeyButton" Content="{loc:Translate push.load_ssh_key}" MinWidth="140" IsEnabled="False" />
            <Button Name="CloseButton" Content="{loc:Translate push.close}" MinWidth="90" IsCancel="True" Click="OnCloseClick" />
            <Button Name="PushButton"
                    Content="{loc:Translate push.push}"
                    MinWidth="110"
                    IsDefault="True"
                    Command="{Binding RunCommand}" />
        </StackPanel>
    </StackPanel>
</Window>
