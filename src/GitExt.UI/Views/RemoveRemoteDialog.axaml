<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:GitExt.UI.Localization"
        x:Class="GitExt.UI.Views.RemoveRemoteDialog"
        Title="{loc:Translate remove_remote.remove_remote}"
        Width="560"
        SizeToContent="Height"
        MinHeight="200"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <!--
        GitExtensions'ta bu ekranın karşılığı yalnızca "Delete" düğmesi ve basit bir onay.
        Ölçüm bunun yetmediğini gösterdi: silme sonrası uzak izleme dalları VE reflog'ları
        gidiyor, budayan bir `git gc` sonrası yalnız o dallarda duran commit KAYBOLUYOR.
        (XML yorumunda iki tire yan yana yazılamıyor — Faz 01'deki tuzağın aynısı.)
        Bu yüzden P06-T03'teki kurtarma bölümü buraya da kondu — farkıyla birlikte:
        kurtarma `fetch` gerektiriyor, yani uzak depo hâlâ erişilebilir olmalı.
    -->
    <StackPanel Margin="16" Spacing="10">

        <TextBlock Name="MessageText" TextWrapping="Wrap" FontWeight="SemiBold" />

        <TextBlock Name="ImpactText" TextWrapping="Wrap" />

        <StackPanel Spacing="3">
            <TextBlock Text="{loc:Translate remove_remote.to_restore_it}" FontSize="11" Opacity="0.85" />
            <TextBox Name="RecoveryCommands"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     MaxHeight="120"
                     FontFamily="{DynamicResource GitExtMonospaceFont}"
                     FontSize="11" />
            <TextBlock Name="RecoveryNote"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Opacity="0.75"
                       Text="{loc:Translate remove_remote.these_commands_restore_the_configuration_com}" />
        </StackPanel>

        <CheckBox Name="ConfirmBox" Content="{loc:Translate remove_remote.i_confirm_the_removal}" />

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8">
            <Button Name="CancelButton" Content="{loc:Translate remove_remote.cancel}" MinWidth="90" IsCancel="True" Click="OnCancelClick" />
            <Button Name="RemoveButton" Content="{loc:Translate remove_remote.remove}" MinWidth="90" IsDefault="True" Click="OnRemoveClick" />
        </StackPanel>
    </StackPanel>
</Window>
