<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Git ile konuşan katman. Süreç yürütme, komut sarmalayıcıları, parser'lar, domain modelleri.
    ADR-0002 (git CLI), ADR-0003 (katman yapısı).

    KURAL: Bu projeye UI bağımlılığı EKLENEMEZ. build/NoUiDependencies.props bunu zorlar.
  -->

  <Import Project="$(MSBuildThisFileDirectory)../../build/NoUiDependencies.props" />

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Saf ayrıştırma mantığı (ölçülmüş git çıktı biçimleri) doğrudan test edilebilsin diye.
      Bu mantığı public API'ye açmak, yalnızca test için genişletilmiş bir yüzey demek olurdu.
    -->
    <InternalsVisibleTo Include="GitExt.Core.Tests" />
    <!--
      ViewModel testleri sahte veri kurarken RepositoryLocation üretmek zorunda.
      Yapıcısı bilinçli olarak internal: örneğinin varlığı "bu yol gerçekten bir depo"
      kanıtıdır ve rastgele üretilmemeli. Public yapmak yerine testlere açılıyor.
    -->
    <InternalsVisibleTo Include="GitExt.UI.Tests" />
  </ItemGroup>

</Project>
