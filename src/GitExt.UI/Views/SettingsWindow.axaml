<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:GitExt.UI.Localization"
        xmlns:vm="using:GitExt.UI.ViewModels"
        xmlns:views="using:GitExt.UI.Views"
        x:Class="GitExt.UI.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="{loc:Translate settings.settings}"
        Width="720" Height="620"
        WindowStartupLocation="CenterOwner">

    <TabControl Name="Sections" Margin="6">

        <!-- ============================================================ Appearance -->
        <TabItem Header="{loc:Translate settings.view}">
            <StackPanel Margin="12" Spacing="14">

                <StackPanel Spacing="4">
                    <TextBlock Text="{loc:Translate settings.language}" FontWeight="SemiBold" />
                    <!--
                        Unlike the Theme/Palette lists, this one has a DisplayMemberBinding:
                        those show the enum's raw ToString(), whereas here the user must be
                        shown "Türkçe", not "tr". The name comes from the language file's
                        _meta.name field (P11-T01).
                    -->
                    <ComboBox Name="LanguageBox"
                              ItemsSource="{Binding Languages}"
                              SelectedItem="{Binding Language}"
                              DisplayMemberBinding="{Binding Name}"
                              MinWidth="220" />
                    <TextBlock Text="{loc:Translate settings.the_change_applies_immediately_no_restart_ne}"
                               Opacity="0.65"
                               TextWrapping="Wrap"
                               FontSize="{DynamicResource GitExtSmallFontSize}" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="{loc:Translate settings.theme}" FontWeight="SemiBold" />
                    <ComboBox Name="ThemeBox"
                              ItemsSource="{Binding Themes}"
                              SelectedItem="{Binding Theme}"
                              MinWidth="220" />
                    <TextBlock Text="{loc:Translate settings.the_default_is_the_light_theme_system_follow}"
                               Opacity="0.65"
                               TextWrapping="Wrap"
                               FontSize="{DynamicResource GitExtSmallFontSize}" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="{loc:Translate settings.colour_palette}" FontWeight="SemiBold" />
                    <ComboBox Name="PaletteBox"
                              ItemsSource="{Binding Palettes}"
                              SelectedItem="{Binding Palette}"
                              MinWidth="220" />
                    <TextBlock Text="{loc:Translate settings.colorblindsafe_uses_a_blue_orange_distinctio}"
                               Opacity="0.65"
                               TextWrapping="Wrap"
                               FontSize="{DynamicResource GitExtSmallFontSize}" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="{loc:Translate settings.startup}" FontWeight="SemiBold" />

                    <!--
                        GitExtensions' `chkStartWithRecentWorkingDir`, and off by default there
                        too: the application starts on the dashboard and the repository is picked
                        from the list (P12-T04).
                    -->
                    <CheckBox Name="StartWithRecentRepositoryBox"
                              Content="{loc:Translate settings.reopen_the_last_repository_at_startup}"
                              IsChecked="{Binding StartWithRecentRepository}" />
                    <TextBlock Text="{loc:Translate settings.when_off_the_application_starts_on_the_dashb}"
                               Opacity="0.65"
                               TextWrapping="Wrap"
                               FontSize="{DynamicResource GitExtSmallFontSize}" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="{loc:Translate update.updates}" FontWeight="SemiBold" />

                    <!--
                        GitExtensions' `chkCheckForUpdates`, on by default there too. What it does
                        is one public GET a week; nothing is downloaded and nothing is installed
                        (P13-T01).
                    -->
                    <CheckBox Name="CheckForUpdatesBox"
                              Content="{loc:Translate update.check_for_new_versions}"
                              IsChecked="{Binding CheckForUpdates}" />
                    <TextBlock Text="{loc:Translate update.check_explains}"
                               Opacity="0.65"
                               TextWrapping="Wrap"
                               FontSize="{DynamicResource GitExtSmallFontSize}" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="{loc:Translate settings.font}" FontWeight="SemiBold" />

                    <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto" >
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Translate settings.interface_size}"
                                   VerticalAlignment="Center" Margin="0,2" />
                        <NumericUpDown Grid.Row="0" Grid.Column="1"
                                       Name="UiFontSizeBox"
                                       Value="{Binding UiFontSize}"
                                       Minimum="8" Maximum="32" Increment="1"
                                       MaxWidth="140" HorizontalAlignment="Left" Margin="0,2" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Translate settings.code_size}"
                                   VerticalAlignment="Center" Margin="0,2" />
                        <NumericUpDown Grid.Row="1" Grid.Column="1"
                                       Name="MonoFontSizeBox"
                                       Value="{Binding MonospaceFontSize}"
                                       Minimum="8" Maximum="32" Increment="1"
                                       MaxWidth="140" HorizontalAlignment="Left" Margin="0,2" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Translate settings.code_font}"
                                   VerticalAlignment="Center" Margin="0,2" />
                        <TextBox Grid.Row="2" Grid.Column="1"
                                 Name="MonoFontBox"
                                 Text="{Binding MonospaceFontFamily}"
                                 PlaceholderText="{loc:Translate settings.platform_default_if_left_empty}"
                                 Margin="0,2" />
                    </Grid>
                </StackPanel>
            </StackPanel>
        </TabItem>

        <!-- ========================================================== Shortcuts -->
        <TabItem Header="{loc:Translate settings.shortcuts}">
            <views:ShortcutSettingsView Name="ShortcutSection" DataContext="{Binding Shortcuts}" />
        </TabItem>

        <!-- ================================================================= Git -->
        <TabItem Header="{loc:Translate settings.git}">
            <ScrollViewer>
                <StackPanel Margin="12" Spacing="14">

                    <TextBlock Text="{loc:Translate settings.these_values_are_written_to_git_s_own_config}"
                               Opacity="0.7"
                               TextWrapping="Wrap"
                               FontSize="{DynamicResource GitExtSmallFontSize}" />

                    <StackPanel Spacing="6">
                        <TextBlock Text="{loc:Translate settings.global_all_repositories}" FontWeight="SemiBold" />

                        <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Translate settings.user_name}"
                                       VerticalAlignment="Center" Margin="0,3" />
                            <TextBox Grid.Row="0" Grid.Column="1" Name="GlobalNameBox"
                                     Text="{Binding GlobalUserName}" Margin="0,3" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Translate settings.user_email}"
                                       VerticalAlignment="Center" Margin="0,3" />
                            <TextBox Grid.Row="1" Grid.Column="1" Name="GlobalEmailBox"
                                     Text="{Binding GlobalUserEmail}" Margin="0,3" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Translate settings.core_editor}"
                                       VerticalAlignment="Center" Margin="0,3" />
                            <TextBox Grid.Row="2" Grid.Column="1" Name="GlobalEditorBox"
                                     Text="{Binding GlobalEditor}" Margin="0,3" />
                        </Grid>
                    </StackPanel>

                    <!--
                        🔴 With no repository open the local fields are DISABLED: git config
                        -local is fatal outside a repository (measured, exit code 128). Leaving
                        them enabled would offer the user a box that will not be saved.
                    -->
                    <StackPanel Spacing="6" IsEnabled="{Binding CanEditLocal}">
                        <TextBlock Text="{loc:Translate settings.local_open_repository_only}" FontWeight="SemiBold" />

                        <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Translate settings.user_name}"
                                       VerticalAlignment="Center" Margin="0,3" />
                            <TextBox Grid.Row="0" Grid.Column="1" Name="LocalNameBox"
                                     Text="{Binding LocalUserName}" Margin="0,3" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Translate settings.user_email}"
                                       VerticalAlignment="Center" Margin="0,3" />
                            <TextBox Grid.Row="1" Grid.Column="1" Name="LocalEmailBox"
                                     Text="{Binding LocalUserEmail}" Margin="0,3" />
                        </Grid>
                    </StackPanel>

                    <TextBlock Text="{loc:Translate settings.emptying_a_field_removes_that_setting_it_doe}"
                               Opacity="0.65"
                               TextWrapping="Wrap"
                               FontSize="{DynamicResource GitExtSmallFontSize}" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Name="SaveGitButton" Content="{loc:Translate settings.save_git_settings}"
                                Command="{Binding SaveGitCommand}" />
                    </StackPanel>

                    <Border Name="GitErrorBanner"
                            IsVisible="{Binding GitError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                            Background="{DynamicResource GitExtErrorBackgroundBrush}"
                            BorderBrush="{DynamicResource GitExtErrorBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="8,5">
                        <TextBlock Text="{Binding GitError}"
                                   Foreground="{DynamicResource GitExtErrorForegroundBrush}"
                                   TextWrapping="Wrap"
                                   FontSize="{DynamicResource GitExtSmallFontSize}" />
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</Window>
