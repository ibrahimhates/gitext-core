<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:GitExt.UI.Localization"
        x:Class="GitExt.UI.Views.ResetChangesDialog"
        Title="{loc:Translate reset_changes.reset_changes}"
        Width="520"
        SizeToContent="Height"
        MinHeight="240"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <!--
        Yerleşim GitExtensions `FormResetChanges.Designer.cs`'ten (§ 9):
        txtMessage → lblDeleteHint → cbDeleteNewFilesAndDirectories → [btnCancel][btnReset].
        Eklenen tek şey ETKİLENECEK DOSYA LİSTESİ: "emin misiniz?" sorusu neyin gideceğini
        söylemeden sorulduğunda kullanıcıyı düşünmeye değil tıklamaya yönlendirir (P05-T08
        bu önizlemeyi T15'e devretmişti).
    -->
    <StackPanel Margin="16" Spacing="10">

        <TextBlock Name="MessageText"
                   Text="{loc:Translate reset_changes.are_you_sure_you_want_to_reset_the_changes}"
                   TextWrapping="Wrap"
                   FontWeight="SemiBold" />

        <TextBlock Name="HintText"
                   Text="{loc:Translate reset_changes.this_deletes_all_uncommitted_work}"
                   TextWrapping="Wrap"
                   Opacity="0.8" />

        <Border BorderThickness="1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                CornerRadius="3"
                Padding="6"
                MaxHeight="180">
            <ScrollViewer>
                <ItemsControl Name="AffectedList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="11" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <CheckBox Name="DeleteUntrackedBox"
                  Content="{loc:Translate reset_changes.also_delete_new_files_and_or_directories}" />

        <CheckBox Name="DoNotAskAgainBox"
                  Content="{loc:Translate reset_changes.do_not_ask_again_this_session}"
                  FontSize="11" />

        <TextBlock Name="BackupNote"
                   Text="{loc:Translate reset_changes.deleted_content_is_backed_up_you_can_restore}"
                   TextWrapping="Wrap"
                   FontSize="11"
                   Opacity="0.75" />

        <!-- flowLayoutPanel1 sırası: btnCancel, btnReset. -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8">
            <Button Name="CancelButton" Content="{loc:Translate reset_changes.cancel}" MinWidth="90" IsCancel="True" Click="OnCancelClick" />
            <Button Name="ResetButton" Content="{loc:Translate reset_changes.reset}" MinWidth="90" IsDefault="True" Click="OnResetClick" />
        </StackPanel>
    </StackPanel>
</Window>
