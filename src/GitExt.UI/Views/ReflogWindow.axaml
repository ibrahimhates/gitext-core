<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GitExt.UI.ViewModels"
        x:Class="GitExt.UI.Views.ReflogWindow"
        x:DataType="vm:ReflogViewModel"
        Title="Reflog" Width="900" Height="560"
        WindowStartupLocation="CenterOwner">

  <Grid RowDefinitions="Auto,*,Auto" Margin="12">

    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,8">
      <CheckBox Name="OnlyUnreachableBox"
                Content="Only lost commits"
                IsChecked="{Binding OnlyUnreachable}" />
      <TextBlock Name="UnreachableCountLabel"
                 VerticalAlignment="Center" Opacity="0.7"
                 Text="{Binding UnreachableCount, StringFormat='{}{0} unreachable'}" />
    </StackPanel>

    <ListBox Grid.Row="1" Name="ReflogList"
             ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:ReflogRowViewModel">
          <Grid ColumnDefinitions="80,140,*,140">
            <TextBlock Grid.Column="0" Text="{Binding ShortId}" FontFamily="monospace" />
            <TextBlock Grid.Column="1" Text="{Binding Selector}" Opacity="0.7" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
              <TextBlock Text="{Binding Message}" TextTrimming="CharacterEllipsis" />
              <!-- Kayıp commit'ler öne çıkarılıyor: tarayıcının asıl işi bunları bulmak. -->
              <Border Background="#7d3c98" CornerRadius="3" Padding="4,0"
                      IsVisible="{Binding IsUnreachable}">
                <TextBlock Text="lost" Foreground="White" FontSize="10" />
              </Border>
            </StackPanel>
            <TextBlock Grid.Column="3" Text="{Binding Timestamp}" FontSize="11" Opacity="0.6" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <StackPanel Grid.Row="2" Margin="0,10,0,0" Spacing="6">
      <TextBlock Name="RecoveryLabel" FontFamily="monospace" Opacity="0.8"
                 Text="{Binding SelectedRecoveryCommand}"
                 IsVisible="{Binding HasSelection}" />
      <TextBlock Name="NoticeLabel" Text="{Binding Notice}" TextWrapping="Wrap"
                 IsVisible="{Binding Notice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <TextBlock Name="ErrorLabel" Text="{Binding Error}" Foreground="#c0392b" TextWrapping="Wrap"
                 IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <StackPanel Orientation="Horizontal" Spacing="6">
        <Button Name="ReturnButton" Content="Reset to this commit" Command="{Binding ReturnCommand}" />
        <Button Name="CloseButton" Content="Close" Click="OnClose" />
      </StackPanel>
    </StackPanel>
  </Grid>
</Window>
